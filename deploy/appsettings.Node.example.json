{
  "NodeAuthentication": {
    "CredentialFile": "/home/USER/.local/share/pi-command-center/node.token",
    "Header": "Authorization",
    "Scheme": "Bearer"
  },
  "Node": {
    "ControlPlaneUrl": "http://127.0.0.1:5057",
    "DisplayName": "",
    "HeartbeatSeconds": 10,
    "ClaimLeaseSeconds": 60,
    "EventSpoolPath": "~/.local/share/pi-command-center/node-spool.db",
    "RequireCleanStart": true,
    "AllowUntrackedFiles": false
  },
  "Pi": {
    "WorkerPath": "",
    "NodeExecutable": "node",
    "AgentDataDirectory": "~/.local/share/pi-command-center/pi-agent",
    "StartTimeoutSeconds": 30,
    "RequestTimeoutSeconds": 60,
    "MaxChildAgentsPerRequest": 4,
    "AllowedChildRoles": ["root", "architect", "implementer", "reviewer", "verifier"],
    "AllowedRuntimeProfiles": [
      "local-pi",
      "claude-readonly",
      "claude-reserved-write",
      "antigravity-readonly"
    ]
  },
  "Claude": {
    "Executable": "claude",
    "SettingsPath": "",
    "StartTimeoutSeconds": 30,
    "CancelGraceMilliseconds": 2000,
    "MaxLineBytes": 1048576,
    "MaxMalformedEvents": 64,
    "MaxStderrLines": 200
  },
  "Antigravity": {
    "Executable": "agy",
    "StartTimeoutSeconds": 30,
    "CancelGraceSeconds": 5,
    "MaxStderrLines": 200,
    "MaxLineBytes": 1048576
  },
  "Verification": {
    "MaxOutputBytes": 65536,
    "Profiles": {}
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
