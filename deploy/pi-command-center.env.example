# Generated deployments use /home/USER/.local/share/devfleet/pi-command-center.env
# with mode 0600. Replace USER before using this example; every filesystem
# setting must remain an absolute host-native path.

PATH=/home/USER/.local/bin:/home/USER/bin:/usr/local/bin:/usr/bin:/bin
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5057
AllowedHosts=127.0.0.1;localhost

Admin__Username=admin
Admin__PasswordFile=/home/USER/.local/share/devfleet/admin.password.hash
NodeAuthentication__CredentialFile=/home/USER/.local/share/devfleet/node.token
NodeAuthentication__Header=Authorization
NodeAuthentication__Scheme=Bearer
DataProtection__KeysDirectory=/home/USER/.local/share/devfleet/data-protection-keys

ControlPlane__BaseUrl=http://127.0.0.1:5057
ConnectionStrings__ControlPlane=Data Source=/home/USER/.local/share/devfleet/controlplane.db;Cache=Shared

Node__ControlPlaneUrl=http://127.0.0.1:5057
Node__DisplayName=HOSTNAME
Node__HeartbeatSeconds=10
Node__ClaimLeaseSeconds=60
Node__EventSpoolPath=/home/USER/.local/share/devfleet/node-spool.db
Node__RequireCleanStart=true

Projects__ApprovedRoots__0=/home/USER/Developer

Pi__NodeExecutable=/usr/bin/node
Pi__AgentDataDirectory=/home/USER/.local/share/devfleet/pi-agent
Pi__WorkerPath=/home/USER/.local/lib/devfleet/runtime/pi-worker/src/index.ts

SubscriptionUsage__NodeExecutable=/usr/bin/node
SubscriptionUsage__ScriptPath=/home/USER/.local/lib/devfleet/runtime/pi-worker/src/usage.ts
SubscriptionUsage__ClaudeCredentialPath=/home/USER/.claude/.credentials.json

Claude__Executable=/home/USER/.local/bin/claude
Antigravity__Executable=/home/USER/.local/bin/agy
Muse__Executable=/home/USER/.local/bin/muse
