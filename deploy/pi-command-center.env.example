# Copy to $PI_CC_DATA/pi-command-center.env (mode 0600). Loaded by systemd user units.
# scripts/setup-local.sh writes this file with expanded absolute paths. Do not leave
# %h or $HOME unexpanded: systemd EnvironmentFile does not substitute them.

PI_CC_DATA=/home/USER/.local/share/pi-command-center
PI_CC_REPO=/home/USER/Developer/devfleet
PI_CC_PORT=5057

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5057

Admin__Username=admin
Admin__PasswordFile=/home/USER/.local/share/pi-command-center/admin.password.hash

NodeAuthentication__CredentialFile=/home/USER/.local/share/pi-command-center/node.token
NodeAuthentication__Header=Authorization
NodeAuthentication__Scheme=Bearer

ControlPlane__BaseUrl=http://127.0.0.1:5057
ConnectionStrings__ControlPlane=Data Source=/home/USER/.local/share/pi-command-center/controlplane.db;Cache=Shared

Node__ControlPlaneUrl=http://127.0.0.1:5057
Node__HeartbeatSeconds=10
Node__ClaimLeaseSeconds=60
Node__EventSpoolPath=/home/USER/.local/share/pi-command-center/node-spool.db
Node__RequireCleanStart=true

Projects__ApprovedRoots__0=/home/USER/Developer

Pi__NodeExecutable=node
Pi__AgentDataDirectory=/home/USER/.local/share/pi-command-center/pi-agent
Pi__WorkerPath=/home/USER/.local/lib/pi-command-center/runtime/pi-worker/src/index.ts

Claude__Executable=claude
Antigravity__Executable=agy
