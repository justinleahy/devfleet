[Unit]
Description=Pi Command Center control plane (loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/pi-command-center
EnvironmentFile=%h/.local/share/pi-command-center/pi-command-center.env
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5057
ExecStart=/usr/bin/dotnet %h/.local/lib/pi-command-center/control-plane/PiCommandCenter.ControlPlane.dll
Restart=on-failure
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=%h/.local/share/pi-command-center %h/Developer
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
