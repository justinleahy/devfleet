[Unit]
Description=DevFleet node worker
After=network-online.target pi-command-center-control-plane.service
Wants=network-online.target
Requires=pi-command-center-control-plane.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/devfleet
EnvironmentFile=%h/.local/share/devfleet/pi-command-center.env
ExecStart=/usr/bin/dotnet %h/.local/lib/devfleet/node/PiCommandCenter.Node.dll
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=%h/.local/share/devfleet %h/Developer
ReadWritePaths=-%h/.pi -%h/.claude -%h/.claude.json -%h/.gemini -%h/.config/muse
ReadWritePaths=-%h/.cache -%h/.local/state
ProtectSystem=strict
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
# Namespace-based kernel, control-group, clock, and hostname protections prevent Bubblewrap
# from mounting the private /proc required by its PID namespace; the empty capability set and
# inner read-only root already deny those privileged operations to the node and its children.
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
