<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PiCommandCenter.Api</RootNamespace>
    <Description>HTTP API surface: legacy /api and native /api/v1 endpoint mappers plus host registration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Web SDK adds these implicitly; a class library must opt in. -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PiCommandCenter.Application\PiCommandCenter.Application.csproj" />
    <ProjectReference Include="..\PiCommandCenter.Infrastructure\PiCommandCenter.Infrastructure.csproj" />
  </ItemGroup>

</Project>
