@page "/requests/{RequestId:guid}"
@namespace PiCommandCenter.Web.Components.Pages
@rendermode InteractiveServer
@using PiCommandCenter.Application
@using PiCommandCenter.Application.Mail
@using PiCommandCenter.Application.Projects
@using PiCommandCenter.Application.Requests
@using PiCommandCenter.Application.Reservations
@using PiCommandCenter.Application.Sessions
@using PiCommandCenter.Domain
@using PiCommandCenter.Domain.Requests
@using PiCommandCenter.Domain.Reservations
@using PiCommandCenter.Domain.Sessions
@using PiCommandCenter.Application.Completion
@using PiCommandCenter.Application.Verification
@using PiCommandCenter.Domain.Verification
@using PiCommandCenter.Domain.Completion
@using PiCommandCenter.Web.Components.Requests
@using PiCommandCenter.Web.Components
@using PiCommandCenter.Web.Components.Coordination
@using PiCommandCenter.Web.Components.Sessions
@implements IAsyncDisposable
@inject IRequestQueue Queue
@inject IProjectCatalog Catalog
@inject IAgentSessionStore SessionStore
@inject PiCommandCenter.Application.Mail.IMessageService Mail
@inject IReservationService ReservationAuthority
@inject IClock Clock
@inject IVerificationRunStore VerificationRunStore
@inject ICompletionGateService CompletionGate

<PageTitle>@(_request?.Title ?? "Request") &middot; Pi Command Center</PageTitle>

@if (_loading)
{
    <div class="state-block" role="status">
        <FluentProgressRing aria-label="Loading request" />
        <span>Loading request</span>
    </div>
}
else if (_request is null)
{
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Width="100%">
        <h1>Request not found</h1>
        <p class="page-lead">
            @if (_loadError is not null)
            {
                @_loadError
            }
            else
            {
                <text>No work request is queued with that id.</text>
            }
        </p>
        <p class="mono hint">@RequestId</p>
        <a class="back-link" href="/">Back to fleet</a>
    </FluentStack>
}
else
{
    var request = _request;

    <FluentStack Orientation="Orientation.Vertical" VerticalGap="24" Width="100%">

        <header class="page-head">
            <a class="back-link" href="@ProjectHref()">
                @(_project is null ? "Back to project" : $"Back to {_project.DisplayName}")
            </a>
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="12"
                         Width="100%">
                <h1>@request.Title</h1>
                <FluentSpacer />
                <FluentButton Appearance="Appearance.Stealth" OnClick="ManualReloadAsync">
                    Reload
                </FluentButton>
            </FluentStack>
            <div class="badge-row">
                <FluentBadge Appearance="Appearance.Accent">@request.StatusName</FluentBadge>
                <FluentBadge Appearance="Appearance.Neutral">@request.PriorityName</FluentBadge>
                <FluentBadge Appearance="Appearance.Neutral">@request.KindName</FluentBadge>
                <FluentBadge Appearance="Appearance.Neutral">@request.RiskLevelName</FluentBadge>
                @if (request.BlockedPhaseName is not null)
                {
                    <FluentBadge Appearance="Appearance.Neutral">blocked in @request.BlockedPhaseName</FluentBadge>
                }
            </div>
            <p class="page-lead">
                Request state and agent sessions are read from the control-plane projection.
                Refreshed every @RefreshSeconds s; snapshot @_snapshot.ToString("u").
            </p>
        </header>

        @if (_loadError is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Error"
                              Title="Could not refresh request"
                              AllowDismiss="false">
                @_loadError
            </FluentMessageBar>
        }

        @if (_attention.Count > 0)
        {
            <section class="signal-stack" aria-labelledby="attention-heading">
                <FluentStack Orientation="Orientation.Horizontal"
                             VerticalAlignment="VerticalAlignment.Center"
                             HorizontalGap="12"
                             Width="100%">
                    <h2 id="attention-heading">Needs attention</h2>
                    <FluentSpacer />
                    <FluentAnchor Href="/attention" Appearance="Appearance.Stealth">
                        Fleet attention queue
                    </FluentAnchor>
                </FluentStack>
                @foreach (var signal in _attention)
                {
                    <AttentionCallout Signal="signal" Now="_snapshot" />
                }
            </section>
        }

        <FluentCard>
            <section class="panel" aria-labelledby="original-heading">
                <h2 id="original-heading">Original request</h2>
                <p class="request-prompt">@request.Prompt</p>
                <dl class="facts">
                    <dt>Request id</dt>
                    <dd class="mono">@request.Id</dd>
                    <dt>Project</dt>
                    <dd>
                        @if (_project is not null)
                        {
                            <a href="@ProjectHref()">@_project.DisplayName</a>
                        }
                        <span class="mono hint">@request.ProjectId</span>
                    </dd>
                    <dt>Created</dt>
                    <dd>@request.CreatedAt.ToString("u")</dd>
                    <dt>Updated</dt>
                    <dd>
                        @request.UpdatedAt.ToString("u")
                        <span class="hint">(@Relative(request.UpdatedAt, _snapshot))</span>
                    </dd>
                    <dt>Version</dt>
                    <dd>@request.Version</dd>
                </dl>
            </section>
        </FluentCard>

        <FluentCard>
            <section class="panel" aria-labelledby="status-heading">
                <h2 id="status-heading">Current status</h2>

                @if (_sessionError is not null)
                {
                    <FluentMessageBar Intent="MessageIntent.Error"
                                      Title="Session projection unavailable"
                                      AllowDismiss="false">
                        @_sessionError
                    </FluentMessageBar>
                }
                else if (_root is null)
                {
                    <p class="panel-empty">
                        No agent session is registered for this request yet. The request is
                        @request.StatusName; a root session appears here once a node claims the
                        request and its runtime reports <span class="mono">session.registered</span>.
                    </p>
                }
                else
                {
                    var root = _root;

                    <dl class="dimensions">
                        <div class="dimension @(root.Liveness == AgentLiveness.Online ? "is-live" : root.Liveness == AgentLiveness.Exited ? "is-alert" : string.Empty)">
                            <dt>Liveness</dt>
                            <dd>@root.Liveness</dd>
                        </div>
                        <div class="dimension @(IsWorking(root.Activity) ? "is-live" : string.Empty)">
                            <dt>Activity</dt>
                            <dd>@root.Activity</dd>
                        </div>
                        <div class="dimension @(root.Attention == AgentAttention.None ? string.Empty : "is-alert")">
                            <dt>Attention</dt>
                            <dd>@root.Attention</dd>
                        </div>
                        <div class="dimension @(IsFailed(root.WorkState) ? "is-alert" : IsTerminal(root.WorkState) ? string.Empty : "is-live")">
                            <dt>Work state</dt>
                            <dd>@root.WorkState</dd>
                        </div>
                    </dl>

                    <p class="operation">
                        <span class="operation-label">Status reason</span>
                        <span>@(string.IsNullOrWhiteSpace(root.StatusReason) ? "None reported." : root.StatusReason)</span>
                    </p>
                    <p class="operation">
                        <span class="operation-label">Current operation</span>
                        <span>@(root.CurrentOperation ?? "None reported.")</span>
                    </p>

                    <dl class="facts">
                        <dt>Root session</dt>
                        <dd class="mono">@root.Id</dd>
                        <dt>Runtime</dt>
                        <dd>@root.Runtime <span class="hint">/ @root.RuntimeProfile</span></dd>
                        <dt>Provider session</dt>
                        <dd class="mono">@(root.ProviderSessionId ?? "not reported")</dd>
                        <dt>Process</dt>
                        <dd>@(root.ProcessId?.ToString() ?? "not reported")</dd>
                        <dt>Started</dt>
                        <dd>@root.StartedAt.ToString("u")</dd>
                        <dt>Last heartbeat</dt>
                        <dd>
                            @if (root.LastHeartbeatAt is { } beat)
                            {
                                @beat.ToString("u")
                                <span class="hint">(@Relative(beat, _snapshot))</span>
                            }
                            else
                            {
                                <span class="hint">no heartbeat received</span>
                            }
                        </dd>
                        <dt>Ended</dt>
                        <dd>
                            @if (root.EndedAt is { } ended)
                            {
                                @ended.ToString("u")
                            }
                            else
                            {
                                <span class="hint">still open</span>
                            }
                        </dd>
                    </dl>
                }
            </section>
        </FluentCard>

        <section aria-labelledby="tree-heading">
            <h2 id="tree-heading">Agent tree</h2>
            @if (_roots.Count == 0)
            {
                <p class="panel-empty">
                    No sessions yet. Root and child agents appear as their runtimes register.
                </p>
            }
            else
            {
                <FluentCard>
                    <div class="panel">
                        <ul class="agent-tree" role="tree" aria-labelledby="tree-heading">
                            @foreach (var session in _roots)
                            {
                                <AgentTreeNode Session="session" ChildrenOf="ChildrenOf" Now="_snapshot" />
                            }
                        </ul>
                    </div>
                </FluentCard>
            }
        </section>

        <section aria-labelledby="timeline-heading">
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="12"
                         Width="100%">
                <h2 id="timeline-heading">Event timeline</h2>
                <FluentSpacer />
                <span class="event-origin" role="status" aria-live="polite">
                    @_events.Count persisted event@(_events.Count == 1 ? string.Empty : "s") &middot;
                    newest first &middot; refreshed @Relative(_snapshot, Clock.UtcNow)
                </span>
            </FluentStack>

            @if (_events.Count == 0)
            {
                <p class="panel-empty">
                    No events persisted for this request yet. Normalized runtime events land here in
                    occurrence order as the node forwards them.
                </p>
            }
            else
            {
                <FluentCard>
                    <div class="panel">
                        @if (_events.Count > TimelineCap)
                        {
                            <p class="panel-lead">
                                Showing the most recent @TimelineCap of @_events.Count events.
                            </p>
                        }
                        <ol class="timeline">
                            @foreach (var evt in TimelineWindow())
                            {
                                <li>
                                    <span class="event-time">
                                        <span class="visually-hidden">Occurred at</span>
                                        @evt.OccurredAt.ToString("HH:mm:ss")
                                    </span>
                                    <span class="event-type">@evt.Type</span>
                                    <div class="event-body">
                                        <span class="event-origin">
                                            seq @evt.Sequence &middot;
                                            @(evt.SessionId is null ? "request-scoped" : SessionLabel(evt.SessionId)) &middot;
                                            @evt.OccurredAt.ToString("u")
                                        </span>
                                        @if (HasPayload(evt.PayloadJson))
                                        {
                                            <details>
                                                <summary>payload</summary>
                                                <pre class="event-payload">@Payload(evt.PayloadJson)</pre>
                                            </details>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    </div>
                </FluentCard>
            }
        </section>

        <section aria-labelledby="messages-heading">
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="12"
                         Width="100%">
                <h2 id="messages-heading">Messages</h2>
                <FluentSpacer />
                <span class="event-origin" role="status" aria-live="polite">
                    @MessageSummary()
                </span>
            </FluentStack>

            @if (_mailError is not null)
            {
                <FluentMessageBar Intent="MessageIntent.Error"
                                  Title="Mail projection unavailable"
                                  AllowDismiss="false">
                    @_mailError
                </FluentMessageBar>
            }
            else if (_threads.Count == 0)
            {
                <p class="panel-empty">
                    No message is persisted for this request yet. Agent-to-agent coordination lands in
                    the request thread <span class="mono">@PrimaryThreadId()</span>; the composer below
                    writes the first human message into that same thread.
                </p>
            }
            else
            {
                <div class="thread-stack">
                    @foreach (var thread in _threads)
                    {
                        <FluentCard>
                            <MessageThreadView ThreadId="thread.ThreadId"
                                               Subject="thread.Subject"
                                               Messages="thread.Messages"
                                               IsPrimary="thread.IsPrimary"
                                               Now="_snapshot"
                                               SessionLabel="SessionLabel" />
                        </FluentCard>
                    }
                </div>
            }

            <FluentCard>
                <div class="panel">
                    <GuidanceComposer ProjectId="request.ProjectId"
                                      RequestId="request.Id"
                                      ThreadId="@PrimaryThreadId()"
                                      SubjectSeed="@GuidanceSubjectSeed(request)"
                                      Targets="_guidanceTargets"
                                      OnSent="ManualReloadAsync" />
                </div>
            </FluentCard>
        </section>

        <section aria-labelledby="reservations-heading">
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="12"
                         Width="100%">
                <h2 id="reservations-heading">Reservations</h2>
                <FluentSpacer />
                <span class="event-origin" role="status" aria-live="polite">
                    @ReservationSummary()
                </span>
            </FluentStack>

            @if (_reservationError is not null)
            {
                <FluentMessageBar Intent="MessageIntent.Error"
                                  Title="Reservation authority unavailable"
                                  AllowDismiss="false">
                    @_reservationError
                </FluentMessageBar>
            }
            else
            {
                @if (_recoveryLeaseCount > 0)
                {
                    <FluentMessageBar Intent="MessageIntent.Warning"
                                      Title="Recovery inspection outstanding"
                                      AllowDismiss="false">
                        @_recoveryLeaseCount lease group(s) of this request are in
                        <span class="mono">recovery-required</span>. Their scopes cannot be re-granted
                        until the node confirms the owning process stopped or a human force-releases.
                    </FluentMessageBar>
                }

                @if (_leases.Count == 0)
                {
                    <p class="panel-empty">
                        No lease group is held for this request. Agents acquire leases before any
                        mutation, so an idle request holds none;
                        @(_projectLeaseCount == 0
                            ? "the project holds none either."
                            : $"{_projectLeaseCount} lease group(s) are held elsewhere in this project.")
                    </p>
                }
                else
                {
                    <div class="lease-stack">
                        @foreach (var lease in _leases)
                        {
                            <FluentCard>
                                <ReservationLeaseCard Lease="lease"
                                                      OwnerLabel="@SessionLabel(lease.OwnerSessionId)"
                                                      Now="_snapshot"
                                                      OnForceReleased="ManualReloadAsync" />
                            </FluentCard>
                        }
                    </div>
                }

                @if (_reservationEvents.Count > 0)
                {
                    <FluentCard>
                        <div class="panel">
                            <h3>Handoff and recovery activity</h3>
                            <p class="panel-lead">
                                Persisted <span class="mono">reservation.*</span> events for this
                                request, newest first. Handoff, expiry, recovery, and force-release
                                transitions are audited here.
                            </p>
                            <ul class="audit-list">
                                @foreach (var evt in _reservationEvents)
                                {
                                    <li class="@(IsReservationWarning(evt.Type) ? "audit-warning" : null)">
                                        <span class="event-type">@evt.Type</span>
                                        <span class="event-origin">
                                            @(evt.SessionId is null ? "request-scoped" : SessionLabel(evt.SessionId))
                                            &middot; @evt.OccurredAt.ToString("u")
                                            &middot; @TimeText.Relative(evt.OccurredAt, _snapshot)
                                        </span>
                                        @if (HasPayload(evt.PayloadJson))
                                        {
                                            <details>
                                                <summary>payload</summary>
                                                <pre class="event-payload">@Payload(evt.PayloadJson)</pre>
                                            </details>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </FluentCard>
                }
            }
        </section>

        <section aria-labelledby="plan-heading">
            <h2 id="plan-heading">Structured plan</h2>
            @if (_insights.CurrentPlan is not { } plan)
            {
                <p class="panel-empty">
                    No plan is persisted for this request. The root agent's
                    <span class="mono">create_plan</span> tool writes a
                    <span class="mono">request.phase_changed</span> event with phase
                    <span class="mono">plan</span>; this view renders that event and nothing else.
                </p>
            }
            else
            {
                <FluentCard>
                    <div class="panel">
                        <p class="panel-lead">
                            @(plan.IsRevision ? "Revision" : "Initial plan") persisted at
                            <span class="mono">@plan.OccurredAt.ToString("u")</span>
                            by @(plan.SessionId is null ? "the request scope" : SessionLabel(plan.SessionId))
                            &middot; seq @plan.Sequence
                            @if (_insights.PlanRevisions.Count > 1)
                            {
                                <text>&middot; @(_insights.PlanRevisions.Count - 1) earlier version(s)</text>
                            }
                        </p>

                        @if (plan.Reason is { Length: > 0 } reason)
                        {
                            <p class="operation">
                                <span class="operation-label">Reason</span>
                                <span>@reason</span>
                            </p>
                        }

                        @if (plan.Steps.Count == 0)
                        {
                            <p class="panel-empty">
                                The plan event carried no <span class="mono">steps</span> array. Its
                                payload is shown verbatim rather than summarized.
                            </p>
                            <pre class="event-payload">@Payload(plan.PayloadJson)</pre>
                        }
                        else
                        {
                            <ol class="plan-steps">
                                @foreach (var step in plan.Steps)
                                {
                                    <li>@step.Text</li>
                                }
                            </ol>
                        }

                        @if (_insights.PlanRevisions.Count > 1)
                        {
                            <details>
                                <summary>Revision history</summary>
                                <ul class="audit-list">
                                    @foreach (var revision in PlanHistory())
                                    {
                                        <li>
                                            <span class="event-type">
                                                @(revision.IsRevision ? "plan_revision" : "plan")
                                            </span>
                                            <span class="event-origin">
                                                seq @revision.Sequence &middot;
                                                @revision.OccurredAt.ToString("u") &middot;
                                                @revision.Steps.Count step(s)
                                                @if (revision.Reason is { Length: > 0 } why)
                                                {
                                                    <text> &middot; @why</text>
                                                }
                                            </span>
                                        </li>
                                    }
                                </ul>
                            </details>
                        }
                    </div>
                </FluentCard>
            }
        </section>

        <section aria-labelledby="diff-heading">
            <h2 id="diff-heading">Repository diff</h2>

            @foreach (var external in _insights.ExternalChanges)
            {
                <FluentMessageBar Intent="MessageIntent.Error"
                                  Title="External repository change detected"
                                  AllowDismiss="false">
                    @(external.Paths.Count == 0
                        ? "The node recorded a change no lease accounts for and listed no paths."
                        : $"Changed outside every lease: {string.Join(", ", external.Paths)}.")
                    @external.Detail
                    Completion stays blocked until a human attributes or reverts the change; the
                    Command Center never resets, stashes, or cleans the repository.
                </FluentMessageBar>
            }

            @if (_insights.LatestDiff is not { } diff)
            {
                <p class="panel-empty">
                    No diff snapshot is persisted. The node writes
                    <span class="mono">repository.changed</span> and
                    <span class="mono">repository.checkpoint_created</span> events as it captures the
                    working tree; this view renders those events only.
                </p>
            }
            else
            {
                <FluentCard>
                    <div class="panel">
                        <p class="panel-lead">
                            <span class="mono">@diff.EventType</span> at
                            <span class="mono">@diff.OccurredAt.ToString("u")</span>
                            &middot; seq @diff.Sequence
                            &middot; @_insights.DiffSnapshots.Count snapshot(s) captured
                        </p>

                        <dl class="facts">
                            <dt>Branch</dt>
                            <dd>@(diff.Branch ?? "not recorded")</dd>
                            <dt>Base commit</dt>
                            <dd class="mono">@(diff.BaseCommit ?? "not recorded")</dd>
                            <dt>Head commit</dt>
                            <dd class="mono">@(diff.HeadCommit ?? "not recorded")</dd>
                        </dl>

                        @if (diff.Paths.Count == 0)
                        {
                            <p class="panel-empty">
                                The snapshot recorded no paths. Its payload is shown verbatim.
                            </p>
                            <pre class="event-payload">@Payload(diff.PayloadJson)</pre>
                        }
                        else
                        {
                            <ul class="file-list">
                                @foreach (var path in diff.Paths)
                                {
                                    <li class="@(path.Reserved == false ? "file-unattributed" : null)">
                                        <span class="mono file-path">@path.Path</span>
                                        @if (path.ChangeKind is { Length: > 0 } kind)
                                        {
                                            <FluentBadge Appearance="Appearance.Neutral">@kind</FluentBadge>
                                        }
                                        @if (path.LinesAdded is { } added || path.LinesRemoved is { } removed)
                                        {
                                            <span class="file-lines">
                                                +@(path.LinesAdded?.ToString() ?? "?")
                                                /
                                                -@(path.LinesRemoved?.ToString() ?? "?")
                                            </span>
                                        }
                                        <span class="file-owner">
                                            @(path.OwnerSessionId is null
                                                ? "ownership not recorded"
                                                : SessionLabel(path.OwnerSessionId))
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </FluentCard>
            }
        </section>

        <section aria-labelledby="verification-heading">
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="12"
                         Width="100%">
                <h2 id="verification-heading">Verification</h2>
                <FluentSpacer />
                <span class="event-origin" role="status" aria-live="polite">
                    @VerificationSummary()
                </span>
            </FluentStack>

            @if (_verificationError is not null)
            {
                <FluentMessageBar Intent="MessageIntent.Error"
                                  Title="Verification store unavailable"
                                  AllowDismiss="false">
                    @_verificationError
                </FluentMessageBar>
            }
            else if (_verificationRuns.Count == 0)
            {
                <p class="panel-empty">
                    No verification command has run for this request. Runs are recorded by the node
                    when the root agent calls <span class="mono">request_verification</span>; only
                    profiles from trusted node configuration can execute.
                </p>
            }
            else
            {
                <div class="run-grid">
                    @foreach (var profile in VerificationProfiles())
                    {
                        <FluentCard>
                            <section class="panel" aria-label="@($"Verification profile {profile.Key}")">
                                <FluentStack Orientation="Orientation.Horizontal"
                                             VerticalAlignment="VerticalAlignment.Center"
                                             HorizontalGap="8"
                                             Width="100%">
                                    <h3>@profile.Key</h3>
                                    <FluentSpacer />
                                    <FluentBadge Appearance="@(ProfileGreen(profile.Value) ? Appearance.Accent : Appearance.Neutral)">
                                        @(ProfileGreen(profile.Value) ? "all green" : "not green")
                                    </FluentBadge>
                                </FluentStack>

                                <ul class="run-list">
                                    @foreach (var run in profile.Value)
                                    {
                                        <li class="run @RunClass(run.Status)">
                                            <span class="run-command mono">@run.CommandId</span>
                                            <FluentBadge Appearance="@(run.Status == VerificationRunStatus.Passed ? Appearance.Accent : Appearance.Neutral)">
                                                @run.Status
                                            </FluentBadge>
                                            @if (run.Mandatory)
                                            {
                                                <FluentBadge Appearance="Appearance.Neutral">mandatory</FluentBadge>
                                            }
                                            <span class="run-facts">
                                                exit @(run.ExitCode?.ToString() ?? "n/a") &middot;
                                                @RunDuration(run) &middot;
                                                @run.StartedAt.ToString("u")
                                            </span>
                                            @if (run.OutputSummary is { Length: > 0 } summary)
                                            {
                                                <pre class="event-payload">@summary</pre>
                                            }
                                            @if (run.OutputArtifactPath is { Length: > 0 } artifact)
                                            {
                                                <span class="event-origin">artifact @artifact</span>
                                            }
                                        </li>
                                    }
                                </ul>
                            </section>
                        </FluentCard>
                    }
                </div>
            }
        </section>

        <section aria-labelledby="result-heading">
            <h2 id="result-heading">Final result</h2>

            @if (_resultError is not null)
            {
                <FluentMessageBar Intent="MessageIntent.Error"
                                  Title="Completion gate unavailable"
                                  AllowDismiss="false">
                    @_resultError
                </FluentMessageBar>
            }

            @if (_insights.LatestRejection is { } rejection && _result is null)
            {
                <FluentMessageBar Intent="MessageIntent.Warning"
                                  Title="The completion gate rejected the last attempt"
                                  AllowDismiss="false">
                    Recorded @rejection.OccurredAt.ToString("u") as
                    <span class="mono">@rejection.EventType</span>.
                </FluentMessageBar>

                <FluentCard>
                    <div class="panel">
                        <h3>Missing requirements</h3>
                        <ul class="requirement-list">
                            @foreach (var requirement in rejection.MissingRequirements)
                            {
                                <li>
                                    <span class="mono">@requirement</span>
                                    <span class="hint">@RequirementText(requirement)</span>
                                </li>
                            }
                        </ul>
                    </div>
                </FluentCard>
            }

            @if (_result is { } result)
            {
                <FluentCard>
                    <div class="panel">
                        <p class="panel-lead">
                            Accepted by the completion gate at
                            <span class="mono">@result.CreatedAt.ToString("u")</span>
                            (@Relative(result.CreatedAt, _snapshot)).
                        </p>

                        <h3>Summary</h3>
                        <p class="request-prompt">@result.SummaryMarkdown</p>

                        <h3>Changed files (@result.ChangedFiles.Count)</h3>
                        @if (result.ChangedFiles.Count == 0)
                        {
                            <p class="panel-empty">The accepted result recorded no changed file.</p>
                        }
                        else
                        {
                            <ul class="file-list">
                                @foreach (var file in result.ChangedFiles)
                                {
                                    <li><span class="mono file-path">@file</span></li>
                                }
                            </ul>
                        }

                        <h3>Review findings (@result.ReviewFindings.Count)</h3>
                        @if (result.ReviewFindings.Count == 0)
                        {
                            <p class="panel-empty">The reviewer recorded no finding.</p>
                        }
                        else
                        {
                            <ul class="finding-list">
                                @foreach (var finding in result.ReviewFindings)
                                {
                                    <li class="@(finding.Blocking && !finding.Resolved ? "finding-blocking" : null)">
                                        <span class="mono">@finding.Id</span>
                                        <span>@finding.Summary</span>
                                        <span class="badge-row">
                                            <FluentBadge Appearance="@(finding.Blocking ? Appearance.Accent : Appearance.Neutral)">
                                                @(finding.Blocking ? "blocking" : "non-blocking")
                                            </FluentBadge>
                                            <FluentBadge Appearance="Appearance.Neutral">
                                                @(finding.Resolved ? "resolved" : "open")
                                            </FluentBadge>
                                            @if (finding.UserOverridden)
                                            {
                                                <FluentBadge Appearance="Appearance.Neutral">user override</FluentBadge>
                                            }
                                        </span>
                                    </li>
                                }
                            </ul>
                        }

                        <h3>Verification summary</h3>
                        <p class="request-prompt">@result.VerificationSummary</p>
                    </div>
                </FluentCard>
            }
            else if (_insights.LatestRejection is null && _resultError is null)
            {
                <p class="panel-empty">
                    No result is persisted. The gate stores one only when it accepts a completion,
                    and rejections appear here as
                    <span class="mono">request.completion_rejected</span> events.
                </p>
            }
        </section>
    </FluentStack>
}

@code {
    private const int TimelineCap = 200;
    private const int RefreshSeconds = 3;
    private const int PayloadCap = 2000;
    private const int ReservationAuditCap = 20;
    private const string AllAgentsTarget = "*";

    [Parameter]
    public Guid RequestId { get; set; }

    private readonly Dictionary<string, List<AgentSessionDto>> _children = [];
    private readonly Dictionary<string, AgentSessionDto> _sessionsById = [];

    private List<AgentSessionDto> _roots = [];
    private IReadOnlyList<AgentSessionDto> _sessions = Array.Empty<AgentSessionDto>();
    private IReadOnlyList<SessionEventDto> _events = Array.Empty<SessionEventDto>();
    private AgentSessionDto? _root;
    private WorkRequestDto? _request;
    private ProjectDto? _project;
    private CancellationTokenSource? _refreshCts;
    private DateTimeOffset _snapshot;
    private string? _loadError;
    private string? _sessionError;
    private readonly List<MessageThread> _threads = [];
    private IReadOnlyList<GuidanceTarget> _guidanceTargets = Array.Empty<GuidanceTarget>();
    private IReadOnlyList<ReservationLeaseDto> _leases = Array.Empty<ReservationLeaseDto>();
    private IReadOnlyList<SessionEventDto> _reservationEvents = Array.Empty<SessionEventDto>();
    private int _messageCount;
    private int _unreadMessageCount;
    private int _projectLeaseCount;
    private int _recoveryLeaseCount;
    private string? _mailError;
    private string? _reservationError;
    private bool _loading = true;
    private bool _busy;
    private IReadOnlyList<VerificationRunDto> _verificationRuns = Array.Empty<VerificationRunDto>();
    private IReadOnlyList<AttentionSignal> _attention = Array.Empty<AttentionSignal>();
    private RequestInsights _insights = RequestInsights.Empty;
    private RequestResultDto? _result;
    private string? _verificationError;
    private string? _resultError;

    /// <summary>
    /// Reads the two outcome stores and reduces the event stream, then rebuilds the request's
    /// attention signals from those persisted facts.
    /// </summary>
    private async Task LoadOutcomeAsync(WorkRequestId requestId, WorkRequestDto request)
    {
        _insights = RequestInsightsReader.Read(_events);

        try
        {
            _verificationRuns = await VerificationRunStore.ListAsync(requestId, CancellationToken.None);
            _verificationError = null;
        }
        catch (Exception ex)
        {
            _verificationError = ex.Message;
            _verificationRuns = Array.Empty<VerificationRunDto>();
        }

        try
        {
            _result = await CompletionGate.GetResultAsync(requestId, CancellationToken.None);
            _resultError = null;
        }
        catch (Exception ex)
        {
            _resultError = ex.Message;
            _result = null;
        }

        var signals = new List<AttentionSignal>();
        AttentionScanner.Scan(
            signals,
            request,
            _project?.DisplayName ?? request.ProjectId.ToString(),
            _sessions,
            _leases,
            _verificationRuns,
            _insights,
            Clock.UtcNow);
        _attention = signals;
    }

    protected override Task OnParametersSetAsync() => LoadAsync(showSpinner: true);

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _refreshCts is null)
        {
            _refreshCts = new CancellationTokenSource();
            _ = RefreshLoopAsync(_refreshCts.Token);
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        var cts = _refreshCts;
        _refreshCts = null;
        if (cts is not null)
        {
            await cts.CancelAsync();
            cts.Dispose();
        }
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(RefreshSeconds));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync(showSpinner: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private Task ManualReloadAsync() => LoadAsync(showSpinner: true);

    private async Task LoadAsync(bool showSpinner)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        if (showSpinner)
        {
            _loading = true;
            StateHasChanged();
        }

        try
        {
            if (RequestId == Guid.Empty)
            {
                _request = null;
                return;
            }

            var requestId = new WorkRequestId(RequestId);
            _request = await Queue.GetAsync(requestId, CancellationToken.None);
            _loadError = null;
            await LoadProjectAsync(_request.ProjectId);
            await LoadSessionsAsync(requestId);
            await LoadMailAsync(_request);
            await LoadReservationsAsync(_request);
            await LoadOutcomeAsync(requestId, _request);
        }
        catch (RequestNotFoundException)
        {
            _request = null;
            _loadError = null;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _snapshot = Clock.UtcNow;
            _loading = false;
            _busy = false;
        }
    }

    private async Task LoadProjectAsync(Guid projectId)
    {
        try
        {
            _project = await Catalog.GetAsync(new ProjectId(projectId), CancellationToken.None);
        }
        catch (Exception)
        {
            _project = null;
        }
    }

    private async Task LoadSessionsAsync(WorkRequestId requestId)
    {
        try
        {
            _sessions = await SessionStore.ListAsync(requestId, CancellationToken.None);
            _events = await SessionStore.ListEventsAsync(requestId, CancellationToken.None);
            _sessionError = null;
        }
        catch (Exception ex)
        {
            _sessionError = ex.Message;
            _sessions = Array.Empty<AgentSessionDto>();
            _events = Array.Empty<SessionEventDto>();
        }

        BuildTree();
    }

    private async Task LoadMailAsync(WorkRequestDto request)
    {
        var projectId = new ProjectId(request.ProjectId);
        var primary = PrimaryThreadId();
        _threads.Clear();
        _messageCount = 0;
        _unreadMessageCount = 0;

        try
        {
            var threadIds = new List<string> { primary };
            foreach (var threadId in DiscoveredThreadIds())
            {
                if (!threadIds.Contains(threadId, StringComparer.Ordinal))
                {
                    threadIds.Add(threadId);
                }
            }

            foreach (var session in _sessions)
            {
                var unread = await Mail.GetUnreadAsync(projectId, session.Id, CancellationToken.None);
                foreach (var message in unread)
                {
                    if (message.RequestId.Value == RequestId
                        && !threadIds.Contains(message.ThreadId, StringComparer.Ordinal))
                    {
                        threadIds.Add(message.ThreadId);
                    }
                }
            }

            foreach (var threadId in threadIds)
            {
                var messages = await Mail.GetThreadAsync(projectId, threadId, CancellationToken.None);
                var scoped = new List<AgentMessageDto>(messages.Count);
                foreach (var message in messages)
                {
                    if (message.RequestId.Value != RequestId)
                    {
                        continue;
                    }

                    scoped.Add(message);
                    _messageCount++;
                    foreach (var recipient in message.Recipients)
                    {
                        if (recipient.ReadAtUtc is null)
                        {
                            _unreadMessageCount++;
                            break;
                        }
                    }
                }

                if (scoped.Count > 0)
                {
                    _threads.Add(new MessageThread(
                        threadId,
                        scoped[0].Subject,
                        string.Equals(threadId, primary, StringComparison.Ordinal),
                        scoped));
                }
            }

            _mailError = null;
        }
        catch (Exception ex)
        {
            _mailError = ex.Message;
            _threads.Clear();
            _messageCount = 0;
            _unreadMessageCount = 0;
        }

        BuildGuidanceTargets();
    }

    /// <summary>
    /// Thread ids proven by persisted <c>mail.*</c> events, so threads whose messages are already
    /// read are still listed. Unparsable payloads are skipped rather than guessed at.
    /// </summary>
    private IEnumerable<string> DiscoveredThreadIds()
    {
        foreach (var evt in _events)
        {
            if (!evt.Type.StartsWith("mail.", StringComparison.Ordinal) || !HasPayload(evt.PayloadJson))
            {
                continue;
            }

            string? threadId = null;
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(evt.PayloadJson);
                if (document.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object
                    && document.RootElement.TryGetProperty("threadId", out var value)
                    && value.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    threadId = value.GetString();
                }
            }
            catch (System.Text.Json.JsonException)
            {
                threadId = null;
            }

            if (!string.IsNullOrWhiteSpace(threadId))
            {
                yield return threadId;
            }
        }
    }

    private async Task LoadReservationsAsync(WorkRequestDto request)
    {
        try
        {
            var leases = await ReservationAuthority.ListAsync(
                request.ProjectId,
                includeReleased: false,
                CancellationToken.None);

            var scoped = new List<ReservationLeaseDto>();
            var recovery = 0;
            foreach (var lease in leases)
            {
                if (lease.RequestId != RequestId)
                {
                    continue;
                }

                scoped.Add(lease);
                if ((ReservationLeaseState)lease.State == ReservationLeaseState.RecoveryRequired)
                {
                    recovery++;
                }
            }

            scoped.Sort((left, right) => left.AcquiredAt.CompareTo(right.AcquiredAt));
            _leases = scoped;
            _projectLeaseCount = leases.Count - scoped.Count;
            _recoveryLeaseCount = recovery;
            _reservationError = null;
        }
        catch (Exception ex)
        {
            _reservationError = ex.Message;
            _leases = Array.Empty<ReservationLeaseDto>();
            _projectLeaseCount = 0;
            _recoveryLeaseCount = 0;
        }

        _reservationEvents = ReservationEvents();
    }

    private IReadOnlyList<SessionEventDto> ReservationEvents()
    {
        var audit = new List<SessionEventDto>();
        for (var index = _events.Count - 1; index >= 0 && audit.Count < ReservationAuditCap; index--)
        {
            if (_events[index].Type.StartsWith("reservation.", StringComparison.Ordinal))
            {
                audit.Add(_events[index]);
            }
        }

        return audit;
    }

    private void BuildGuidanceTargets()
    {
        var active = new List<string>();
        var targets = new List<GuidanceTarget>();

        if (_root is not null && IsAddressable(_root))
        {
            targets.Add(new GuidanceTarget(
                _root.Id,
                $"Root \u00b7 {_root.AgentName} ({_root.Role})",
                new[] { _root.Id }));
        }

        foreach (var session in _sessions)
        {
            if (!IsAddressable(session))
            {
                continue;
            }

            active.Add(session.Id);
            if (_root is not null && string.Equals(session.Id, _root.Id, StringComparison.Ordinal))
            {
                continue;
            }

            targets.Add(new GuidanceTarget(
                session.Id,
                $"{session.Role} \u00b7 {session.AgentName}",
                new[] { session.Id }));
        }

        if (active.Count > 1)
        {
            targets.Add(new GuidanceTarget(AllAgentsTarget, $"All active agents ({active.Count})", active));
        }

        _guidanceTargets = targets;
    }

    private static bool IsAddressable(AgentSessionDto session) =>
        session.EndedAt is null && session.Liveness != AgentLiveness.Exited;

    private void BuildTree()
    {
        _children.Clear();
        _sessionsById.Clear();
        _roots = [];

        foreach (var session in _sessions)
        {
            _sessionsById[session.Id] = session;
        }

        foreach (var session in _sessions)
        {
            if (session.ParentSessionId is { } parent && _sessionsById.ContainsKey(parent))
            {
                if (!_children.TryGetValue(parent, out var siblings))
                {
                    siblings = [];
                    _children[parent] = siblings;
                }

                siblings.Add(session);
            }
            else
            {
                _roots.Add(session);
            }
        }

        _root = _roots.Count > 0 ? _roots[0] : null;
    }

    private IReadOnlyList<AgentSessionDto> ChildrenOf(string sessionId) =>
        _children.TryGetValue(sessionId, out var children) ? children : Array.Empty<AgentSessionDto>();

    private IEnumerable<SessionEventDto> TimelineWindow()
    {
        var skip = Math.Max(0, _events.Count - TimelineCap);
        for (var index = _events.Count - 1; index >= skip; index--)
        {
            yield return _events[index];
        }
    }

    private string SessionLabel(string sessionId) =>
        _sessionsById.TryGetValue(sessionId, out var session)
            ? $"{session.AgentName} ({sessionId})"
            : sessionId;

    private IEnumerable<PlanRevision> PlanHistory()
    {
        for (var index = _insights.PlanRevisions.Count - 2; index >= 0; index--)
        {
            yield return _insights.PlanRevisions[index];
        }
    }

    /// <summary>Runs grouped by profile in first-seen order, each profile's runs oldest first.</summary>
    private IEnumerable<KeyValuePair<string, List<VerificationRunDto>>> VerificationProfiles()
    {
        var byProfile = new Dictionary<string, List<VerificationRunDto>>(StringComparer.Ordinal);
        var order = new List<string>();
        foreach (var run in _verificationRuns)
        {
            if (!byProfile.TryGetValue(run.ProfileId, out var runs))
            {
                runs = [];
                byProfile[run.ProfileId] = runs;
                order.Add(run.ProfileId);
            }

            runs.Add(run);
        }

        foreach (var profileId in order)
        {
            yield return new KeyValuePair<string, List<VerificationRunDto>>(profileId, byProfile[profileId]);
        }
    }

    private static bool ProfileGreen(List<VerificationRunDto> runs)
    {
        foreach (var run in runs)
        {
            if (run.Status != VerificationRunStatus.Passed)
            {
                return false;
            }
        }

        return runs.Count > 0;
    }

    private static string RunClass(VerificationRunStatus status) => status switch
    {
        VerificationRunStatus.Passed => "is-passed",
        VerificationRunStatus.Running => "is-running",
        VerificationRunStatus.Cancelled => string.Empty,
        _ => "is-failed",
    };

    private static string RunDuration(VerificationRunDto run) =>
        run.CompletedAt is { } completed
            ? $"{(completed - run.StartedAt).TotalSeconds:0.0}s"
            : "still running";

    private string VerificationSummary()
    {
        if (_verificationError is not null)
        {
            return "verification store unavailable";
        }

        var green = 0;
        var red = 0;
        var mandatoryRed = 0;
        foreach (var run in _verificationRuns)
        {
            if (run.Status == VerificationRunStatus.Passed)
            {
                green++;
                continue;
            }

            if (run.Status is VerificationRunStatus.Failed or VerificationRunStatus.TimedOut)
            {
                red++;
                if (run.Mandatory)
                {
                    mandatoryRed++;
                }
            }
        }

        return $"{_verificationRuns.Count} run(s) \u00b7 {green} green \u00b7 {red} red "
            + $"({mandatoryRed} mandatory) \u00b7 refreshed {TimeText.Relative(_snapshot, Clock.UtcNow)}";
    }

    private string ProjectHref() =>
        _request is null ? "/" : $"/projects/{_request.ProjectId}";

    private static bool HasPayload(string payloadJson) =>
        !string.IsNullOrWhiteSpace(payloadJson) && payloadJson is not "{}" and not "null";

    private static string Payload(string payloadJson) =>
        payloadJson.Length <= PayloadCap
            ? payloadJson
            : string.Concat(payloadJson.AsSpan(0, PayloadCap), "\u2026 (truncated)");

    private static bool IsWorking(AgentActivity activity) => activity != AgentActivity.Idle;

    private static bool IsTerminal(AgentWorkState state) =>
        state is AgentWorkState.Completed or AgentWorkState.Failed or AgentWorkState.Cancelled;

    private static bool IsFailed(AgentWorkState state) =>
        state is AgentWorkState.Failed or AgentWorkState.Cancelled or AgentWorkState.Blocked;

    private string PrimaryThreadId() => RequestId.ToString();

    private static string GuidanceSubjectSeed(WorkRequestDto request) =>
        $"[{request.Title}] Human guidance";

    private string MessageSummary()
    {
        if (_mailError is not null)
        {
            return "mail projection unavailable";
        }

        return $"{_messageCount} message{(_messageCount == 1 ? string.Empty : "s")} in "
            + $"{_threads.Count} thread{(_threads.Count == 1 ? string.Empty : "s")} \u00b7 "
            + $"{_unreadMessageCount} unread \u00b7 refreshed {TimeText.Relative(_snapshot, Clock.UtcNow)}";
    }

    private string ReservationSummary()
    {
        if (_reservationError is not null)
        {
            return "reservation authority unavailable";
        }

        return $"{_leases.Count} lease group{(_leases.Count == 1 ? string.Empty : "s")} \u00b7 "
            + $"{_recoveryLeaseCount} awaiting recovery \u00b7 "
            + $"refreshed {TimeText.Relative(_snapshot, Clock.UtcNow)}";
    }

    private static bool IsReservationWarning(string type) => type
        is "reservation.denied"
        or "reservation.expired"
        or "reservation.recovery_required"
        or "reservation.force_released"
        or "reservation.handoff_requested";

    /// <summary>One mail thread of this request as rendered by <c>MessageThreadView</c>.</summary>
    private sealed record MessageThread(
        string ThreadId,
        string Subject,
        bool IsPrimary,
        IReadOnlyList<AgentMessageDto> Messages);

    private static string RequirementText(string code) => code switch
    {
        CompletionRequirements.PlanEvent => "no plan event is persisted for this request",
        CompletionRequirements.ImplementationChild => "no implementation child agent completed",
        CompletionRequirements.IndependentReviewer => "no independent reviewer completed",
        CompletionRequirements.UnresolvedBlockingFinding => "a blocking review finding is unresolved",
        CompletionRequirements.MandatoryVerification => "a mandatory verification command is not green",
        CompletionRequirements.ActiveMutation => "a mutation is still in flight",
        CompletionRequirements.ActiveReservation => "an active reservation is still held",
        CompletionRequirements.DiffCaptured => "no repository diff was captured",
        CompletionRequirements.OwnershipKnown => "a changed file has no known owner",
        CompletionRequirements.ResultSummary => "the result summary is blank",
        _ => "reported by the completion gate",
    };

    private static string Relative(DateTimeOffset instant, DateTimeOffset now) =>
        TimeText.Relative(instant, now);
}
