@page "/requests/{RequestId:guid}"
@namespace PiCommandCenter.Web.Components.Pages
@rendermode InteractiveServer
@using PiCommandCenter.Application
@using PiCommandCenter.Application.Mail
@using PiCommandCenter.Application.Projects
@using PiCommandCenter.Application.Requests
@using PiCommandCenter.Application.Reservations
@using PiCommandCenter.Application.Sessions
@using PiCommandCenter.Domain
@using PiCommandCenter.Domain.Requests
@using PiCommandCenter.Domain.Reservations
@using PiCommandCenter.Domain.Sessions
@using PiCommandCenter.Application.Completion
@using PiCommandCenter.Application.Verification
@using PiCommandCenter.Domain.Verification
@using PiCommandCenter.Domain.Completion
@using PiCommandCenter.Web.Components.Requests
@using PiCommandCenter.Web.Components
@using PiCommandCenter.Web.Components.Coordination
@using PiCommandCenter.Web.Components.Sessions
@using PiCommandCenter.Application.Live
@using PiCommandCenter.Web.Components.Live
@implements IAsyncDisposable
@inject IRequestQueue Queue
@inject IProjectCatalog Catalog
@inject IAgentSessionStore SessionStore
@inject PiCommandCenter.Application.Mail.IMessageService Mail
@inject IReservationService ReservationAuthority
@inject IClock Clock
@inject IVerificationRunStore VerificationRunStore
@inject IAssignmentTerminalizationService CompletionGate
@inject IProjectionNotifier Notifier
@inject NavigationManager Navigation

<PageTitle>@(_request?.Title ?? "Request") &middot; DevFleet</PageTitle>

@if (_loading)
{
    <div class="state-block" role="status">
        <FluentProgressRing aria-label="Loading request" />
        <span>Loading request</span>
    </div>
}
else if (_request is null)
{
    <div class="state-empty">
        <h1>Request not found</h1>
        <p class="page-lead">
            @if (_loadError is not null)
            {
                @_loadError
            }
            else
            {
                <text>No work request is queued with that id.</text>
            }
        </p>
        <p class="mono hint">@RequestId</p>
        <a class="back-link" href="/">Back to fleet</a>
    </div>
}
else
{
    var request = _request;

    <div class="request-page">

        <header class="page-head">
            <a class="back-link" href="@ProjectHref()">
                @(_project is null ? "Back to project" : $"Back to {_project.DisplayName}")
            </a>
            <div class="page-head-row">
                <div class="page-head-copy">
                    <h1>@request.Title</h1>
                    <div class="badge-row">
                        <FluentBadge Appearance="Appearance.Accent">@request.StatusName</FluentBadge>
                        <FluentBadge Appearance="Appearance.Neutral">@request.PriorityName</FluentBadge>
                        <FluentBadge Appearance="Appearance.Neutral">@request.KindName</FluentBadge>
                        <FluentBadge Appearance="Appearance.Neutral">@request.RiskLevelName</FluentBadge>
                        @if (request.BlockedPhaseName is not null)
                        {
                            <FluentBadge Appearance="Appearance.Neutral">blocked in @request.BlockedPhaseName</FluentBadge>
                        }
                    </div>
                </div>
                <div class="page-head-actions">
                    <FluentButton Appearance="Appearance.Stealth" OnClick="ManualReloadAsync">
                        Reload
                    </FluentButton>
                </div>
            </div>
            <p class="page-lead">
                Request state and agent sessions are read from the control-plane projection.
                Updated as writes commit, re-read at least every @SafetySeconds s;
                snapshot @_snapshot.ToString("u").
            </p>
        </header>

        @if (_loadError is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Error"
                              Title="Could not refresh request"
                              AllowDismiss="false">
                @_loadError
            </FluentMessageBar>
        }

        @if (_attention.Count > 0)
        {
            <section class="page-section" aria-labelledby="attention-heading">
                <div class="section-head">
                    <h2 id="attention-heading">Needs attention</h2>
                    <div class="section-actions">
                        <FluentAnchor Href="/attention" Appearance="Appearance.Stealth">
                            Fleet attention queue
                        </FluentAnchor>
                    </div>
                </div>
                <div class="signal-stack">
                    @foreach (var signal in _attention)
                    {
                        <AttentionCallout Signal="signal" Now="_snapshot" />
                    }
                </div>
            </section>
        }

        @* Placed after "Needs attention" on purpose: a request waiting for input or an
           unmet configuration blocker keeps its own specific fix first, and recovery is
           offered only for a retained assignment or a disconnected owner. *@
        @if (_recovery is { } recovery)
        {
            <section class="page-section" aria-labelledby="recovery-entry-heading">
                <div class="section-head">
                    <h2 id="recovery-entry-heading">@recovery.Title</h2>
                    <div class="section-actions">
                        <FluentAnchor Href="@RecoveryHref()" Appearance="Appearance.Accent">
                            Recover project
                        </FluentAnchor>
                    </div>
                </div>
                <p class="page-lead">@recovery.Detail</p>
            </section>
        }

        @{
            // Reduced once per load so the section reads the same snapshot as every other panel;
            // no timer and no polling participate — LiveView reloads on committed writes.
            var progress = _progress
                ?? RequestExecutionProgressReader.Read(request, _sessions, _events, _snapshot);
        }

        <section class="page-section progress-section" aria-labelledby="progress-heading">
            <div class="section-head">
                <h2 id="progress-heading">Ongoing progress</h2>
                <span class="section-meta">
                    @(progress.IsRunning ? "live" : "final") &middot;
                    reduced from @progress.EventCount persisted event@(progress.EventCount == 1 ? string.Empty : "s")
                </span>
            </div>

            <FluentCard>
                <div class="panel progress-panel">
                    @if (progress.IsRunning)
                    {
                        <FluentProgress aria-label="@($"{progress.Phase}, running for {progress.ElapsedText}")" />
                    }

                    <p class="progress-summary" role="status" aria-live="polite" aria-atomic="true">
                        @ProgressAnnouncement(progress)
                    </p>

                    @* Assertive only for a terminal failure; always rendered, empty otherwise, so
                       screen readers keep one stable region instead of a re-inserted node. *@
                    <p class="visually-hidden" role="alert" aria-live="assertive" aria-atomic="true">
                        @FailureAnnouncement(progress)
                    </p>

                    <dl class="facts">
                        <dt>Phase</dt>
                        <dd>@progress.Phase</dd>
                        <dt>Request status</dt>
                        <dd>@progress.Status</dd>
                        <dt>@(progress.IsRunning ? "Running for" : "Ran for")</dt>
                        <dd>
                            @progress.ElapsedText
                            <span class="hint">since @progress.ElapsedSince.ToString("u")</span>
                        </dd>
                        <dt>Last durable activity</dt>
                        <dd class="fact-lines">
                            @if (progress.LastActivityAt is { } activity)
                            {
                                <span>@Relative(activity, _snapshot)</span>
                                <span class="hint">@activity.ToString("u")</span>
                            }
                            else
                            {
                                <span class="hint">no session event persisted yet</span>
                            }
                        </dd>
                        <dt>Persisted events</dt>
                        <dd>@progress.EventCount</dd>
                        <dt>Tool calls observed</dt>
                        <dd>@progress.ToolCallCount</dd>
                    </dl>

                    <div class="progress-block">
                        <div class="section-head is-tight">
                            <h3 id="progress-operations-heading">Agent operations</h3>
                        </div>
                        @if (progress.HasOperations)
                        {
                            <ul class="progress-list" aria-labelledby="progress-operations-heading">
                                @foreach (var operation in progress.Operations)
                                {
                                    <li>
                                        <span class="operation-label">@operation.Role &middot; @operation.AgentName</span>
                                        <span>@(operation.Operation ?? operation.StatusReason ?? "no operation reported")</span>
                                        <span class="hint">
                                            @operation.Activity &middot; <span class="mono">@operation.SessionId</span>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="panel-empty">
                                @(progress.IsTerminal
                                    ? "No agent session is still open; the final state above is retained."
                                    : "No live agent session reports an operation right now.")
                            </p>
                        }
                    </div>

                    <div class="progress-block">
                        <div class="section-head is-tight">
                            <h3 id="progress-activity-heading">Recent durable activity</h3>
                            <span class="section-meta">newest first &middot; last @RequestExecutionProgressReader.FactCap</span>
                        </div>
                        @if (progress.Facts.Count > 0)
                        {
                            <ol class="progress-list" aria-labelledby="progress-activity-heading">
                                @foreach (var fact in progress.Facts)
                                {
                                    <li>
                                        <span class="event-time">@Relative(fact.OccurredAt, _snapshot)</span>
                                        <span>@fact.Label</span>
                                        <span class="hint mono">@fact.EventType</span>
                                    </li>
                                }
                            </ol>
                        }
                        else
                        {
                            <p class="panel-empty">
                                No lifecycle, turn, tool, child, or verification event is persisted yet.
                                The full stream stays under <a href="#timeline-heading">Event timeline</a>.
                            </p>
                        }
                    </div>
                </div>
            </FluentCard>
        </section>

        <div class="overview-grid">
            <FluentCard>
                <section class="panel" aria-labelledby="original-heading">
                    <h2 id="original-heading">Original request</h2>
                    <p class="request-prompt">@request.Prompt</p>
                    <dl class="facts">
                        <dt>Request id</dt>
                        <dd class="mono">@request.Id</dd>
                        @if (request.OriginalRequestId is { } original)
                        {
                            <dt>Retry of</dt>
                            <dd class="fact-lines">
                                <a href="@($"/requests/{original}")">the request this retry was drafted from</a>
                                <span class="mono hint">@original</span>
                                <span class="hint">
                                    Provenance only: this request never resumed that execution and
                                    holds no authority from it.
                                </span>
                            </dd>
                        }
                        <dt>Project</dt>
                        <dd>
                            @if (_project is not null)
                            {
                                <a href="@ProjectHref()">@_project.DisplayName</a>
                            }
                            <span class="mono hint">@request.ProjectId</span>
                        </dd>
                        <dt>Created</dt>
                        <dd>@request.CreatedAt.ToString("u")</dd>
                        <dt>Updated</dt>
                        <dd>
                            @request.UpdatedAt.ToString("u")
                            <span class="hint">(@Relative(request.UpdatedAt, _snapshot))</span>
                        </dd>
                        <dt>Version</dt>
                        <dd>@request.Version</dd>
                    </dl>
                </section>
            </FluentCard>

            <FluentCard>
                <section class="panel" aria-labelledby="status-heading">
                    <h2 id="status-heading">Current status</h2>

                    @if (_sessionError is not null)
                    {
                        <FluentMessageBar Intent="MessageIntent.Error"
                                          Title="Session projection unavailable"
                                          AllowDismiss="false">
                            @_sessionError
                        </FluentMessageBar>
                    }
                    else if (_root is null)
                    {
                        <p class="panel-empty">
                            No agent session is registered for this request yet. The request is
                            @request.StatusName; a session can only exist once the control plane
                            has created an execution assignment on the designated workspace node
                            and that node's runtime reports <span class="mono">session.registered</span>.
                            Scheduling eligibility and the assignment itself are shown under
                            <a href="#placement-heading">Placement and assignment</a>.
                        </p>
                    }
                    else
                    {
                        var root = _root;

                        <dl class="dimensions">
                            <div class="dimension @(root.Liveness == AgentLiveness.Online ? "is-live" : root.Liveness == AgentLiveness.Exited ? "is-alert" : string.Empty)">
                                <dt>Liveness</dt>
                                <dd>@root.Liveness</dd>
                            </div>
                            <div class="dimension @(IsWorking(root.Activity) ? "is-live" : string.Empty)">
                                <dt>Activity</dt>
                                <dd>@root.Activity</dd>
                            </div>
                            <div class="dimension @(root.Attention == AgentAttention.None ? string.Empty : "is-alert")">
                                <dt>Attention</dt>
                                <dd>@root.Attention</dd>
                            </div>
                            <div class="dimension @(IsFailed(root.WorkState) ? "is-alert" : IsTerminal(root.WorkState) ? string.Empty : "is-live")">
                                <dt>Work state</dt>
                                <dd>@root.WorkState</dd>
                            </div>
                        </dl>

                        <p class="operation">
                            <span class="operation-label">Status reason</span>
                            <span>@(string.IsNullOrWhiteSpace(root.StatusReason) ? "None reported." : root.StatusReason)</span>
                        </p>
                        <p class="operation">
                            <span class="operation-label">Current operation</span>
                            <span>@(root.CurrentOperation ?? "None reported.")</span>
                        </p>

                        <dl class="facts">
                            <dt>Root session</dt>
                            <dd class="mono">@root.Id</dd>
                            <dt>Model</dt>
                            <dd>
                                <span class="mono">@root.Model</span>
                                @if (ModelText.RuntimeAside(root.Runtime, root.Model) is { } runtime)
                                {
                                    <span class="hint">on @runtime</span>
                                }
                            </dd>
                            <dt>Provider session</dt>
                            <dd class="mono">@(root.ProviderSessionId ?? "not reported")</dd>
                            <dt>Process</dt>
                            <dd>@(root.ProcessId?.ToString() ?? "not reported")</dd>
                            <dt>Started</dt>
                            <dd>@root.StartedAt.ToString("u")</dd>
                            <dt>Last heartbeat</dt>
                            <dd>
                                @if (root.LastHeartbeatAt is { } beat)
                                {
                                    @beat.ToString("u")
                                    <span class="hint">(@Relative(beat, _snapshot))</span>
                                }
                                else
                                {
                                    <span class="hint">no heartbeat received</span>
                                }
                            </dd>
                            <dt>Ended</dt>
                            <dd>
                                @if (root.EndedAt is { } ended)
                                {
                                    @ended.ToString("u")
                                }
                                else
                                {
                                    <span class="hint">still open</span>
                                }
                            </dd>
                        </dl>
                    }
                </section>
            </FluentCard>
        </div>

        <section class="page-section" aria-labelledby="placement-heading">
            <div class="section-head">
                <h2 id="placement-heading">Placement and assignment</h2>
                <span class="section-meta">
                    @PlacementSummary(request)
                </span>
            </div>

            @if (request.SchedulingStatus is { } scheduling)
            {
                <FluentCard>
                    <section class="panel" aria-labelledby="scheduling-heading">
                        <div class="section-head is-tight">
                            <h3 id="scheduling-heading">Scheduling status</h3>
                            <span class="badge-row">
                                <FluentBadge Appearance="@(scheduling.IsEligible ? Appearance.Accent : Appearance.Neutral)">
                                    @SchedulingLabel(scheduling.Code)
                                </FluentBadge>
                                <FluentBadge Appearance="Appearance.Neutral">@scheduling.Code</FluentBadge>
                            </span>
                        </div>
                        <p class="operation">
                            <span class="operation-label">Detail</span>
                            <span>@scheduling.Detail</span>
                        </p>
                        <p class="operation">
                            <span class="operation-label">Action</span>
                            <span>@scheduling.Action</span>
                        </p>
                        <p class="panel-lead">
                            This request is queued with no execution assignment. The control plane
                            re-evaluates this decision on every claim attempt by the designated node;
                            being eligible is permission to be considered, not a claim.
                        </p>
                    </section>
                </FluentCard>
            }

            @if (request.Assignment is { } assignment)
            {
                @if (assignment.State == ExecutionAssignmentState.Finalizing)
                {
                    <FluentMessageBar Intent="MessageIntent.Warning"
                                      Title="Assignment is finalizing"
                                      AllowDismiss="false">
                        Completion was accepted but ownership has not been released: capacity remains
                        reserved while quiescing. The assigned node must close admission of new work,
                        drain mutations, verification, Git operations and supervised processes, and
                        flush its events before terminal state can be committed.
                    </FluentMessageBar>
                }
                else if (assignment.State == ExecutionAssignmentState.Cancelling)
                {
                    <FluentMessageBar Intent="MessageIntent.Warning"
                                      Title="Assignment is cancelling"
                                      AllowDismiss="false">
                        Cancellation was delivered only to the assigned node; capacity remains
                        reserved while quiescing. Reservations and the writer slot stay held until the
                        same node proves quiescence, so this request is not claimable elsewhere.
                    </FluentMessageBar>
                }
                else if (assignment.State == ExecutionAssignmentState.RecoveryRequired)
                {
                    <FluentMessageBar Intent="MessageIntent.Warning"
                                      Title="Assignment requires recovery"
                                      AllowDismiss="false">
                        Ownership uncertain; no second writer. The assignment is durable and still
                        occupies project and node capacity. It can be restored only by explicit
                        reconciliation from the same authenticated node, or closed by audited
                        administrator recovery that proves process and repository quiescence.
                    </FluentMessageBar>
                }

                <FluentCard>
                    <section class="panel" aria-labelledby="assignment-heading">
                        <div class="section-head is-tight">
                            <h3 id="assignment-heading">Execution assignment</h3>
                            <span class="badge-row">
                                <FluentBadge Appearance="@(IsAssignmentTerminal(assignment.State) ? Appearance.Neutral : Appearance.Accent)">
                                    @assignment.State
                                </FluentBadge>
                                <FluentBadge Appearance="Appearance.Neutral">
                                    @(IsAssignmentTerminal(assignment.State) ? "terminal history" : "holds the writer slot")
                                </FluentBadge>
                            </span>
                        </div>

                        <p class="panel-lead">
                            @(IsAssignmentTerminal(assignment.State)
                                ? "The assignment reached a terminal state. Its immutable placement snapshot and timestamps are retained as history; a retry is a new linked request, never a reassignment of this one."
                                : "Placement below is the immutable snapshot taken when the assignment was created. It does not follow later workspace edits, and lease expiry never releases it.")
                        </p>

                        <dl class="facts">
                            <dt>Node (snapshot)</dt>
                            <dd class="mono">@assignment.NodeIdSnapshot</dd>
                            <dt>Canonical repository path (snapshot)</dt>
                            <dd class="mono">@assignment.CanonicalRepositoryPathSnapshot</dd>
                            <dt>Default branch (snapshot)</dt>
                            <dd class="mono">@assignment.DefaultBranchSnapshot</dd>
                            <dt>Binding validation revision (snapshot)</dt>
                            <dd>@assignment.BindingValidationRevisionSnapshot</dd>
                            <dt>Workspace binding</dt>
                            <dd class="mono">@assignment.WorkspaceBindingId</dd>
                            <dt>Assignment state</dt>
                            <dd>@assignment.State</dd>
                            <dt>Assigned</dt>
                            <dd>
                                @assignment.AssignedAt.ToString("u")
                                <span class="hint">(@Relative(assignment.AssignedAt, _snapshot))</span>
                            </dd>
                            <dt>Lease expires</dt>
                            <dd>
                                @assignment.LeaseExpiresAt.ToString("u")
                                <span class="hint">@LeaseHint(assignment)</span>
                            </dd>
                            <dt>Last renewed</dt>
                            <dd>
                                @if (assignment.LastRenewedAt is { } renewed)
                                {
                                    @renewed.ToString("u")
                                    <span class="hint">(@Relative(renewed, _snapshot))</span>
                                }
                                else
                                {
                                    <span class="hint">never renewed</span>
                                }
                            </dd>
                            <dt>Last reconciled</dt>
                            <dd>
                                @if (assignment.LastReconciledAt is { } reconciled)
                                {
                                    @reconciled.ToString("u")
                                    <span class="hint">(@Relative(reconciled, _snapshot))</span>
                                }
                                else
                                {
                                    <span class="hint">never reconciled</span>
                                }
                            </dd>
                            <dt>Terminal</dt>
                            <dd>
                                @if (assignment.TerminalAt is { } terminal)
                                {
                                    @terminal.ToString("u")
                                    <span class="hint">(@Relative(terminal, _snapshot))</span>
                                }
                                else
                                {
                                    <span class="hint">not terminal</span>
                                }
                            </dd>
                        </dl>

                        <p class="hint">
                            The claim token authorizes only the assigned node and is never projected
                            to this view.
                        </p>
                    </section>
                </FluentCard>
            }
            else if (request.SchedulingStatus is null)
            {
                <p class="panel-empty">
                    No execution assignment exists for this request and no queued scheduling decision
                    is projected, because the request is @request.StatusName. Assignment placement
                    appears here once the designated node claims the request.
                </p>
            }
        </section>

        <section class="page-section" aria-labelledby="tree-heading">
            <div class="section-head">
                <h2 id="tree-heading">Agent tree</h2>
            </div>
            @if (_roots.Count == 0)
            {
                <p class="panel-empty">
                    No sessions yet. Root and child agents appear as their runtimes register.
                </p>
            }
            else
            {
                <FluentCard>
                    <div class="panel">
                        <ul class="agent-tree" role="tree" aria-labelledby="tree-heading">
                            @foreach (var session in _roots)
                            {
                                <AgentTreeNode Session="session" ChildrenOf="ChildrenOf" Now="_snapshot" />
                            }
                        </ul>
                    </div>
                </FluentCard>
            }
        </section>

        <section class="page-section" aria-labelledby="timeline-heading">
            <div class="section-head">
                <h2 id="timeline-heading">Event timeline</h2>
                <span class="section-meta" role="status" aria-live="polite">
                    @_events.Count persisted event@(_events.Count == 1 ? string.Empty : "s") &middot;
                    newest first &middot; refreshed @Relative(_snapshot, Clock.UtcNow)
                </span>
            </div>

            @if (_events.Count == 0)
            {
                <p class="panel-empty">
                    No events persisted for this request yet. Normalized runtime events land here in
                    occurrence order as the node forwards them.
                </p>
            }
            else
            {
                <FluentCard>
                    <div class="panel">
                        @if (_events.Count > TimelineCap)
                        {
                            <p class="panel-lead">
                                Showing the most recent @TimelineCap of @_events.Count events.
                            </p>
                        }
                        <ol class="timeline">
                            @foreach (var evt in TimelineWindow())
                            {
                                <li>
                                    <span class="event-time">
                                        <span class="visually-hidden">Occurred at</span>
                                        @evt.OccurredAt.ToString("HH:mm:ss")
                                    </span>
                                    <span class="event-type">@evt.Type</span>
                                    <div class="event-body">
                                        <span class="event-origin">
                                            seq @evt.Sequence &middot;
                                            @(evt.SessionId is null ? "request-scoped" : SessionLabel(evt.SessionId)) &middot;
                                            @evt.OccurredAt.ToString("u")
                                        </span>
                                        @if (HasPayload(evt.PayloadJson))
                                        {
                                            <details>
                                                <summary>payload</summary>
                                                <pre class="event-payload">@Payload(evt.PayloadJson)</pre>
                                            </details>
                                        }
                                    </div>
                                </li>
                            }
                        </ol>
                    </div>
                </FluentCard>
            }
        </section>

        <section class="page-section" aria-labelledby="messages-heading">
            <div class="section-head">
                <h2 id="messages-heading">Messages</h2>
                <span class="section-meta" role="status" aria-live="polite">
                    @MessageSummary()
                </span>
            </div>

            @if (_mailError is not null)
            {
                <FluentMessageBar Intent="MessageIntent.Error"
                                  Title="Mail projection unavailable"
                                  AllowDismiss="false">
                    @_mailError
                </FluentMessageBar>
            }
            else if (_threads.Count == 0)
            {
                <p class="panel-empty">
                    No message is persisted for this request yet. Agent-to-agent coordination lands in
                    the request thread <span class="mono">@PrimaryThreadId()</span>; the composer below
                    writes the first human message into that same thread.
                </p>
            }
            else
            {
                <div class="thread-stack">
                    @foreach (var thread in _threads)
                    {
                        <FluentCard>
                            <MessageThreadView ThreadId="thread.ThreadId"
                                               Subject="thread.Subject"
                                               Messages="thread.Messages"
                                               IsPrimary="thread.IsPrimary"
                                               Now="_snapshot"
                                               SessionLabel="SessionLabel" />
                        </FluentCard>
                    }
                </div>
            }

            <FluentCard>
                <div class="panel">
                    <GuidanceComposer ProjectId="request.ProjectId"
                                      RequestId="request.Id"
                                      ThreadId="@PrimaryThreadId()"
                                      SubjectSeed="@GuidanceSubjectSeed(request)"
                                      Targets="_guidanceTargets"
                                      OnSent="ManualReloadAsync" />
                </div>
            </FluentCard>
        </section>

        <section class="page-section" aria-labelledby="reservations-heading">
            <div class="section-head">
                <h2 id="reservations-heading">Reservations</h2>
                <span class="section-meta" role="status" aria-live="polite">
                    @ReservationSummary()
                </span>
            </div>

            @if (_reservationError is not null)
            {
                <FluentMessageBar Intent="MessageIntent.Error"
                                  Title="Reservation authority unavailable"
                                  AllowDismiss="false">
                    @_reservationError
                </FluentMessageBar>
            }
            else
            {
                @if (_recoveryLeaseCount > 0)
                {
                    <FluentMessageBar Intent="MessageIntent.Warning"
                                      Title="Recovery inspection outstanding"
                                      AllowDismiss="false">
                        @_recoveryLeaseCount lease group(s) of this request are in
                        <span class="mono">recovery-required</span>. Their scopes cannot be re-granted
                        until the node confirms the owning process stopped or a human force-releases.
                    </FluentMessageBar>
                }

                @if (_leases.Count == 0)
                {
                    <p class="panel-empty">
                        No lease group is held for this request. Agents acquire leases before any
                        mutation, so an idle request holds none;
                        @(_projectLeaseCount == 0
                            ? "the project holds none either."
                            : $"{_projectLeaseCount} lease group(s) are held elsewhere in this project.")
                    </p>
                }
                else
                {
                    <div class="lease-stack">
                        @foreach (var lease in _leases)
                        {
                            <FluentCard>
                                <ReservationLeaseCard Lease="lease"
                                                      OwnerLabel="@SessionLabel(lease.OwnerSessionId)"
                                                      Now="_snapshot"
                                                      OnForceReleased="ManualReloadAsync" />
                            </FluentCard>
                        }
                    </div>
                }

                @if (_reservationEvents.Count > 0)
                {
                    <FluentCard>
                        <div class="panel">
                            <h3>Handoff and recovery activity</h3>
                            <p class="panel-lead">
                                Persisted <span class="mono">reservation.*</span> events for this
                                request, newest first. Handoff, expiry, recovery, and force-release
                                transitions are audited here.
                            </p>
                            <ul class="audit-list">
                                @foreach (var evt in _reservationEvents)
                                {
                                    <li class="@(IsReservationWarning(evt.Type) ? "audit-warning" : null)">
                                        <span class="event-type">@evt.Type</span>
                                        <span class="event-origin">
                                            @(evt.SessionId is null ? "request-scoped" : SessionLabel(evt.SessionId))
                                            &middot; @evt.OccurredAt.ToString("u")
                                            &middot; @TimeText.Relative(evt.OccurredAt, _snapshot)
                                        </span>
                                        @if (HasPayload(evt.PayloadJson))
                                        {
                                            <details>
                                                <summary>payload</summary>
                                                <pre class="event-payload">@Payload(evt.PayloadJson)</pre>
                                            </details>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </FluentCard>
                }
            }
        </section>

        <div class="split-grid">
            <section class="page-section" aria-labelledby="plan-heading">
                <div class="section-head">
                    <h2 id="plan-heading">Structured plan</h2>
                </div>
                @if (_insights.CurrentPlan is not { } plan)
                {
                    <p class="panel-empty">
                        No plan is persisted for this request. The root agent's
                        <span class="mono">create_plan</span> tool writes a
                        <span class="mono">request.phase_changed</span> event with phase
                        <span class="mono">plan</span>; this view renders that event and nothing else.
                    </p>
                }
                else
                {
                    <FluentCard>
                        <div class="panel">
                            <p class="panel-lead">
                                @(plan.IsRevision ? "Revision" : "Initial plan") persisted at
                                <span class="mono">@plan.OccurredAt.ToString("u")</span>
                                by @(plan.SessionId is null ? "the request scope" : SessionLabel(plan.SessionId))
                                &middot; seq @plan.Sequence
                                @if (_insights.PlanRevisions.Count > 1)
                                {
                                    <text>&middot; @(_insights.PlanRevisions.Count - 1) earlier version(s)</text>
                                }
                            </p>

                            @if (plan.Reason is { Length: > 0 } reason)
                            {
                                <p class="operation">
                                    <span class="operation-label">Reason</span>
                                    <span>@reason</span>
                                </p>
                            }

                            @if (plan.Steps.Count == 0)
                            {
                                <p class="panel-empty">
                                    The plan event carried no <span class="mono">steps</span> array. Its
                                    payload is shown verbatim rather than summarized.
                                </p>
                                <pre class="event-payload">@Payload(plan.PayloadJson)</pre>
                            }
                            else
                            {
                                <ol class="plan-steps">
                                    @foreach (var step in plan.Steps)
                                    {
                                        <li>@step.Text</li>
                                    }
                                </ol>
                            }

                            @if (_insights.PlanRevisions.Count > 1)
                            {
                                <details>
                                    <summary>Revision history</summary>
                                    <ul class="audit-list">
                                        @foreach (var revision in PlanHistory())
                                        {
                                            <li>
                                                <span class="event-type">
                                                    @(revision.IsRevision ? "plan_revision" : "plan")
                                                </span>
                                                <span class="event-origin">
                                                    seq @revision.Sequence &middot;
                                                    @revision.OccurredAt.ToString("u") &middot;
                                                    @revision.Steps.Count step(s)
                                                    @if (revision.Reason is { Length: > 0 } why)
                                                    {
                                                        <text> &middot; @why</text>
                                                    }
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                        </div>
                    </FluentCard>
                }
            </section>

            <section class="page-section" aria-labelledby="diff-heading">
                <div class="section-head">
                    <h2 id="diff-heading">Repository diff</h2>
                </div>

                @foreach (var external in _insights.ExternalChanges)
                {
                    <FluentMessageBar Intent="MessageIntent.Error"
                                      Title="External repository change detected"
                                      AllowDismiss="false">
                        @(external.Paths.Count == 0
                            ? "The node recorded a change no lease accounts for and listed no paths."
                            : $"Changed outside every lease: {string.Join(", ", external.Paths)}.")
                        @external.Detail
                        Completion stays blocked until a human attributes or reverts the change; the
                        Command Center never resets, stashes, or cleans the repository.
                    </FluentMessageBar>
                }

                @if (_insights.LatestDiff is not { } diff)
                {
                    <p class="panel-empty">
                        No diff snapshot is persisted. The node writes
                        <span class="mono">repository.changed</span> and
                        <span class="mono">repository.checkpoint_created</span> events as it captures the
                        working tree; this view renders those events only.
                    </p>
                }
                else
                {
                    <FluentCard>
                        <div class="panel">
                            <p class="panel-lead">
                                <span class="mono">@diff.EventType</span> at
                                <span class="mono">@diff.OccurredAt.ToString("u")</span>
                                &middot; seq @diff.Sequence
                                &middot; @_insights.DiffSnapshots.Count snapshot(s) captured
                            </p>

                            <dl class="facts">
                                <dt>Branch</dt>
                                <dd>@(diff.Branch ?? "not recorded")</dd>
                                <dt>Base commit</dt>
                                <dd class="mono">@(diff.BaseCommit ?? "not recorded")</dd>
                                <dt>Head commit</dt>
                                <dd class="mono">@(diff.HeadCommit ?? "not recorded")</dd>
                            </dl>

                            @if (diff.Paths.Count == 0)
                            {
                                <p class="panel-empty">
                                    The snapshot recorded no paths. Its payload is shown verbatim.
                                </p>
                                <pre class="event-payload">@Payload(diff.PayloadJson)</pre>
                            }
                            else
                            {
                                <ul class="file-list">
                                    @foreach (var path in diff.Paths)
                                    {
                                        <li class="@(path.Reserved == false ? "file-unattributed" : null)">
                                            <span class="mono file-path">@path.Path</span>
                                            @if (path.ChangeKind is { Length: > 0 } kind)
                                            {
                                                <FluentBadge Appearance="Appearance.Neutral">@kind</FluentBadge>
                                            }
                                            @if (path.LinesAdded is { } added || path.LinesRemoved is { } removed)
                                            {
                                                <span class="file-lines">
                                                    +@(path.LinesAdded?.ToString() ?? "?")
                                                    /
                                                    -@(path.LinesRemoved?.ToString() ?? "?")
                                                </span>
                                            }
                                            <span class="file-owner">
                                                @(path.OwnerSessionId is null
                                                    ? "ownership not recorded"
                                                    : SessionLabel(path.OwnerSessionId))
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </FluentCard>
                }
            </section>
        </div>

        <section class="page-section" aria-labelledby="verification-heading">
            <div class="section-head">
                <h2 id="verification-heading">Verification</h2>
                <span class="section-meta" role="status" aria-live="polite">
                    @VerificationSummary()
                </span>
            </div>

            @if (_verificationError is not null)
            {
                <FluentMessageBar Intent="MessageIntent.Error"
                                  Title="Verification store unavailable"
                                  AllowDismiss="false">
                    @_verificationError
                </FluentMessageBar>
            }
            else
            {
                @* Four distinct concepts, never merged into one profile list: the independent
                   agent, the automatic baseline, the Project's selected checks, and the
                   child-requested intermediate history. *@
                <div class="verification-stack">
                    <FluentCard>
                        <section class="panel" aria-labelledby="verification-agent-heading">
                            <div class="section-head is-tight">
                                <h3 id="verification-agent-heading">Verification agent</h3>
                                <span class="section-meta">independent agent review</span>
                            </div>
                            @if (_verification.ReviewSessions.Count == 0)
                            {
                                <p class="panel-empty">
                                    No reviewer or verifier session is registered for this request.
                                    Independent review is performed by a child session whose model
                                    comes from <a href="/routing">role routing</a>; routing chooses
                                    models only and never defines an executable command.
                                </p>
                            }
                            else
                            {
                                <ul class="run-list" aria-labelledby="verification-agent-heading">
                                    @foreach (var session in _verification.ReviewSessions)
                                    {
                                        <li class="run @ReviewClass(session)">
                                            <span class="run-command">@session.AgentName</span>
                                            <span class="badge-row">
                                                <FluentBadge Appearance="Appearance.Neutral">@session.Role</FluentBadge>
                                                <FluentBadge Appearance="@(session.WorkState == AgentWorkState.Completed ? Appearance.Accent : Appearance.Neutral)">
                                                    @session.WorkState
                                                </FluentBadge>
                                            </span>
                                            <span class="run-facts">
                                                @session.Liveness &middot; @session.Activity &middot;
                                                @(session.CurrentOperation
                                                    ?? (string.IsNullOrWhiteSpace(session.StatusReason)
                                                        ? "no operation reported"
                                                        : session.StatusReason))
                                            </span>
                                            <span class="run-facts mono">@session.Id</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    </FluentCard>

                    <FluentCard>
                        <section class="panel" aria-labelledby="verification-baseline-heading">
                            <div class="section-head is-tight">
                                <h3 id="verification-baseline-heading">Automatic baseline</h3>
                                <span class="section-meta">devfleet-baseline &middot; always enabled</span>
                            </div>
                            @if (_verification.Baseline.Count == 0)
                            {
                                <p class="panel-empty">
                                    @if (_verification.IsAdmittedInProgress && _verification.Admitted is { } admitted)
                                    {
                                        <text>
                                            Final verification is in progress for fingerprint
                                            <span class="mono">@Short(admitted.Fingerprint)</span>.
                                            @if (admitted.Command is { } command)
                                            {
                                                <text>
                                                    Running @command.CommandId for @CommandElapsed(command)
                                                    of a @command.TimeoutSeconds s budget
                                                    @(command.Mandatory ? "(mandatory)" : "(optional)").
                                                </text>
                                            }
                                            else
                                            {
                                                <text>
                                                    Command rows have not been persisted yet.
                                                    Elapsed @AdmittedElapsed(admitted) since
                                                    @admitted.StartedAt.ToString("u").
                                                </text>
                                            }
                                        </text>
                                    }
                                    else
                                    {
                                        <text>
                                            No baseline run is recorded for the current repository state.
                                            Final verification runs automatically when the request is
                                            submitted for completion, so nothing has to be started by hand.
                                            Which commands run beyond the baseline is chosen under
                                            <a href="@ProjectHref()">Project configuration</a>.
                                        </text>
                                    }
                                </p>
                            }
                            else
                            {
                                @if (_verification.BaselineSuccess is { } baselinePassed)
                                {
                                    <p class="run-verdict is-passed">@baselinePassed</p>
                                }
                                <ul class="run-list" aria-labelledby="verification-baseline-heading">
                                    @foreach (var row in _verification.Baseline)
                                    {
                                        @RunRow(row)
                                    }
                                </ul>
                            }
                        </section>
                    </FluentCard>

                    <FluentCard>
                        <section class="panel" aria-labelledby="verification-project-heading">
                            <div class="section-head is-tight">
                                <h3 id="verification-project-heading">Project checks</h3>
                                <span class="section-meta">@ProjectChecksMeta()</span>
                            </div>
                            @if (_verification.ProjectChecks.Count == 0)
                            {
                                <p class="panel-empty">
                                    @if (_verification.IsAdmittedInProgress)
                                    {
                                        <text>
                                            Final verification is admitted. Project-check command rows
                                            for this attempt have not been persisted yet.
                                        </text>
                                    }
                                    else if (RequestVerificationPolicyCopy.AssignedProfileId(
                                                 _request?.Assignment,
                                                 _request?.Assignment is not null)
                                             is { } assignedProfile)
                                    {
                                        <text>
                                            No project-check run is recorded for the current
                                            repository state. The assignment snapshot selected
                                            trusted profile <span class="mono">@assignedProfile</span>.
                                        </text>
                                    }
                                    else if (_request?.Assignment is not null)
                                    {
                                        <text>
                                            Baseline repository checks will run. The assignment
                                            snapshot selected no project-check profile.
                                        </text>
                                    }
                                    else if (_project?.TrustedVerificationProfileId is { Length: > 0 } selected)
                                    {
                                        <text>
                                            No project-check run is recorded for the current
                                            repository state. The current Project selection is
                                            trusted profile <span class="mono">@selected</span>
                                            and applies until this request is assigned.
                                        </text>
                                    }
                                    else
                                    {
                                        <text>
                                            Baseline repository checks will run. No project test
                                            suite is configured. A trusted profile is selected
                                            under <a href="@ProjectHref()">Project configuration</a>;
                                            command definitions stay node-owned.
                                        </text>
                                    }
                                </p>
                            }
                            else
                            {
                                @if (_verification.ProjectChecksSuccess is { } projectPassed)
                                {
                                    <p class="run-verdict is-passed">@projectPassed</p>
                                }
                                <ul class="run-list" aria-labelledby="verification-project-heading">
                                    @foreach (var row in _verification.ProjectChecks)
                                    {
                                        @RunRow(row)
                                    }
                                </ul>
                            }
                        </section>
                    </FluentCard>

                    <FluentCard>
                        <section class="panel" aria-labelledby="verification-intermediate-heading">
                            <div class="section-head is-tight">
                                <h3 id="verification-intermediate-heading">Intermediate checks</h3>
                                <span class="section-meta">history only</span>
                            </div>
                            @if (_verification.Intermediate.Count == 0)
                            {
                                <p class="panel-empty">
                                    No child requested an intermediate project check. Intermediate
                                    runs never change the request phase and are never counted by
                                    the completion gate.
                                </p>
                            }
                            else
                            {
                                <details>
                                    <summary>
                                        @_verification.Intermediate.Count intermediate
                                        run@(_verification.Intermediate.Count == 1 ? string.Empty : "s")
                                        requested during implementation
                                    </summary>
                                    <p class="panel-lead">
                                        Requested by a child while implementing. These runs never
                                        change the request phase, never appear in the final
                                        verification rows, and are never counted by the completion
                                        gate.
                                    </p>
                                    <ul class="run-list" aria-label="Intermediate check history">
                                        @foreach (var row in _verification.Intermediate)
                                        {
                                            @RunRow(row)
                                        }
                                    </ul>
                                </details>
                            }
                        </section>
                    </FluentCard>

                    @if (_verification.History.Count > 0)
                    {
                        <FluentCard>
                            <section class="panel" aria-labelledby="verification-history-heading">
                                <div class="section-head is-tight">
                                    <h3 id="verification-history-heading">Superseded attempts</h3>
                                    <span class="section-meta">retained history</span>
                                </div>
                                <details>
                                    <summary>
                                        @_verification.History.Count
                                        row@(_verification.History.Count == 1 ? string.Empty : "s")
                                        from an earlier fingerprint or policy revision
                                    </summary>
                                    <p class="panel-lead">
                                        The repository or the effective policy changed after these
                                        runs, so they are history: neither the completion gate nor
                                        the rows above count them, however green they were.
                                    </p>
                                    <ul class="run-list" aria-label="Superseded verification runs">
                                        @foreach (var row in _verification.History)
                                        {
                                            @RunRow(row)
                                        }
                                    </ul>
                                </details>
                            </section>
                        </FluentCard>
                    }
                </div>
            }
        </section>

        <section class="page-section" aria-labelledby="result-heading">
            <div class="section-head">
                <h2 id="result-heading">Final result</h2>
            </div>

            @if (_resultError is not null)
            {
                <FluentMessageBar Intent="MessageIntent.Error"
                                  Title="Completion gate unavailable"
                                  AllowDismiss="false">
                    @_resultError
                </FluentMessageBar>
            }

            @if (_insights.LatestRejection is { } rejection && _result is null)
            {
                <FluentMessageBar Intent="MessageIntent.Warning"
                                  Title="The completion gate rejected the last attempt"
                                  AllowDismiss="false">
                    Recorded @rejection.OccurredAt.ToString("u") as
                    <span class="mono">@rejection.EventType</span>.
                </FluentMessageBar>

                <FluentCard>
                    <div class="panel">
                        <h3>Missing requirements</h3>
                        <ul class="requirement-list">
                            @foreach (var requirement in rejection.MissingRequirements)
                            {
                                <li>
                                    <span class="mono">@requirement</span>
                                    <span class="hint">@RequirementText(requirement)</span>
                                </li>
                            }
                        </ul>
                    </div>
                </FluentCard>
            }

            @if (_result is { } result)
            {
                <FluentCard>
                    <div class="panel">
                        <p class="panel-lead">
                            Accepted by the completion gate at
                            <span class="mono">@result.CreatedAt.ToString("u")</span>
                            (@Relative(result.CreatedAt, _snapshot)).
                        </p>

                        <div class="result-grid">
                            <div class="result-block">
                                <h3>Summary</h3>
                                <p class="request-prompt">@result.SummaryMarkdown</p>
                            </div>

                            <div class="result-block">
                                <h3>Verification summary</h3>
                                <p class="request-prompt">@result.VerificationSummary</p>
                            </div>

                            <div class="result-block">
                                <h3>Changed files (@result.ChangedFiles.Count)</h3>
                                @if (result.ChangedFiles.Count == 0)
                                {
                                    <p class="panel-empty">The accepted result recorded no changed file.</p>
                                }
                                else
                                {
                                    <ul class="file-list">
                                        @foreach (var file in result.ChangedFiles)
                                        {
                                            <li><span class="mono file-path">@file</span></li>
                                        }
                                    </ul>
                                }
                            </div>

                            <div class="result-block">
                                <h3>Review findings (@result.ReviewFindings.Count)</h3>
                                @if (result.ReviewFindings.Count == 0)
                                {
                                    <p class="panel-empty">The reviewer recorded no finding.</p>
                                }
                                else
                                {
                                    <ul class="finding-list">
                                        @foreach (var finding in result.ReviewFindings)
                                        {
                                            <li class="@(finding.Blocking && !finding.Resolved ? "finding-blocking" : null)">
                                                <span class="mono">@finding.Id</span>
                                                <span>@finding.Summary</span>
                                                <span class="badge-row">
                                                    <FluentBadge Appearance="@(finding.Blocking ? Appearance.Accent : Appearance.Neutral)">
                                                        @(finding.Blocking ? "blocking" : "non-blocking")
                                                    </FluentBadge>
                                                    <FluentBadge Appearance="Appearance.Neutral">
                                                        @(finding.Resolved ? "resolved" : "open")
                                                    </FluentBadge>
                                                    @if (finding.UserOverridden)
                                                    {
                                                        <FluentBadge Appearance="Appearance.Neutral">user override</FluentBadge>
                                                    }
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>
                    </div>
                </FluentCard>
            }
            else if (_insights.LatestRejection is null && _resultError is null)
            {
                <p class="panel-empty">
                    No result is persisted. The gate stores one only when it accepts a completion,
                    and rejections appear here as
                    <span class="mono">request.completion_rejected</span> events.
                </p>
            }
        </section>

        @* A retry is a new queued request drafted from this one: it never resumes this execution
           and never clears a project recovery hold. Offered only once this request is terminal,
           because a live one still has its own execution to attend to. *@
        @if (IsRequestTerminal(request))
        {
            <section class="page-section" aria-labelledby="retry-heading">
                <div class="section-head">
                    <h2 id="retry-heading">Retry as new request</h2>
                    <span class="section-meta">new queued request &middot; linked to this one</span>
                </div>
                <p class="page-lead">
                    This request is @request.StatusName and its execution cannot resume: no session,
                    assignment, or reservation of this request is restarted or reused. A retry is an
                    ordinary new queued request, linked to this one for provenance, and it waits for
                    the same scheduling eligibility as any other queued work.
                </p>
                <p class="page-lead">
                    A project recovery hold is separate and stays in force: queueing a retry does not
                    clear it, and a held project must be resumed from
                    <a href="@RecoveryHref()">project recovery</a> before any queued request,
                    this retry included, can be claimed.
                </p>

                <FluentCard>
                    <div class="panel">
                        @if (_retryErrors.Count > 0)
                        {
                            <FluentMessageBar Intent="MessageIntent.Error"
                                              Title="Could not queue the retry"
                                              AllowDismiss="false">
                                @if (_retryErrors.Count == 1)
                                {
                                    @_retryErrors[0]
                                }
                                else
                                {
                                    <ul class="audit-list">
                                        @foreach (var error in _retryErrors)
                                        {
                                            <li>@error</li>
                                        }
                                    </ul>
                                }
                            </FluentMessageBar>
                        }

                        @* Kept even after navigation is issued, so the new request stays reachable
                           by a direct link if the operator never left this page. *@
                        @if (_retryCreated is { } queued)
                        {
                            <div role="status">
                                <FluentMessageBar Intent="MessageIntent.Success" AllowDismiss="false">
                                    Queued <a href="@($"/requests/{queued.Id}")">@queued.Title</a>
                                    as a linked retry. This request stays @request.StatusName.
                                </FluentMessageBar>
                            </div>
                        }

                        <details>
                            <summary>Edit and queue the retry</summary>
                            <div class="result-block">
                                <p class="panel-lead">
                                    Prefilled from this request and fully editable before it is
                                    queued. Submitting creates a new request linked to
                                    <span class="mono">@request.Id</span>; that link is immutable and
                                    this request is left exactly as it is.
                                </p>

                                <FluentTextField @bind-Value="_retryTitle"
                                                 Label="Title"
                                                 Required="true" />

                                <FluentTextArea @bind-Value="_retryPrompt"
                                                Label="Prompt"
                                                Required="true"
                                                Rows="5" />

                                <FluentSelect TOption="string"
                                              Label="Kind"
                                              Items="@KindNames"
                                              OptionText="@(name => name)"
                                              OptionValue="@(name => name)"
                                              @bind-Value="_retryKind" />

                                <FluentSelect TOption="string"
                                              Label="Priority"
                                              Items="@PriorityNames"
                                              OptionText="@(name => name)"
                                              OptionValue="@(name => name)"
                                              @bind-Value="_retryPriority" />

                                <FluentSelect TOption="string"
                                              Label="Risk"
                                              Items="@RiskNames"
                                              OptionText="@(name => name)"
                                              OptionValue="@(name => name)"
                                              @bind-Value="_retryRisk" />

                                @* This page's own 44px action sizing, shared with the head action. *@
                                <div class="page-head-actions">
                                    <FluentButton Appearance="Appearance.Accent"
                                                  OnClick="EnqueueRetryAsync"
                                                  Loading="@_retrySubmitting">
                                        Queue linked retry
                                    </FluentButton>
                                </div>
                            </div>
                        </details>
                    </div>
                </FluentCard>
            </section>
        }
    </div>
}

@code {
    private const int TimelineCap = 200;
    private const int SafetySeconds = 30;
    private const int PayloadCap = 2000;
    private const int ReservationAuditCap = 20;
    private const string AllAgentsTarget = "*";

    private static readonly string[] KindNames = Enum.GetNames<WorkRequestKind>();
    private static readonly string[] PriorityNames = Enum.GetNames<RequestPriority>();
    private static readonly string[] RiskNames = Enum.GetNames<RiskLevel>();

    [Parameter]
    public Guid RequestId { get; set; }

    private readonly Dictionary<string, List<AgentSessionDto>> _children = [];
    private readonly Dictionary<string, AgentSessionDto> _sessionsById = [];

    private List<AgentSessionDto> _roots = [];
    private IReadOnlyList<AgentSessionDto> _sessions = Array.Empty<AgentSessionDto>();
    private IReadOnlyList<SessionEventDto> _events = Array.Empty<SessionEventDto>();
    private AgentSessionDto? _root;
    private WorkRequestDto? _request;
    private ProjectDto? _project;
    private LiveView? _live;
    private DateTimeOffset _snapshot;
    private IReadOnlyList<AttentionSignal> _attention = Array.Empty<AttentionSignal>();
    private string? _loadError;
    private RecoveryEntry? _recovery;
    private string? _sessionError;
    private readonly List<MessageThread> _threads = [];
    private IReadOnlyList<GuidanceTarget> _guidanceTargets = Array.Empty<GuidanceTarget>();
    private IReadOnlyList<ReservationLeaseDto> _leases = Array.Empty<ReservationLeaseDto>();
    private IReadOnlyList<SessionEventDto> _reservationEvents = Array.Empty<SessionEventDto>();
    private int _messageCount;
    private int _unreadMessageCount;
    private int _projectLeaseCount;
    private int _recoveryLeaseCount;
    private string? _mailError;
    private string? _reservationError;
    private bool _loading = true;
    private bool _busy;
    private IReadOnlyList<VerificationRunDto> _verificationRuns = Array.Empty<VerificationRunDto>();
    private RequestVerificationView _verification = RequestVerificationViewReader.Read(
        Array.Empty<VerificationRunDto>(),
        Array.Empty<AgentSessionDto>());
    private RequestInsights _insights = RequestInsights.Empty;
    private RequestExecutionProgress? _progress;
    private RequestResultDto? _result;
    private string? _verificationError;
    private string? _resultError;

    // Retry draft: prefilled from the loaded request once, then owned by the operator so a
    // committed write elsewhere on the request cannot rewrite what is being typed.
    private Guid _retryDraftFor;
    private string? _retryTitle;
    private string? _retryPrompt;
    private string _retryKind = nameof(WorkRequestKind.Development);
    private string _retryPriority = nameof(RequestPriority.Normal);
    private string _retryRisk = nameof(RiskLevel.Standard);
    private IReadOnlyList<string> _retryErrors = Array.Empty<string>();
    private WorkRequestDto? _retryCreated;
    private bool _retrySubmitting;

    /// <summary>
    /// Reads the two outcome stores and reduces the event stream, then rebuilds the request's
    /// attention signals from those persisted facts.
    /// </summary>
    private async Task LoadOutcomeAsync(WorkRequestId requestId, WorkRequestDto request)
    {
        _insights = RequestInsightsReader.Read(_events);

        try
        {
            _verificationRuns = await VerificationRunStore.ListAsync(requestId, CancellationToken.None);
            _verificationError = null;
        }
        catch (Exception ex)
        {
            _verificationError = ex.Message;
            _verificationRuns = Array.Empty<VerificationRunDto>();
        }

        // Reduced once per load so every verification row, verdict, and count in the section
        // reads the same snapshot as the attention signals derived from the same rows.
        _verification = RequestVerificationViewReader.Read(_verificationRuns, _sessions, _events);

        try
        {
            _result = await CompletionGate.GetResultAsync(requestId, CancellationToken.None);
            _resultError = null;
        }
        catch (Exception ex)
        {
            _resultError = ex.Message;
            _result = null;
        }

        var signals = new List<AttentionSignal>();
        AttentionScanner.Scan(
            signals,
            request,
            _project?.DisplayName ?? request.ProjectId.ToString(),
            _sessions,
            _leases,
            _verificationRuns,
            _insights,
            Clock.UtcNow,
            _events);
        _attention = signals;
        _recovery = ComputeRecoveryEntry(request, signals);
    }

    protected override Task OnParametersSetAsync() => LoadAsync(showSpinner: true);

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _live is null)
        {
            // Reloads are driven by committed writes to this request; the safety interval inside
            // LiveView covers anything a publisher missed.
            _live = new LiveView(
                Notifier,
                change => change.AffectsRequest(RequestId),
                () => InvokeAsync(async () =>
                {
                    await LoadAsync(showSpinner: false);
                    StateHasChanged();
                }));
        }
    }

    public async ValueTask DisposeAsync()
    {
        var live = _live;
        _live = null;
        if (live is not null)
        {
            await live.DisposeAsync();
        }
    }

    private Task ManualReloadAsync() => LoadAsync(showSpinner: true);

    /// <summary>
    /// Fills the retry draft from the request as it stands, once per request id: a live reload
    /// driven by a committed write must not overwrite fields the operator is editing.
    /// </summary>
    private void SeedRetryDraft(WorkRequestDto request)
    {
        if (_retryDraftFor == request.Id)
        {
            return;
        }

        _retryDraftFor = request.Id;
        _retryTitle = request.Title;
        _retryPrompt = request.Prompt;
        _retryKind = request.KindName;
        _retryPriority = request.PriorityName;
        _retryRisk = request.RiskLevelName;
        _retryErrors = Array.Empty<string>();
        _retryCreated = null;
    }

    /// <summary>
    /// Queues the edited draft as an ordinary new request carrying an immutable link to this one.
    /// Nothing here resumes this request's execution, releases its assignment, or touches a
    /// project recovery hold: the new request enters the queue and waits for ordinary eligibility.
    /// </summary>
    private async Task EnqueueRetryAsync()
    {
        if (_request is not { } request)
        {
            return;
        }

        _retryCreated = null;
        var errors = new List<string>(2);
        if (string.IsNullOrWhiteSpace(_retryTitle))
        {
            errors.Add("Title is required.");
        }

        if (string.IsNullOrWhiteSpace(_retryPrompt))
        {
            errors.Add("Prompt is required.");
        }

        if (errors.Count > 0)
        {
            _retryErrors = errors;
            return;
        }

        _retryErrors = Array.Empty<string>();
        _retrySubmitting = true;
        try
        {
            var command = new QueueWorkRequestCommand(
                Parse(_retryKind, WorkRequestKind.Development),
                Parse(_retryPriority, RequestPriority.Normal),
                Parse(_retryRisk, RiskLevel.Standard),
                _retryTitle!.Trim(),
                _retryPrompt!.Trim(),
                OriginalRequestId: request.Id);

            _retryCreated = await Queue.EnqueueAsync(
                new ProjectId(request.ProjectId),
                command,
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            _retryErrors = new[] { ex.Message };
        }
        finally
        {
            _retrySubmitting = false;
        }

        // The new request is persisted and already linked on this page, so navigation is issued
        // outside the guarded enqueue: whatever it does, the direct link stays.
        if (_retryCreated is { } created)
        {
            Navigation.NavigateTo($"/requests/{created.Id}");
        }
    }

    private static TEnum Parse<TEnum>(string? name, TEnum fallback)
        where TEnum : struct, Enum =>
        Enum.TryParse<TEnum>(name, out var parsed) ? parsed : fallback;

    private async Task LoadAsync(bool showSpinner)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        if (showSpinner)
        {
            _loading = true;
            StateHasChanged();
        }

        try
        {
            if (RequestId == Guid.Empty)
            {
                _request = null;
                return;
            }

            var requestId = new WorkRequestId(RequestId);
            _request = await Queue.GetAsync(requestId, CancellationToken.None);
            _loadError = null;
            SeedRetryDraft(_request);
            await LoadProjectAsync(_request.ProjectId);
            await LoadSessionsAsync(requestId);
            await LoadMailAsync(_request);
            await LoadReservationsAsync(_request);
            await LoadOutcomeAsync(requestId, _request);
        }
        catch (RequestNotFoundException)
        {
            _request = null;
            _loadError = null;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _snapshot = Clock.UtcNow;
            _progress = _request is null
                ? null
                : RequestExecutionProgressReader.Read(_request, _sessions, _events, _snapshot);
            _loading = false;
            _busy = false;
        }
    }

    private async Task LoadProjectAsync(Guid projectId)
    {
        try
        {
            _project = await Catalog.GetAsync(new ProjectId(projectId), CancellationToken.None);
        }
        catch (Exception)
        {
            _project = null;
        }
    }

    private async Task LoadSessionsAsync(WorkRequestId requestId)
    {
        try
        {
            _sessions = await SessionStore.ListAsync(requestId, CancellationToken.None);
            _events = await SessionStore.ListEventsAsync(requestId, CancellationToken.None);
            _sessionError = null;
        }
        catch (Exception ex)
        {
            _sessionError = ex.Message;
            _sessions = Array.Empty<AgentSessionDto>();
            _events = Array.Empty<SessionEventDto>();
        }

        BuildTree();
    }

    private async Task LoadMailAsync(WorkRequestDto request)
    {
        var projectId = new ProjectId(request.ProjectId);
        var primary = PrimaryThreadId();
        _threads.Clear();
        _messageCount = 0;
        _unreadMessageCount = 0;

        try
        {
            var threadIds = new List<string> { primary };
            foreach (var threadId in DiscoveredThreadIds())
            {
                if (!threadIds.Contains(threadId, StringComparer.Ordinal))
                {
                    threadIds.Add(threadId);
                }
            }

            foreach (var session in _sessions)
            {
                var unread = await Mail.GetUnreadAsync(projectId, session.Id, CancellationToken.None);
                foreach (var message in unread)
                {
                    if (message.RequestId.Value == RequestId
                        && !threadIds.Contains(message.ThreadId, StringComparer.Ordinal))
                    {
                        threadIds.Add(message.ThreadId);
                    }
                }
            }

            foreach (var threadId in threadIds)
            {
                var messages = await Mail.GetThreadAsync(projectId, threadId, CancellationToken.None);
                var scoped = new List<AgentMessageDto>(messages.Count);
                foreach (var message in messages)
                {
                    if (message.RequestId.Value != RequestId)
                    {
                        continue;
                    }

                    scoped.Add(message);
                    _messageCount++;
                    foreach (var recipient in message.Recipients)
                    {
                        if (recipient.ReadAtUtc is null)
                        {
                            _unreadMessageCount++;
                            break;
                        }
                    }
                }

                if (scoped.Count > 0)
                {
                    _threads.Add(new MessageThread(
                        threadId,
                        scoped[0].Subject,
                        string.Equals(threadId, primary, StringComparison.Ordinal),
                        scoped));
                }
            }

            _mailError = null;
        }
        catch (Exception ex)
        {
            _mailError = ex.Message;
            _threads.Clear();
            _messageCount = 0;
            _unreadMessageCount = 0;
        }

        BuildGuidanceTargets();
    }

    /// <summary>
    /// Thread ids proven by persisted <c>mail.*</c> events, so threads whose messages are already
    /// read are still listed. Unparsable payloads are skipped rather than guessed at.
    /// </summary>
    private IEnumerable<string> DiscoveredThreadIds()
    {
        foreach (var evt in _events)
        {
            if (!evt.Type.StartsWith("mail.", StringComparison.Ordinal) || !HasPayload(evt.PayloadJson))
            {
                continue;
            }

            string? threadId = null;
            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(evt.PayloadJson);
                if (document.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object
                    && document.RootElement.TryGetProperty("threadId", out var value)
                    && value.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    threadId = value.GetString();
                }
            }
            catch (System.Text.Json.JsonException)
            {
                threadId = null;
            }

            if (!string.IsNullOrWhiteSpace(threadId))
            {
                yield return threadId;
            }
        }
    }

    private async Task LoadReservationsAsync(WorkRequestDto request)
    {
        try
        {
            var leases = await ReservationAuthority.ListAsync(
                request.ProjectId,
                includeReleased: false,
                CancellationToken.None);

            var scoped = new List<ReservationLeaseDto>();
            var recovery = 0;
            foreach (var lease in leases)
            {
                if (lease.RequestId != RequestId)
                {
                    continue;
                }

                scoped.Add(lease);
                if ((ReservationLeaseState)lease.State == ReservationLeaseState.RecoveryRequired)
                {
                    recovery++;
                }
            }

            scoped.Sort((left, right) => left.AcquiredAt.CompareTo(right.AcquiredAt));
            _leases = scoped;
            _projectLeaseCount = leases.Count - scoped.Count;
            _recoveryLeaseCount = recovery;
            _reservationError = null;
        }
        catch (Exception ex)
        {
            _reservationError = ex.Message;
            _leases = Array.Empty<ReservationLeaseDto>();
            _projectLeaseCount = 0;
            _recoveryLeaseCount = 0;
        }

        _reservationEvents = ReservationEvents();
    }

    private IReadOnlyList<SessionEventDto> ReservationEvents()
    {
        var audit = new List<SessionEventDto>();
        for (var index = _events.Count - 1; index >= 0 && audit.Count < ReservationAuditCap; index--)
        {
            if (_events[index].Type.StartsWith("reservation.", StringComparison.Ordinal))
            {
                audit.Add(_events[index]);
            }
        }

        return audit;
    }

    private void BuildGuidanceTargets()
    {
        var active = new List<string>();
        var targets = new List<GuidanceTarget>();

        if (_root is not null && IsAddressable(_root))
        {
            targets.Add(new GuidanceTarget(
                _root.Id,
                $"Root \u00b7 {_root.AgentName} ({_root.Role})",
                new[] { _root.Id }));
        }

        foreach (var session in _sessions)
        {
            if (!IsAddressable(session))
            {
                continue;
            }

            active.Add(session.Id);
            if (_root is not null && string.Equals(session.Id, _root.Id, StringComparison.Ordinal))
            {
                continue;
            }

            targets.Add(new GuidanceTarget(
                session.Id,
                $"{session.Role} \u00b7 {session.AgentName}",
                new[] { session.Id }));
        }

        if (active.Count > 1)
        {
            targets.Add(new GuidanceTarget(AllAgentsTarget, $"All active agents ({active.Count})", active));
        }

        _guidanceTargets = targets;
    }

    private static bool IsAddressable(AgentSessionDto session) =>
        session.EndedAt is null && session.Liveness != AgentLiveness.Exited;

    private void BuildTree()
    {
        _children.Clear();
        _sessionsById.Clear();
        _roots = [];

        foreach (var session in _sessions)
        {
            _sessionsById[session.Id] = session;
        }

        foreach (var session in _sessions)
        {
            if (session.ParentSessionId is { } parent && _sessionsById.ContainsKey(parent))
            {
                if (!_children.TryGetValue(parent, out var siblings))
                {
                    siblings = [];
                    _children[parent] = siblings;
                }

                siblings.Add(session);
            }
            else
            {
                _roots.Add(session);
            }
        }

        _root = _roots.Count > 0 ? _roots[0] : null;
    }

    private IReadOnlyList<AgentSessionDto> ChildrenOf(string sessionId) =>
        _children.TryGetValue(sessionId, out var children) ? children : Array.Empty<AgentSessionDto>();

    private IEnumerable<SessionEventDto> TimelineWindow()
    {
        var skip = Math.Max(0, _events.Count - TimelineCap);
        for (var index = _events.Count - 1; index >= skip; index--)
        {
            yield return _events[index];
        }
    }

    private string SessionLabel(string sessionId) =>
        _sessionsById.TryGetValue(sessionId, out var session)
            ? $"{session.AgentName} ({sessionId})"
            : sessionId;

    private IEnumerable<PlanRevision> PlanHistory()
    {
        for (var index = _insights.PlanRevisions.Count - 2; index >= 0; index--)
        {
            yield return _insights.PlanRevisions[index];
        }
    }

    /// <summary>
    /// One deterministic verification row, shared by the baseline, project-check, intermediate,
    /// and superseded lists. Every value comes from the persisted run; no timeout budget is shown
    /// because no persisted row carries one.
    /// </summary>
    private RenderFragment<VerificationRow> RunRow => row =>
        @<li class="run @RunClass(row)">
            <span class="run-command mono">@row.Run.CommandId</span>
            <span class="badge-row">
                <FluentBadge Appearance="@(row.Run.Status == VerificationRunStatus.Passed ? Appearance.Accent : Appearance.Neutral)">
                    @row.Run.Status
                </FluentBadge>
                <FluentBadge Appearance="Appearance.Neutral">
                    @(row.Run.Mandatory ? "mandatory" : "optional")
                </FluentBadge>
                @if (row.IsWarning)
                {
                    <FluentBadge Appearance="Appearance.Neutral">warning &middot; does not block</FluentBadge>
                }
                @if (row.Run.RunKind == VerificationRunKind.Intermediate)
                {
                    <FluentBadge Appearance="Appearance.Neutral">intermediate</FluentBadge>
                }
                else if (!row.IsCurrent)
                {
                    <FluentBadge Appearance="Appearance.Neutral">superseded</FluentBadge>
                }
            </span>
            <span class="run-facts">
                @row.Run.ProfileId &middot; exit @(row.Run.ExitCode?.ToString() ?? "n/a") &middot;
                @RunTiming(row) &middot; @row.Run.StartedAt.ToString("u")
                @if (!row.IsCurrent)
                {
                    <text>&middot; fingerprint @Short(row.Run.Fingerprint) &middot; policy @Short(row.Run.PolicyRevision)</text>
                }
            </span>
            @if (row.Run.OutputSummary is { Length: > 0 } summary)
            {
                <pre class="event-payload">@summary</pre>
            }
            @if (row.Run.OutputArtifactPath is { Length: > 0 } artifact)
            {
                <span class="event-origin">artifact @artifact</span>
            }
        </li>;

    /// <summary>
    /// Row accent: green for a pass, red only for a mandatory failure of the current fingerprint,
    /// amber for an optional failure or a still-running command, and muted for retained history.
    /// </summary>
    private static string RunClass(VerificationRow row)
    {
        if (row.IsRunning)
        {
            return "is-running";
        }

        if (row.IsBlocking)
        {
            return "is-failed";
        }

        if (row.IsWarning)
        {
            return "is-warning";
        }

        if (!row.IsCurrent)
        {
            return "is-history";
        }

        return row.Run.Status == VerificationRunStatus.Passed ? "is-passed" : string.Empty;
    }

    private static string ReviewClass(AgentSessionDto session) => session.WorkState switch
    {
        AgentWorkState.Completed => "is-passed",
        AgentWorkState.Failed or AgentWorkState.Blocked => "is-failed",
        AgentWorkState.Cancelled => "is-history",
        _ => "is-running",
    };

    /// <summary>
    /// How long the command took, or how long it has been running against this snapshot.
    /// Timeout budget is printed only from a bounded command-progress event.
    /// </summary>
    private string RunTiming(VerificationRow row)
    {
        if (row.Run.CompletedAt is { } completed)
        {
            return $"{(completed - row.Run.StartedAt).TotalSeconds:0.0}s";
        }

        if (!row.IsRunning)
        {
            return "no completion recorded";
        }

        var elapsed = FormatElapsed(_snapshot - row.Run.StartedAt);
        if (_verification.Admitted?.Command is { } command
            && string.Equals(command.CommandId, row.Run.CommandId, StringComparison.Ordinal))
        {
            return $"{elapsed} of {command.TimeoutSeconds}s budget";
        }

        return elapsed;
    }

    private string CommandElapsed(AdmittedCommandProgress command) =>
        FormatElapsed(_snapshot - command.StartedAt);

    private static string FormatElapsed(TimeSpan elapsed)
    {
        if (elapsed < TimeSpan.Zero)
        {
            elapsed = TimeSpan.Zero;
        }

        return elapsed.TotalSeconds < 120
            ? $"running for {elapsed.TotalSeconds:0.0}s"
            : $"running for {(int)elapsed.TotalMinutes}m {elapsed.Seconds:00}s";
    }

    /// <summary>First bytes of an opaque fingerprint or revision, enough to tell two apart.</summary>
    private static string Short(string value) =>
        value.Length <= 16 ? value : string.Concat(value.AsSpan(0, 16), "\u2026");
    /// <summary>
    /// Which trusted profile this request is bound to. Assigned work reads the immutable
    /// assignment snapshot; completed work names the recorded run; only an unassigned request
    /// reads the live Project selection.
    /// </summary>
    private string ProjectChecksMeta()
    {
        var request = _request;
        var isAssigned = request?.Assignment is not null;
        var isTerminal = request is not null && IsRequestTerminal(request);
        return RequestVerificationPolicyCopy.ProjectChecksMeta(
            request?.Assignment,
            _project?.TrustedVerificationProfileId,
            _project?.TrustedVerificationProfileRevision,
            _verification.ProjectChecks,
            isAssigned,
            isTerminal);
    }

    private static bool IsRequestTerminal(WorkRequestDto request) =>
        request.Status is (int)WorkRequestStatus.Completed
            or (int)WorkRequestStatus.Failed
            or (int)WorkRequestStatus.Cancelled;

    private string AdmittedElapsed(AdmittedFinalVerification admitted)
    {
        var elapsed = _snapshot - admitted.StartedAt;
        if (elapsed < TimeSpan.Zero)
        {
            elapsed = TimeSpan.Zero;
        }

        return elapsed.TotalSeconds < 120
            ? $"{elapsed.TotalSeconds:0.0}s"
            : $"{(int)elapsed.TotalMinutes}m {elapsed.Seconds:00}s";
    }

    /// <summary>
    /// The section header sentence: what the current fingerprint proves, what is still running,
    /// and how much of what is on screen is retained history rather than a current result.
    /// </summary>
    private string VerificationSummary()
    {
        if (_verificationError is not null)
        {
            return "verification store unavailable";
        }

        var parts = new List<string>(6);
        if (_verification.IsAdmittedInProgress && _verification.Admitted is { } admitted)
        {
            if (admitted.Command is { } command)
            {
                parts.Add(
                    $"running {command.CommandId} · {CommandElapsed(command)} of {command.TimeoutSeconds}s budget");
            }
            else
            {
                parts.Add($"admitted final verification running for {AdmittedElapsed(admitted)}");
            }
        }

        if (_verification.Running is { } running && _verification.Admitted?.Command is null)
        {
            parts.Add($"running {running.Run.CommandId} \u00b7 {RunTiming(running)}");
        }
        else if (!_verification.IsAdmittedInProgress)
        {
            var current = _verification.Baseline.Count + _verification.ProjectChecks.Count;
            parts.Add(current == 0
                ? "no check recorded for the current repository state"
                : $"{current} check{(current == 1 ? string.Empty : "s")} for the current fingerprint");
        }

        if (_verification.HasBlockingFailure)
        {
            parts.Add("a mandatory check is red");
        }

        if (_verification.WarningCount > 0)
        {
            parts.Add($"{_verification.WarningCount} warning{(_verification.WarningCount == 1 ? string.Empty : "s")}");
        }

        if (_verification.Intermediate.Count > 0)
        {
            parts.Add($"{_verification.Intermediate.Count} intermediate");
        }

        if (_verification.History.Count > 0)
        {
            parts.Add($"{_verification.History.Count} superseded");
        }

        parts.Add($"refreshed {TimeText.Relative(_snapshot, Clock.UtcNow)}");
        return string.Join(" \u00b7 ", parts);
    }

    /// <summary>
    /// Says which of the two placement facts exist, so the section header is honest before the
    /// operator reads the cards: a queued request has a scheduling decision and no assignment.
    /// </summary>
    private string PlacementSummary(WorkRequestDto request)
    {
        if (request.Assignment is { } assignment)
        {
            return IsAssignmentTerminal(assignment.State)
                ? $"assignment {assignment.State} \u00b7 retained placement history \u00b7 "
                    + $"refreshed {TimeText.Relative(_snapshot, Clock.UtcNow)}"
                : $"assignment {assignment.State} \u00b7 occupies project and node capacity \u00b7 "
                    + $"refreshed {TimeText.Relative(_snapshot, Clock.UtcNow)}";
        }

        return request.SchedulingStatus is { } scheduling
            ? $"not assigned \u00b7 {(scheduling.IsEligible ? "eligible for assignment" : "not eligible")}"
                + $" \u00b7 refreshed {TimeText.Relative(_snapshot, Clock.UtcNow)}"
            : $"no assignment \u00b7 request is {request.StatusName}";
    }

    /// <summary>
    /// Operator label for a server-issued scheduling code. The server owns precedence, detail, and
    /// action text; this only names the code it already chose.
    /// </summary>
    private static string SchedulingLabel(string code) => code switch
    {
        SchedulingReasonCodes.ProjectDisabled => "Project disabled",
        SchedulingReasonCodes.WorkspaceBindingMissing => "No workspace",
        SchedulingReasonCodes.WorkspaceValidationPending => "Validation pending",
        SchedulingReasonCodes.WorkspaceInvalid => "Workspace invalid",
        SchedulingReasonCodes.NodeOffline => "Node offline",
        SchedulingReasonCodes.RuntimeUnavailable => "Runtime unavailable",
        SchedulingReasonCodes.RuntimeUnknown => "Runtime unknown",
        SchedulingReasonCodes.NodeCapacityUnavailable => "At capacity",
        SchedulingReasonCodes.ProjectConcurrencyUnavailable => "Project at limit",
        SchedulingReasonCodes.Eligible => "Ready",
        _ => code,
    };

    private static bool IsAssignmentTerminal(ExecutionAssignmentState state) =>
        state is ExecutionAssignmentState.Completed
            or ExecutionAssignmentState.Failed
            or ExecutionAssignmentState.Cancelled;

    /// <summary>
    /// Lease expiry is liveness evidence only: it never releases ownership, so an expired lease is
    /// described rather than presented as a free slot.
    /// </summary>
    private string LeaseHint(ExecutionAssignmentProjectionDto assignment)
    {
        if (IsAssignmentTerminal(assignment.State))
        {
            return $"(recorded lease at terminal time; {Relative(assignment.LeaseExpiresAt, _snapshot)})";
        }

        return assignment.LeaseExpiresAt <= _snapshot
            ? $"(expired {TimeText.Deadline(assignment.LeaseExpiresAt, _snapshot)}; expiry never"
                + " releases ownership or frees capacity)"
            : $"({TimeText.Deadline(assignment.LeaseExpiresAt, _snapshot)})";
    }

    private string ProjectHref() =>
        _request is null ? "/" : $"/projects/{_request.ProjectId}";

    /// <summary>The recovery panel on this request's project, addressed by its own anchor.</summary>
    private string RecoveryHref() => $"{ProjectHref()}#project-recovery";

    /// <summary>
    /// One contextual entry into the project's recovery panel, derived from this request's own
    /// persisted facts.
    /// </summary>
    private readonly record struct RecoveryEntry(string Title, string Detail);

    /// <summary>
    /// Offers recovery only for the facts it answers: a retained assignment that is quiescing
    /// or has uncertain ownership, or a session that still owns a lease while disconnected.
    /// A queued request with a configuration or readiness blocker, and a blocked request
    /// waiting for input, keep their own specific fix instead.
    /// </summary>
    private static RecoveryEntry? ComputeRecoveryEntry(
        WorkRequestDto request,
        IReadOnlyList<AttentionSignal> attention)
    {
        if (request.Assignment is { } assignment)
        {
            switch (assignment.State)
            {
                case ExecutionAssignmentState.RecoveryRequired:
                    return new RecoveryEntry(
                        "Recovery is required for this assignment",
                        "Ownership of this request's execution is uncertain and no second writer is "
                            + "permitted, so it keeps project and node capacity until recovery "
                            + "resolves it. Recovery is project-scoped and runs from the project "
                            + "page; it preserves files, history, and this request's record.");
                case ExecutionAssignmentState.Cancelling:
                    return new RecoveryEntry(
                        "Cancellation has not released ownership",
                        "Cancellation was delivered to the assigned node, which has not yet proved "
                            + "quiescence. Project recovery adopts this assignment as a target "
                            + "instead of issuing a second cancellation.");
                case ExecutionAssignmentState.Finalizing:
                    return new RecoveryEntry(
                        "Finalization has not released ownership",
                        "Completion was accepted, but the writer slot and reservations stay held "
                            + "while the assigned node quiesces. Project recovery confirms that "
                            + "accepted intent with its own evidence rather than discarding it.");
            }
        }

        foreach (var signal in attention)
        {
            if (signal.Kind == AttentionKind.DisconnectedWithLease)
            {
                return new RecoveryEntry(
                    "A disconnected owner still holds this request's leases",
                    "The owning session is disconnected or exited while its lease group is still "
                        + "held. Silence is not proof that it stopped writing, so ownership is "
                        + "resolved through project recovery, never by unlocking the workspace.");
            }
        }

        return null;
    }

    private static bool HasPayload(string payloadJson) =>
        !string.IsNullOrWhiteSpace(payloadJson) && payloadJson is not "{}" and not "null";

    private static string Payload(string payloadJson) =>
        payloadJson.Length <= PayloadCap
            ? payloadJson
            : string.Concat(payloadJson.AsSpan(0, PayloadCap), "\u2026 (truncated)");

    private static bool IsWorking(AgentActivity activity) => activity != AgentActivity.Idle;

    private static bool IsTerminal(AgentWorkState state) =>
        state is AgentWorkState.Completed or AgentWorkState.Failed or AgentWorkState.Cancelled;

    private static bool IsFailed(AgentWorkState state) =>
        state is AgentWorkState.Failed or AgentWorkState.Cancelled or AgentWorkState.Blocked;

    private string PrimaryThreadId() => RequestId.ToString();

    private static string GuidanceSubjectSeed(WorkRequestDto request) =>
        $"[{request.Title}] Human guidance";

    private string MessageSummary()
    {
        if (_mailError is not null)
        {
            return "mail projection unavailable";
        }

        return $"{_messageCount} message{(_messageCount == 1 ? string.Empty : "s")} in "
            + $"{_threads.Count} thread{(_threads.Count == 1 ? string.Empty : "s")} \u00b7 "
            + $"{_unreadMessageCount} unread \u00b7 refreshed {TimeText.Relative(_snapshot, Clock.UtcNow)}";
    }

    private string ReservationSummary()
    {
        if (_reservationError is not null)
        {
            return "reservation authority unavailable";
        }

        return $"{_leases.Count} lease group{(_leases.Count == 1 ? string.Empty : "s")} \u00b7 "
            + $"{_recoveryLeaseCount} awaiting recovery \u00b7 "
            + $"refreshed {TimeText.Relative(_snapshot, Clock.UtcNow)}";
    }

    private static bool IsReservationWarning(string type) => type
        is "reservation.denied"
        or "reservation.expired"
        or "reservation.recovery_required"
        or "reservation.force_released"
        or "reservation.handoff_requested";

    /// <summary>One mail thread of this request as rendered by <c>MessageThreadView</c>.</summary>
    private sealed record MessageThread(
        string ThreadId,
        string Subject,
        bool IsPrimary,
        IReadOnlyList<AgentMessageDto> Messages);

    private static string RequirementText(string code) => code switch
    {
        CompletionRequirements.PlanEvent => "no plan event is persisted for this request",
        CompletionRequirements.ImplementationChild => "no implementation child agent completed",
        CompletionRequirements.IndependentReviewer => "no independent reviewer completed",
        CompletionRequirements.UnresolvedBlockingFinding => "a blocking review finding is unresolved",
        CompletionRequirements.MandatoryVerification => "a mandatory verification command is not green",
        CompletionRequirements.ActiveMutation => "a mutation is still in flight",
        CompletionRequirements.ActiveReservation => "an active reservation is still held",
        CompletionRequirements.DiffCaptured => "no repository diff was captured",
        CompletionRequirements.OwnershipKnown => "a changed file has no known owner",
        CompletionRequirements.ResultSummary => "the result summary is blank",
        _ => "reported by the completion gate",
    };

    /// <summary>
    /// The one sentence the stable polite region announces: semantic state only. Phase or terminal
    /// status, plus whatever an agent reports it is doing or, failing that, the newest narrated
    /// durable fact. Elapsed time, relative ages, and event or tool counts are deliberately absent
    /// — they move on every safety re-read and on low-level chatter, which would make the live
    /// region speak without the request having actually progressed. Those values stay visible in
    /// the metric list beside it.
    /// </summary>
    private static string ProgressAnnouncement(RequestExecutionProgress progress)
    {
        var detail = ReportedOperation(progress) ?? NewestFact(progress);

        if (progress.IsTerminal)
        {
            return detail is null
                ? progress.Status
                : $"{progress.Status} \u00b7 {detail}";
        }

        return detail is null
            ? $"{progress.Phase} \u00b7 no agent operation reported"
            : $"{progress.Phase} \u00b7 {detail}";
    }

    /// <summary>
    /// What the assertive region says, and only for a request the control plane recorded as
    /// failed: completion and cancellation are announced politely like any other state change.
    /// Empty for every other state, because the region itself is always rendered.
    /// </summary>
    private string FailureAnnouncement(RequestExecutionProgress progress)
    {
        if (!progress.IsTerminal
            || _request is not { } request
            || (WorkRequestStatus)request.Status != WorkRequestStatus.Failed)
        {
            return string.Empty;
        }

        var reason = _root is { StatusReason: { } stated } && !string.IsNullOrWhiteSpace(stated)
            ? stated
            : NewestFact(progress);

        return reason is null
            ? $"Request {request.StatusName} \u00b7 no reason persisted"
            : $"Request {request.StatusName} \u00b7 {reason}";
    }

    /// <summary>The first operation a still-running session reports, or its status reason.</summary>
    private static string? ReportedOperation(RequestExecutionProgress progress)
    {
        foreach (var operation in progress.Operations)
        {
            var reported = operation.Operation ?? operation.StatusReason;
            if (!string.IsNullOrWhiteSpace(reported))
            {
                return reported;
            }
        }

        return null;
    }

    /// <summary>The newest narrated durable fact; facts are reduced newest first.</summary>
    private static string? NewestFact(RequestExecutionProgress progress) =>
        progress.Facts.Count > 0 ? progress.Facts[0].Label : null;

    private static string Relative(DateTimeOffset instant, DateTimeOffset now) =>
        TimeText.Relative(instant, now);
}
