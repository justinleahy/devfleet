@page "/"
@namespace PiCommandCenter.Web.Components.Pages
@rendermode InteractiveServer
@using PiCommandCenter.Application
@using PiCommandCenter.Application.Nodes
@using PiCommandCenter.Application.Projects
@using PiCommandCenter.Application.Requests
@using PiCommandCenter.Application.Sessions
@using PiCommandCenter.Domain
@using PiCommandCenter.Domain.Nodes
@using PiCommandCenter.Domain.Requests
@using PiCommandCenter.Domain.Sessions
@using PiCommandCenter.Application.Live
@using PiCommandCenter.Web.Components.Live
@implements IAsyncDisposable
@inject IProjectCatalog Catalog
@inject IRequestQueue Queue
@inject INodeRegistry NodeRegistry
@inject IAgentSessionStore SessionStore
@inject IClock Clock
@inject IToastService ToastService
@inject IProjectionNotifier Notifier

<PageTitle>Fleet &middot; DevFleet</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="24" Width="100%">

    <header class="page-head">
        <FluentStack Class="page-head-row"
                     Orientation="Orientation.Horizontal"
                     VerticalAlignment="VerticalAlignment.Bottom"
                     HorizontalGap="16"
                     Width="100%">
            <FluentStack Class="page-head-copy" Orientation="Orientation.Vertical" VerticalGap="4" Width="auto">
                <h1>Fleet dashboard</h1>
                <p class="page-lead">
                    Registered projects and their queued work, read straight from the control-plane
                    database as each write commits. Snapshot @_snapshot.ToString("u").
                </p>
            </FluentStack>
            <FluentSpacer />
            <FluentButton Class="page-head-action" Appearance="Appearance.Accent" OnClick="OpenRegistration">
                Register project
            </FluentButton>
        </FluentStack>
    </header>

    <section class="metrics" aria-label="Fleet summary">
        <dl class="metric-row">
            <div class="metric">
                <dt>Active projects</dt>
                <dd>@_activeProjects</dd>
            </div>
            <div class="metric">
                <dt>Active agents</dt>
                <dd>@_activeSessions</dd>
                <p class="metric-note">@SessionCountNote()</p>
            </div>
            <div class="metric">
                <dt>Queued requests</dt>
                <dd>@_queuedRequests</dd>
            </div>
            <div class="metric">
                <dt>Needs attention</dt>
                <dd><a href="/attention">@_attentionSessions</a></dd>
                <p class="metric-note">
                    @AttentionNote()
                    <a class="metric-link" href="/attention">Open the attention queue</a>
                </p>
            </div>
        </dl>
    </section>

    <section aria-labelledby="nodes-heading">
        <h2 id="nodes-heading">Nodes</h2>
        <p class="panel-lead">@NodeCountNote()</p>

        @if (_nodeError is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Error"
                              Title="Could not load nodes"
                              AllowDismiss="false">
                @_nodeError
            </FluentMessageBar>
        }
        else if (_loading)
        {
            <div class="state-block" role="status">
                <FluentProgressRing aria-label="Loading nodes" />
                <span>Loading nodes</span>
            </div>
        }
        else if (_nodes.Count == 0)
        {
            <p class="panel-empty">
                No node has registered yet. Start a node agent against this control plane; it appears
                here after its first registration.
            </p>
        }
        else
        {
            <ul class="node-list">
                @foreach (var node in _nodes)
                {
                    <li class="node-row">
                        <div class="node-head">
                            <span class="node-name">@node.DisplayName</span>
                            <FluentBadge Appearance="@BadgeAppearance(node.Status)">@node.Status.ToString()</FluentBadge>
                            <span class="node-version">agent @node.AgentVersion</span>
                            <span class="node-seen">
                                <span class="visually-hidden">Last heartbeat</span>
                                @Relative(node.LastHeartbeatAt, _snapshot)
                                <span class="node-seen-utc">@node.LastHeartbeatAt.ToString("u")</span>
                            </span>
                        </div>

                        @if (node.Resources is { } resources)
                        {
                            <dl class="node-metrics">
                                @foreach (var meter in Meters(resources))
                                {
                                    <div class="node-metric">
                                        <dt>@meter.Label</dt>
                                        <dd>
                                            @if (meter.Percent is { } percent)
                                            {
                                                <span class="node-metric-value">@Percent(percent)</span>
                                                <span class="node-meter @MeterLevel(percent)" aria-hidden="true">
                                                    <span class="node-meter-fill" style="width:@(Fill(percent))%"></span>
                                                </span>
                                                @if (meter.Detail is { } detail)
                                                {
                                                    <span class="node-metric-detail">@detail</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="node-metric-none">Unavailable</span>
                                            }
                                        </dd>
                                    </div>
                                }
                                <div class="node-metric">
                                    <dt>Load, 1 minute</dt>
                                    <dd>
                                        @if (Finite(resources.LoadAverageOneMinute) is { } load)
                                        {
                                            <span class="node-metric-value">@load.ToString("0.00")</span>
                                        }
                                        else
                                        {
                                            <span class="node-metric-none">Unavailable</span>
                                        }
                                    </dd>
                                </div>
                                <div class="node-metric">
                                    <dt>Uptime</dt>
                                    <dd>
                                        @if (Finite(resources.UptimeSeconds) is { } uptime)
                                        {
                                            <span class="node-metric-value">@Uptime(uptime)</span>
                                        }
                                        else
                                        {
                                            <span class="node-metric-none">Unavailable</span>
                                        }
                                    </dd>
                                </div>
                            </dl>
                        }
                        else
                        {
                            <p class="node-resources-none">
                                System metrics unavailable &mdash; this node's last heartbeat carried no
                                resource sample.
                            </p>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section aria-labelledby="projects-heading">
        <FluentStack Orientation="Orientation.Horizontal"
                     VerticalAlignment="VerticalAlignment.Center"
                     HorizontalGap="12"
                     Width="100%">
            <h2 id="projects-heading">Projects</h2>
            <FluentSpacer />
            <FluentButton Appearance="Appearance.Stealth" OnClick="ReloadAsync" Disabled="@_loading">
                Reload
            </FluentButton>
        </FluentStack>

        @if (_loadError is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Error"
                              Title="Could not load projects"
                              AllowDismiss="false">
                @_loadError
            </FluentMessageBar>
        }
        else if (_loading)
        {
            <div class="state-block" role="status">
                <FluentProgressRing aria-label="Loading projects" />
                <span>Loading projects</span>
            </div>
        }
        else if (_projects.Count == 0)
        {
            <FluentCard Class="empty-card">
                <div class="state-empty">
                    <h3>No projects registered</h3>
                    <p>
                        Register a local Git repository to give the fleet somewhere to work. The path
                        must exist on this machine and contain a repository.
                    </p>
                    <FluentButton Appearance="Appearance.Accent" OnClick="OpenRegistration">
                        Register project
                    </FluentButton>
                </div>
            </FluentCard>
        }
        else
        {
            <FluentGrid Spacing="3" Justify="JustifyContent.FlexStart" Width="100%">
                @foreach (var project in _projects)
                {
                    <FluentGridItem xs="12" md="6" xl="4">
                        <FluentCard Height="100%">
                            <article class="project-card">
                                <FluentStack Orientation="Orientation.Horizontal"
                                             VerticalAlignment="VerticalAlignment.Center"
                                             HorizontalGap="8">
                                    <h3>
                                        <a href="@($"/projects/{project.Id}")">@project.DisplayName</a>
                                    </h3>
                                    <FluentSpacer />
                                    <FluentBadge Appearance="@(project.Enabled ? Appearance.Accent : Appearance.Neutral)">
                                        @(project.Enabled ? "Enabled" : "Disabled")
                                    </FluentBadge>
                                </FluentStack>

                                <p class="project-summary">@Summarize(project.Id)</p>

                                <dl class="facts">
                                    <dt>Repository path</dt>
                                    <dd class="path">@project.RepositoryPath</dd>
                                    <dt>Default branch</dt>
                                    <dd>@project.DefaultBranch</dd>
                                    <dt>Node</dt>
                                    <dd>
                                        @{
                                            var node = FindNode(project.NodeId);
                                        }
                                        @if (node is null)
                                        {
                                            <span class="node-missing">Not registered</span>
                                            <span class="path node-id">@project.NodeId</span>
                                        }
                                        else
                                        {
                                            <span class="node-inline">
                                                <span class="node-name">@node.DisplayName</span>
                                                <FluentBadge Appearance="@BadgeAppearance(node.Status)">@node.Status.ToString()</FluentBadge>
                                                <span class="node-seen">
                                                    <span class="visually-hidden">Last heartbeat</span>
                                                    @Relative(node.LastHeartbeatAt, _snapshot)
                                                </span>
                                            </span>
                                        }
                                    </dd>
                                </dl>

                                <FluentStack Class="card-action" Orientation="Orientation.Horizontal" HorizontalGap="8" Width="auto">
                                    <FluentAnchor Href="@($"/projects/{project.Id}")" Appearance="Appearance.Outline">
                                        Open project
                                    </FluentAnchor>
                                </FluentStack>
                            </article>
                        </FluentCard>
                    </FluentGridItem>
                }
            </FluentGrid>
        }
    </section>
</FluentStack>

<div class="dialog-host">
    <FluentDialog @bind-Hidden="_registrationHidden"
                  Modal="true"
                  TrapFocus="true"
                  PreventScroll="true"
                  Class="register-dialog"
                  AriaLabelledby="register-heading">
        <div class="dialog-shell">
            <header class="dialog-header">
                <h2 id="register-heading">Register project</h2>
                <p class="dialog-lead">
                    The repository path is validated on this node before anything is written. Registration
                    binds the project to this control plane's node identity.
                </p>
            </header>

            <div class="dialog-body">
                @if (_registrationErrors.Count > 0)
                {
                    <FluentMessageBar Intent="MessageIntent.Error"
                                      Title="Registration failed"
                                      AllowDismiss="false">
                        @if (_registrationErrors.Count == 1)
                        {
                            @_registrationErrors[0]
                        }
                        else
                        {
                            <ul class="error-list">
                                @foreach (var error in _registrationErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        }
                    </FluentMessageBar>
                }

                @if (_validationPassed)
                {
                    <FluentMessageBar Intent="MessageIntent.Success"
                                      Title="Validation passed"
                                      AllowDismiss="false">
                        The repository path and branch satisfy every registration rule.
                    </FluentMessageBar>
                }

                <section class="form-section" aria-labelledby="register-identity-heading">
                    <h3 class="form-section-title" id="register-identity-heading">Repository</h3>
                    <div class="form-grid">
                        <FluentTextField @bind-Value="_form.DisplayName"
                                         Label="Display name"
                                         Required="true"
                                         Placeholder="Agent Command Center"
                                         Class="field" />
                        <FluentTextField @bind-Value="_form.DefaultBranch"
                                         Label="Default branch"
                                         Required="true"
                                         Placeholder="main"
                                         Class="field" />
                        <FluentTextField @bind-Value="_form.RepositoryPath"
                                         Label="Repository path"
                                         Required="true"
                                         Placeholder="/home/user/Developer/project"
                                         Class="field field-wide" />
                    </div>
                </section>

                <section class="form-section" aria-labelledby="register-limits-heading">
                    <h3 class="form-section-title" id="register-limits-heading">Concurrency limits</h3>
                    <div class="form-grid form-grid-compact">
                        <FluentNumberField @bind-Value="_form.MaxActiveWriteRequests"
                                           Label="Write slots"
                                           Min="0"
                                           Max="512"
                                           Class="field" />
                        <FluentNumberField @bind-Value="_form.MaxReadOnlyRequests"
                                           Label="Read-only slots"
                                           Min="0"
                                           Max="512"
                                           Class="field" />
                        <FluentNumberField @bind-Value="_form.MaxChildAgentsPerRequest"
                                           Label="Child agents per request"
                                           Min="0"
                                           Max="512"
                                           Class="field" />
                    </div>
                </section>

                <fieldset class="switch-set">
                    <legend>Repository policy</legend>
                    <div class="switch-grid">
                        <FluentSwitch @bind-Value="_form.Enabled" Label="Enabled" />
                        <FluentSwitch @bind-Value="_form.RequireCleanStart" Label="Require clean start" />
                        <FluentSwitch @bind-Value="_form.CreateRequestBranch" Label="Create request branch" />
                        <FluentSwitch @bind-Value="_form.CreateRequestCommit" Label="Create request commit" />
                        <FluentSwitch @bind-Value="_form.AutoMerge" Label="Auto merge" />
                    </div>
                </fieldset>
            </div>

            <footer class="dialog-actions">
                <FluentButton Appearance="Appearance.Accent" OnClick="RegisterAsync" Loading="@_submitting">
                    Register project
                </FluentButton>
                <FluentButton Appearance="Appearance.Outline" OnClick="ValidateAsync" Disabled="@_submitting">
                    Validate path
                </FluentButton>
                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseRegistration" Disabled="@_submitting" Class="action-cancel">
                    Cancel
                </FluentButton>
            </footer>
        </div>
    </FluentDialog>
</div>

@code {
    private readonly RegistrationForm _form = new();
    private readonly Dictionary<Guid, QueueCounts> _counts = [];
    private readonly Dictionary<Guid, NodeDto> _nodesById = [];

    private IReadOnlyList<ProjectDto> _projects = Array.Empty<ProjectDto>();
    private IReadOnlyList<NodeDto> _nodes = Array.Empty<NodeDto>();
    private IReadOnlyList<string> _registrationErrors = Array.Empty<string>();
    private DateTimeOffset _snapshot;
    private string? _loadError;
    private string? _nodeError;
    private string? _sessionError;
    private bool _loading = true;
    private bool _submitting;
    private bool _validationPassed;
    private bool _registrationHidden = true;
    private int _activeProjects;
    private int _queuedRequests;
    private int _onlineNodes;
    private int _activeSessions;
    private int _attentionSessions;
    private int _trackedSessions;

    private LiveView? _live;
    private bool _busy;

    protected override Task OnInitializedAsync() => ReloadAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _live is null)
        {
            // Fleet counters move on any committed write; LiveView collapses bursts and still
            // re-reads on its safety interval.
            _live = new LiveView(
                Notifier,
                change => change.AffectsFleet,
                () => InvokeAsync(async () =>
                {
                    await ReloadAsync(showSpinner: false);
                    StateHasChanged();
                }));
        }
    }

    public async ValueTask DisposeAsync()
    {
        var live = _live;
        _live = null;
        if (live is not null)
        {
            await live.DisposeAsync();
        }
    }

    private Task ReloadAsync() => ReloadAsync(showSpinner: true);

    private async Task ReloadAsync(bool showSpinner)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _loadError = null;
        if (showSpinner)
        {
            _loading = true;
            StateHasChanged();
        }

        await LoadNodesAsync();

        try
        {
            var projects = await Catalog.ListAsync(CancellationToken.None);
            _counts.Clear();

            var queued = 0;
            var agents = 0;
            var attention = 0;
            var tracked = 0;
            _sessionError = null;
            foreach (var project in projects)
            {
                var requests = await Queue.ListAsync(new ProjectId(project.Id), CancellationToken.None);
                var counts = await TallyAsync(requests);
                _counts[project.Id] = counts;
                queued += counts.Queued;
                agents += counts.Agents;
                attention += counts.Attention;
                tracked += counts.TrackedSessions;
            }

            _projects = projects;
            _activeProjects = projects.Count(p => p.Enabled);
            _queuedRequests = queued;
            _activeSessions = agents;
            _attentionSessions = attention;
            _trackedSessions = tracked;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _projects = Array.Empty<ProjectDto>();
            _counts.Clear();
            _activeProjects = 0;
            _queuedRequests = 0;
            _activeSessions = 0;
            _attentionSessions = 0;
            _trackedSessions = 0;
        }
        finally
        {
            _snapshot = Clock.UtcNow;
            _loading = false;
            _busy = false;
        }
    }

    private async Task LoadNodesAsync()
    {
        _nodeError = null;
        try
        {
            var nodes = await NodeRegistry.ListAsync(CancellationToken.None);

            _nodesById.Clear();
            var online = 0;
            foreach (var node in nodes)
            {
                _nodesById[node.Id] = node;
                if (node.Status == NodeStatus.Online)
                {
                    online++;
                }
            }

            _nodes = nodes;
            _onlineNodes = online;
        }
        catch (Exception ex)
        {
            _nodeError = ex.Message;
            _nodes = Array.Empty<NodeDto>();
            _nodesById.Clear();
            _onlineNodes = 0;
        }
    }

    private NodeDto? FindNode(Guid nodeId) =>
        _nodesById.TryGetValue(nodeId, out var node) ? node : null;

    private string NodeCountNote()
    {
        if (_nodeError is not null)
        {
            return "Node registry unavailable.";
        }

        return _nodes.Count switch
        {
            0 => "No node has registered.",
            1 => "of 1 known node",
            _ => $"of {_nodes.Count} known nodes",
        };
    }

    private string SessionCountNote()
    {
        if (_sessionError is not null)
        {
            return "Session projection unavailable.";
        }

        return _trackedSessions switch
        {
            0 => "No agent session has registered.",
            1 => "of 1 tracked session",
            _ => $"of {_trackedSessions} tracked sessions",
        };
    }

    private string AttentionNote()
    {
        if (_sessionError is not null)
        {
            return "Session projection unavailable.";
        }

        return _attentionSessions == 0
            ? "No agent reports input, approval, conflict, or error."
            : "Agent sessions are reporting an attention signal.";
    }

    private static Appearance BadgeAppearance(NodeStatus status) =>
        status == NodeStatus.Online ? Appearance.Accent : Appearance.Neutral;

    private static string Relative(DateTimeOffset instant, DateTimeOffset now)
    {
        var delta = now - instant;
        if (delta < TimeSpan.Zero)
        {
            delta = TimeSpan.Zero;
        }

        if (delta.TotalSeconds < 60)
        {
            return $"{(int)delta.TotalSeconds}s ago";
        }

        if (delta.TotalMinutes < 60)
        {
            return $"{(int)delta.TotalMinutes}m ago";
        }

        if (delta.TotalHours < 24)
        {
            return $"{(int)delta.TotalHours}h ago";
        }

        return $"{(int)delta.TotalDays}d ago";
    }

    // Latest-snapshot telemetry: every field is independently nullable, so each one is
    // formatted only when the node actually reported it. A missing value reads as
    // "Unavailable" rather than a zero that looks like a measurement.
    private static IReadOnlyList<MeterView> Meters(NodeResourceSnapshotDto resources) =>
    [
        new("CPU", Finite(resources.CpuUsagePercent), null),
        new(
            "Memory",
            Utilization(resources.MemoryUsedBytes, resources.MemoryTotalBytes),
            BytePair(resources.MemoryUsedBytes, resources.MemoryTotalBytes)),
        new(
            "Disk",
            Utilization(resources.DiskUsedBytes, resources.DiskTotalBytes),
            BytePair(resources.DiskUsedBytes, resources.DiskTotalBytes)),
    ];

    private static double? Finite(double? value) =>
        value is { } number && double.IsFinite(number) ? number : null;

    private static double? Utilization(long? used, long? total) =>
        used is { } bytes && total is { } capacity && capacity > 0
            ? Math.Clamp(bytes / (double)capacity * 100d, 0d, 100d)
            : null;

    private static string? BytePair(long? used, long? total) =>
        used is { } bytes && total is { } capacity && capacity > 0
            ? $"{Bytes(bytes)} of {Bytes(capacity)}"
            : null;

    private static string Percent(double value) => $"{Math.Clamp(value, 0d, 100d).ToString("0.0")}%";

    // Integer width keeps the inline style culture-proof; a decimal separator would
    // depend on the request culture and could emit an invalid length.
    private static int Fill(double value) => (int)Math.Round(Math.Clamp(value, 0d, 100d));

    private static string MeterLevel(double percent) => percent switch
    {
        >= 90d => "is-critical",
        >= 75d => "is-high",
        _ => "is-normal",
    };

    private static readonly string[] ByteUnits = ["KiB", "MiB", "GiB", "TiB", "PiB"];

    private static string Bytes(long value)
    {
        if (value < 1024L)
        {
            return $"{value} B";
        }

        var scaled = value / 1024d;
        var unit = 0;
        while (scaled >= 1024d && unit < ByteUnits.Length - 1)
        {
            scaled /= 1024d;
            unit++;
        }

        return $"{scaled.ToString("0.0")} {ByteUnits[unit]}";
    }

    private static string Uptime(double seconds)
    {
        if (seconds < 60d)
        {
            return $"{(int)Math.Max(seconds, 0d)}s";
        }

        // A reported uptime beyond TimeSpan's range would throw during render, so the
        // value is capped rather than trusted.
        var span = TimeSpan.FromSeconds(Math.Min(seconds, TimeSpan.MaxValue.TotalSeconds - 1d));
        if (span.TotalHours < 1d)
        {
            return $"{span.Minutes}m";
        }

        if (span.TotalDays < 1d)
        {
            return $"{span.Hours}h {span.Minutes}m";
        }

        return $"{(int)span.TotalDays}d {span.Hours}h {span.Minutes}m";
    }

    private readonly record struct MeterView(string Label, double? Percent, string? Detail);

    private void OpenRegistration()
    {
        _registrationErrors = Array.Empty<string>();
        _validationPassed = false;
        _registrationHidden = false;
    }

    private void CloseRegistration() => _registrationHidden = true;

    private async Task ValidateAsync()
    {
        _validationPassed = false;
        _registrationErrors = Array.Empty<string>();

        var local = _form.LocalErrors();
        if (local.Count > 0)
        {
            _registrationErrors = local;
            return;
        }

        _submitting = true;
        try
        {
            var report = await Catalog.ValidateAsync(_form.ToCommand(), CancellationToken.None);
            if (report.IsValid)
            {
                _validationPassed = true;
            }
            else
            {
                _registrationErrors = report.Errors;
            }
        }
        catch (Exception ex)
        {
            _registrationErrors = new[] { ex.Message };
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task RegisterAsync()
    {
        _validationPassed = false;
        _registrationErrors = Array.Empty<string>();

        var local = _form.LocalErrors();
        if (local.Count > 0)
        {
            _registrationErrors = local;
            return;
        }

        _submitting = true;
        try
        {
            var project = await Catalog.RegisterAsync(_form.ToCommand(), CancellationToken.None);
            _registrationHidden = true;
            _form.Reset();
            ToastService.ShowSuccess($"Registered {project.DisplayName}");
            await ReloadAsync();
        }
        catch (ProjectValidationException ex)
        {
            _registrationErrors = ex.Errors;
        }
        catch (DuplicateProjectException)
        {
            _registrationErrors = new[] { "A project is already registered for that repository path." };
        }
        catch (Exception ex)
        {
            _registrationErrors = new[] { ex.Message };
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task<QueueCounts> TallyAsync(IReadOnlyList<WorkRequestDto> requests)
    {
        var active = 0;
        var blocked = 0;
        var queued = 0;
        var agents = 0;
        var attention = 0;
        var tracked = 0;

        foreach (var request in requests)
        {
            switch ((WorkRequestStatus)request.Status)
            {
                case WorkRequestStatus.Queued:
                    queued++;
                    break;
                case WorkRequestStatus.Blocked:
                    blocked++;
                    break;
                case WorkRequestStatus.Starting:
                case WorkRequestStatus.Planning:
                case WorkRequestStatus.Executing:
                case WorkRequestStatus.Reviewing:
                case WorkRequestStatus.Verifying:
                    active++;
                    break;
                default:
                    break;
            }

            foreach (var session in await ListSessionsAsync(request.Id))
            {
                tracked++;
                if (IsRunning(session))
                {
                    agents++;
                }

                if (session.Attention != AgentAttention.None)
                {
                    attention++;
                }
            }
        }

        return new QueueCounts(active, blocked, queued, agents, attention, tracked);
    }

    private async Task<IReadOnlyList<AgentSessionDto>> ListSessionsAsync(Guid requestId)
    {
        try
        {
            return await SessionStore.ListAsync(new WorkRequestId(requestId), CancellationToken.None);
        }
        catch (Exception ex)
        {
            _sessionError ??= ex.Message;
            return Array.Empty<AgentSessionDto>();
        }
    }

    private static bool IsRunning(AgentSessionDto session) =>
        session.EndedAt is null
        && session.Liveness != AgentLiveness.Exited
        && session.WorkState is not (AgentWorkState.Completed or AgentWorkState.Failed or AgentWorkState.Cancelled);

    private string Summarize(Guid projectId)
    {
        var counts = _counts.TryGetValue(projectId, out var value) ? value : default;
        return $"{counts.Active} active \u00b7 {counts.Blocked} blocked \u00b7 {counts.Queued} queued \u00b7 {counts.Agents} agents";
    }

    private readonly record struct QueueCounts(
        int Active,
        int Blocked,
        int Queued,
        int Agents,
        int Attention,
        int TrackedSessions);

    private sealed class RegistrationForm
    {
        public string? DisplayName { get; set; } = string.Empty;

        public string? RepositoryPath { get; set; } = string.Empty;

        public string? DefaultBranch { get; set; } = "main";

        public bool Enabled { get; set; } = true;

        public int MaxActiveWriteRequests { get; set; } = 1;

        public int MaxReadOnlyRequests { get; set; } = 2;

        public int MaxChildAgentsPerRequest { get; set; } = 4;

        public bool RequireCleanStart { get; set; } = true;

        public bool CreateRequestBranch { get; set; } = true;

        public bool CreateRequestCommit { get; set; } = true;

        public bool AutoMerge { get; set; }

        public IReadOnlyList<string> LocalErrors()
        {
            var errors = new List<string>(3);
            if (string.IsNullOrWhiteSpace(DisplayName))
            {
                errors.Add("Display name is required.");
            }

            if (string.IsNullOrWhiteSpace(RepositoryPath))
            {
                errors.Add("Repository path is required.");
            }

            if (string.IsNullOrWhiteSpace(DefaultBranch))
            {
                errors.Add("Default branch is required.");
            }

            return errors;
        }

        public RegisterProjectCommand ToCommand() => new(
            (DisplayName ?? string.Empty).Trim(),
            (RepositoryPath ?? string.Empty).Trim(),
            (DefaultBranch ?? string.Empty).Trim(),
            Enabled,
            MaxActiveWriteRequests,
            MaxReadOnlyRequests,
            MaxChildAgentsPerRequest,
            RequireCleanStart,
            CreateRequestBranch,
            CreateRequestCommit,
            AutoMerge);

        public void Reset()
        {
            DisplayName = string.Empty;
            RepositoryPath = string.Empty;
            DefaultBranch = "main";
            Enabled = true;
            MaxActiveWriteRequests = 1;
            MaxReadOnlyRequests = 2;
            MaxChildAgentsPerRequest = 4;
            RequireCleanStart = true;
            CreateRequestBranch = true;
            CreateRequestCommit = true;
            AutoMerge = false;
        }
    }
}
