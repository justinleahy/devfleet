@page "/projects/{ProjectId:guid}"
@namespace PiCommandCenter.Web.Components.Pages
@rendermode InteractiveServer
@using PiCommandCenter.Application
@using PiCommandCenter.Application.Nodes
@using PiCommandCenter.Application.Projects
@using PiCommandCenter.Application.Requests
@using PiCommandCenter.Application.Sessions
@using PiCommandCenter.Domain
@using PiCommandCenter.Domain.Nodes
@using PiCommandCenter.Domain.Projects
@using PiCommandCenter.Domain.Requests
@using PiCommandCenter.Domain.Sessions
@using PiCommandCenter.Application.Reservations
@using PiCommandCenter.Web.Components.Coordination
@using PiCommandCenter.Application.Live
@using PiCommandCenter.Web.Components.Live
@using PiCommandCenter.Contracts.NodeTransport
@using PiCommandCenter.Application.VerificationPolicy
@using PiCommandCenter.Web.Components.Recovery
@implements IAsyncDisposable
@inject IProjectCatalog Catalog
@inject IWorkspaceBindingCatalog Bindings
@inject IRequestQueue Queue
@inject INodeRegistry NodeRegistry
@inject IAgentSessionStore SessionStore
@inject IClock Clock
@inject IReservationService ReservationAuthority
@inject IToastService ToastService
@inject IProjectionNotifier Notifier
@inject INodeWorkspaceDirectoryGateway Directories
@inject IProjectVerificationPolicyService VerificationPolicy

<PageTitle>@(_project?.DisplayName ?? "Project") &middot; DevFleet</PageTitle>

@if (_loading)
{
    <div class="state-block" role="status">
        <FluentProgressRing aria-label="Loading project" />
        <span>Loading project</span>
    </div>
}
else if (_project is null)
{
    <div class="page">
        <header class="page-head">
            <a class="back-link" href="/">Back to fleet</a>
            <h1>Project not found</h1>
            <p class="page-lead">No project is registered with that id.</p>
        </header>
    </div>
}
else
{
    var project = _project;

    <div class="page">

        <header class="page-head">
            <a class="back-link" href="/">Back to fleet</a>
            <div class="head-bar">
                <div class="head-identity">
                    <h1>@project.DisplayName</h1>
                    <FluentBadge Appearance="@(project.Enabled ? Appearance.Accent : Appearance.Neutral)">
                        @(project.Enabled ? "Enabled" : "Disabled")
                    </FluentBadge>
                </div>
                <div class="head-actions">
                    <FluentAnchor Href="#project-recovery"
                                  Appearance="@(_recovery is null ? Appearance.Outline : Appearance.Accent)"
                                  Class="action">
                        Recover project
                    </FluentAnchor>
                    <FluentButton Appearance="Appearance.Stealth"
                                  OnClick="ReloadAsync"
                                  Disabled="@_submitting"
                                  Class="action">
                        Reload
                    </FluentButton>
                </div>
            </div>
            <p class="page-lead">
                Queue ordering is priority first, then creation time. Snapshot @_snapshot.ToString("u").
            </p>
        </header>

        @if (_loadError is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Error"
                              Title="Could not load requests"
                              AllowDismiss="false">
                @_loadError
            </FluentMessageBar>
        }

        @if (_recovery is { } recovery)
        {
            <FluentMessageBar Intent="MessageIntent.Warning"
                              Title="@recovery.Title"
                              AllowDismiss="false">
                @recovery.Detail
                <span class="recovery-actions">
                    <a class="recovery-link" href="#project-recovery">Open project recovery</a>
                    @if (recovery.RequestId is { } stuckRequestId)
                    {
                        <a class="recovery-link" href="@($"/requests/{stuckRequestId}")">
                            Open @recovery.RequestTitle
                        </a>
                    }
                </span>
            </FluentMessageBar>
        }

        <FluentCard>
            <section class="panel" aria-labelledby="metadata-heading">
                <h2 id="metadata-heading" class="visually-hidden">Project metadata</h2>
                <div class="split">
                    <section class="fact-group" aria-labelledby="workspace-facts-heading">
                        <h3 id="workspace-facts-heading" class="group-title">Workspace designation</h3>
                        <dl class="facts">
                            <dt>Default branch</dt>
                            <dd>@project.DefaultBranch</dd>
                            @if (project.Binding is { } binding)
                            {
                                <dt>Repository path</dt>
                                <dd class="path">
                                    @WorkspacePath(binding)
                                    @if (binding.CanonicalRepositoryPath is { } canonical
                                         && !string.Equals(canonical, binding.RepositoryPath, StringComparison.Ordinal))
                                    {
                                        <span class="node-seen">requested @binding.RepositoryPath</span>
                                    }
                                </dd>
                                <dt>Workspace state</dt>
                                <dd>
                                    <span class="node-inline">
                                        <FluentBadge Appearance="@BindingAppearance(binding.Status)">@binding.Status.ToString()</FluentBadge>
                                        <FluentBadge Appearance="Appearance.Neutral">revision @binding.ValidationRevision</FluentBadge>
                                        @if (binding.ValidationCode is { Length: > 0 } validationCode)
                                        {
                                            <FluentBadge Appearance="Appearance.Neutral">@validationCode</FluentBadge>
                                        }
                                    </span>
                                    @if (binding.ValidationDetail is { Length: > 0 } detail)
                                    {
                                        <span class="node-seen">@detail</span>
                                    }
                                    <span class="node-seen">
                                        @if (binding.ValidatedAt is { } validatedAt)
                                        {
                                            <span>validated @Relative(validatedAt, _snapshot)</span>
                                            <span class="node-seen-utc">@validatedAt.ToString("u")</span>
                                        }
                                        else
                                        {
                                            <span>no node-local result for this revision yet</span>
                                        }
                                    </span>
                                </dd>
                                <dt>Node</dt>
                                <dd>
                                    @if (_node is null)
                                    {
                                        <span class="node-missing">Not registered</span>
                                    }
                                    else
                                    {
                                        <span class="node-name">@_node.DisplayName</span>
                                        <span class="node-version">agent @_node.AgentVersion</span>
                                    }
                                    <span class="path node-id">@binding.NodeId</span>
                                </dd>
                                <dt>Node status</dt>
                                <dd>
                                    @if (_nodeError is not null)
                                    {
                                        <span class="node-missing">Node registry unavailable</span>
                                    }
                                    else if (_node is null)
                                    {
                                        <span class="node-missing">Not registered</span>
                                    }
                                    else
                                    {
                                        <span class="node-inline">
                                            <FluentBadge Appearance="@BadgeAppearance(_node.Status)">@_node.Status.ToString()</FluentBadge>
                                            <span class="node-seen">
                                                <span class="visually-hidden">Last heartbeat</span>
                                                @Relative(_node.LastHeartbeatAt, _snapshot)
                                                <span class="node-seen-utc">@_node.LastHeartbeatAt.ToString("u")</span>
                                            </span>
                                        </span>
                                    }
                                </dd>
                            }
                            else
                            {
                                <dt>Workspace</dt>
                                <dd>
                                    <span class="node-missing">Unbound</span>
                                    <span class="node-seen">
                                        No node-local workspace is designated, so no node can claim this
                                        project's work yet.
                                    </span>
                                </dd>
                            }
                        </dl>

                        @if (_bindingLock is not null)
                        {
                            <FluentMessageBar Intent="MessageIntent.Warning"
                                              Title="Designation is held by an assignment"
                                              AllowDismiss="false">
                                @_bindingLock
                            </FluentMessageBar>
                        }

                        @if (_bindingError is not null)
                        {
                            <FluentMessageBar Intent="MessageIntent.Error"
                                              Title="Workspace action failed"
                                              AllowDismiss="false">
                                @_bindingError
                            </FluentMessageBar>
                        }

                        @if (_bindingNotice is not null)
                        {
                            <div role="status">
                                <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">
                                    @_bindingNotice
                                </FluentMessageBar>
                            </div>
                        }

                        @if (_nodeError is not null)
                        {
                            <p class="panel-empty">
                                The node registry is unavailable, so no node can be selected:
                                @_nodeError
                            </p>
                        }
                        else if (_nodes.Count == 0)
                        {
                            <p class="panel-empty">
                                No node has registered with this control plane, so there is nothing to
                                designate yet. Start a node agent; queued work waits until a designated
                                workspace is validated on it.
                            </p>
                        }
                        else
                        {
                            <div class="form-grid">
                                <FluentSelect TOption="NodeDto"
                                              Label="Node"
                                              Items="@_nodes"
                                              OptionText="@(node => $"{node.DisplayName} \u00b7 {node.Status}")"
                                              OptionValue="@(node => node.Id.ToString())"
                                              @bind-Value="_bindingNodeId"
                                              @bind-Value:after="OnBindingNodeChanged"
                                              Disabled="@BindingWriteBlocked"
                                              Class="field" />
                            </div>

                            <div class="workspace-picker">
                                <span id="workspace-folder-label" class="picker-label">
                                    Workspace folder on that node
                                </span>
                                <p class="@PickerValueClass"
                                   role="status"
                                   aria-labelledby="workspace-folder-label">
                                    @(HasSelectedFolder ? _bindingPath : "No folder selected yet")
                                </p>
                                <FluentButton Appearance="Appearance.Outline"
                                              OnClick="OpenFolderPickerAsync"
                                              Disabled="@BindingWriteBlocked"
                                              Class="action picker-browse">
                                    @(HasSelectedFolder ? "Change folder" : "Browse folders")
                                </FluentButton>
                            </div>
                            <p class="panel-lead">
                                Folders are listed by the selected node from its own approved roots;
                                the control plane never reads them. Choosing a different folder starts
                                a new validation revision and discards the previous result.
                            </p>

                        }
                        @if (_nodeError is null && _nodes.Count > 0)
                        {
                            <div role="note">
                                <FluentMessageBar Intent="MessageIntent.Warning" AllowDismiss="false">
                                    <text>Designation consents to local Git changes made only when the workspace needs preparation. This directory is not a Git repository. DevFleet will initialize it and commit its existing non-ignored contents when the first request starts. Existing files are preserved.</text>
                                </FluentMessageBar>
                            </div>
                        }


                        <FluentStack HorizontalGap="8" VerticalGap="8" Wrap="true">
                            @if (_nodeError is null && _nodes.Count > 0)
                            {
                                <FluentButton Appearance="Appearance.Accent"
                                              OnClick="DesignateAsync"
                                              Loading="@_bindingBusy"
                                              Disabled="@BindingWriteBlocked"
                                              Class="action">
                                    @(project.Binding is null ? "Designate workspace" : "Update designation")
                                </FluentButton>
                            }
                            @if (project.Binding is { } designated)
                            {
                                <FluentButton Appearance="Appearance.Outline"
                                              OnClick="ValidateBindingAsync"
                                              Disabled="@(_bindingBusy || _loading)"
                                              Class="action">
                                    @(designated.ValidatedAt is null ? "Validate workspace" : "Revalidate workspace")
                                </FluentButton>
                                <FluentButton Appearance="Appearance.Stealth"
                                              OnClick="RemoveBindingAsync"
                                              Disabled="@BindingWriteBlocked"
                                              Class="action">
                                    Remove designation
                                </FluentButton>
                            }
                        </FluentStack>
                    </section>

                    <section class="fact-group" aria-labelledby="policy-facts-heading">
                        <h3 id="policy-facts-heading" class="group-title">Concurrency policy</h3>
                        <dl class="facts">
                            <dt>Write slots</dt>
                            <dd>@project.MaxActiveWriteRequests</dd>
                            <dt>Read-only slots</dt>
                            <dd>@project.MaxReadOnlyRequests</dd>
                            <dt>Child agents per request</dt>
                            <dd>@project.MaxChildAgentsPerRequest</dd>
                            <dt>Active agents</dt>
                            <dd>
                                @if (_sessionError is not null)
                                {
                                    <span class="node-missing">Session projection unavailable</span>
                                }
                                else
                                {
                                    @_activeSessions
                                    <span class="node-seen">of @_trackedSessions tracked sessions</span>
                                }
                            </dd>
                        </dl>
                    </section>
                </div>
            </section>
        </FluentCard>

        <FluentCard>
            <section class="panel" aria-labelledby="verification-policy-heading">
                <h2 id="verification-policy-heading">Verification policy</h2>
                <p class="panel-lead">
                    Automatic baseline checks always run. Project checks are optional trusted
                    commands from the designated node.
                </p>

                <dl class="facts">
                    <dt>Automatic baseline</dt>
                    <dd>
                        <FluentBadge Appearance="Appearance.Accent">Always enabled</FluentBadge>
                        <span class="node-seen">devfleet-baseline · version 1</span>
                    </dd>
                    <dt>Readiness</dt>
                    <dd>@VerificationReadinessLabel()</dd>
                </dl>

                @if (_verificationWarning is not null)
                {
                    <FluentMessageBar Intent="MessageIntent.Warning"
                                      Title="Project checks not selected"
                                      AllowDismiss="false">
                        @_verificationWarning
                    </FluentMessageBar>
                }

                @if (_verificationError is not null)
                {
                    <FluentMessageBar Intent="MessageIntent.Error"
                                      Title="Verification policy action failed"
                                      AllowDismiss="false">
                        @_verificationError
                    </FluentMessageBar>
                }

                @if (string.IsNullOrWhiteSpace(project.TrustedVerificationProfileId))
                {
                    <p class="panel-lead">
                        Baseline repository checks will run. No project test suite is configured.
                    </p>
                }

                <div class="form-grid">
                    <FluentSelect TOption="VerificationProfileChoice"
                                  Label="Project checks"
                                  Items="@_verificationChoices"
                                  OptionText="@(choice => choice.Label)"
                                  OptionValue="@(choice => choice.Id)"
                                  @bind-Value="_selectedVerificationProfileId"
                                  Disabled="@(_verificationBusy || _loading)"
                                  Class="field" />
                </div>

                @if (_verificationCatalog is { Profiles.Count: > 0 } catalog)
                {
                    <ul class="facts">
                        @foreach (var profile in catalog.Profiles)
                        {
                            <li class="node-seen">
                                <span class="node-name">@profile.DisplayLabel</span>
                                @foreach (var command in profile.Commands)
                                {
                                    <span>
                                        @command.DisplayLabel
                                        (@command.WorkingDirectoryLabel,
                                        @(command.Mandatory ? "mandatory" : "optional"),
                                        @command.TimeoutSeconds s)
                                    </span>
                                }
                            </li>
                        }
                    </ul>
                }

                <FluentStack HorizontalGap="8" VerticalGap="8" Wrap="true">
                    <FluentButton Appearance="Appearance.Accent"
                                  OnClick="SaveVerificationPolicyAsync"
                                  Loading="@_verificationBusy"
                                  Disabled="@(_verificationBusy || _loading || project.Binding is null)"
                                  Class="action">
                        Save project checks
                    </FluentButton>
                </FluentStack>
            </section>
        </FluentCard>

        <FluentCard>
            <section class="panel" aria-labelledby="composer-heading">
                <h2 id="composer-heading">New request</h2>
                <p class="panel-lead">
                    A queued request waits for a node to claim it. Development work may change files;
                    analysis and review are read-only.
                </p>
                @if (project.Binding is null)
                {
                    <p class="panel-lead">
                        This project has no designated workspace. Queueing still works: the request
                        stays <em>Queued</em> with a scheduling reason and is never assigned a node
                        until a workspace is designated, validated, and its node is eligible.
                    </p>
                }

                @if (_composerErrors.Count > 0)
                {
                    <FluentMessageBar Intent="MessageIntent.Error"
                                      Title="Could not queue request"
                                      AllowDismiss="false">
                        @if (_composerErrors.Count == 1)
                        {
                            @_composerErrors[0]
                        }
                        else
                        {
                            <ul class="error-list">
                                @foreach (var error in _composerErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        }
                    </FluentMessageBar>
                }

                @if (_queuedTitle is not null)
                {
                    <div role="status">
                        <FluentMessageBar Intent="MessageIntent.Success" AllowDismiss="false">
                            Queued @_queuedTitle
                        </FluentMessageBar>
                    </div>
                }

                <div class="composer">
                    <div class="composer-main">
                        <FluentTextField @bind-Value="_title"
                                         Label="Title"
                                         Required="true"
                                         Placeholder="Add strict reservation handoff"
                                         Class="field field-wide" />

                        <FluentTextArea @bind-Value="_prompt"
                                        Label="Prompt"
                                        Required="true"
                                        Rows="5"
                                        Placeholder="Implement atomic reservation handoff with stale-token rejection."
                                        Class="field field-wide" />
                    </div>

                    <div class="composer-side">
                        <div class="form-grid">
                            <FluentSelect TOption="string"
                                          Label="Kind"
                                          Items="@KindNames"
                                          OptionText="@(name => name)"
                                          OptionValue="@(name => name)"
                                          @bind-Value="_kind"
                                          Class="field" />
                            <FluentSelect TOption="string"
                                          Label="Priority"
                                          Items="@PriorityNames"
                                          OptionText="@(name => name)"
                                          OptionValue="@(name => name)"
                                          @bind-Value="_priority"
                                          Class="field" />
                            <FluentSelect TOption="string"
                                          Label="Risk"
                                          Items="@RiskNames"
                                          OptionText="@(name => name)"
                                          OptionValue="@(name => name)"
                                          @bind-Value="_risk"
                                          Class="field" />
                        </div>

                        <div class="composer-actions">
                            <FluentButton Appearance="Appearance.Accent"
                                          OnClick="EnqueueAsync"
                                          Loading="@_submitting"
                                          Class="action action-primary">
                                Queue request
                            </FluentButton>
                        </div>
                    </div>
                </div>
            </section>
        </FluentCard>

        <div class="queues">
            @foreach (var group in RequestGroups())
            {
                <section class="queue" aria-labelledby="@group.HeadingId">
                    <div class="queue-head">
                        <h2 id="@group.HeadingId">@group.Heading</h2>
                        <span class="queue-count">@group.Requests.Count</span>
                    </div>
                    @if (group.Requests.Count == 0)
                    {
                        <p class="panel-empty">@group.EmptyText</p>
                    }
                    else
                    {
                        <ul class="request-list">
                            @foreach (var request in group.Requests)
                            {
                                <li>
                                    <article class="request-row">
                                        <div class="request-head">
                                            <h3>
                                                <a href="@($"/requests/{request.Id}")">@request.Title</a>
                                            </h3>
                                            <div class="badge-row">
                                                <FluentBadge Appearance="Appearance.Accent">@request.StatusName</FluentBadge>
                                                <FluentBadge Appearance="Appearance.Neutral">@request.PriorityName</FluentBadge>
                                                <FluentBadge Appearance="Appearance.Neutral">@request.KindName</FluentBadge>
                                                <FluentBadge Appearance="Appearance.Neutral">@request.RiskLevelName</FluentBadge>
                                                @if (request.SchedulingStatus is { } scheduling)
                                                {
                                                    <FluentBadge Appearance="@(scheduling.IsEligible ? Appearance.Accent : Appearance.Neutral)">
                                                        @SchedulingLabel(scheduling.Code)
                                                    </FluentBadge>
                                                }
                                                @if (request.Assignment is { } assigned)
                                                {
                                                    <FluentBadge Appearance="@(IsAssignmentTerminal(assigned.State) ? Appearance.Neutral : Appearance.Accent)">
                                                        @assigned.State.ToString()
                                                    </FluentBadge>
                                                }
                                            </div>
                                        </div>
                                        <p class="request-prompt">@request.Prompt</p>
                                        <p class="request-meta">
                                            Created @request.CreatedAt.ToString("u")
                                            @if (request.BlockedPhaseName is not null)
                                            {
                                                <span>&nbsp;&middot; blocked in @request.BlockedPhaseName</span>
                                            }
                                            <span>&nbsp;&middot; @AgentSummary(request.Id)</span>
                                        </p>
                                        @if (request.SchedulingStatus is { } waiting)
                                        {
                                            <p class="request-meta">
                                                @waiting.Detail
                                                <span>&nbsp;&middot; @waiting.Action</span>
                                            </p>
                                        }
                                        @if (request.Assignment is { } assignment)
                                        {
                                            @if (assignment.State == ExecutionAssignmentState.Finalizing)
                                            {
                                                <FluentMessageBar Intent="MessageIntent.Warning"
                                                                  Title="Assignment is finalizing"
                                                                  AllowDismiss="false">
                                                    Completion was accepted, but ownership is not released: this
                                                    assignment still holds project and node capacity while it
                                                    quiesces.
                                                </FluentMessageBar>
                                            }
                                            else if (assignment.State == ExecutionAssignmentState.Cancelling)
                                            {
                                                <FluentMessageBar Intent="MessageIntent.Warning"
                                                                  Title="Assignment is cancelling"
                                                                  AllowDismiss="false">
                                                    Cancellation was delivered to the assigned node only. The
                                                    writer slot and reservations stay held until it quiesces.
                                                </FluentMessageBar>
                                            }
                                            else if (assignment.State == ExecutionAssignmentState.RecoveryRequired)
                                            {
                                                <FluentMessageBar Intent="MessageIntent.Warning"
                                                                  Title="Assignment requires recovery"
                                                                  AllowDismiss="false">
                                                    Ownership is uncertain and no second writer is permitted. The
                                                    assignment is durable, still occupies capacity, and holds this
                                                    project's workspace designation.
                                                </FluentMessageBar>
                                            }
                                            <p class="request-meta">
                                                @(IsAssignmentTerminal(assignment.State)
                                                    ? "Retained placement history"
                                                    : "Immutable placement snapshot")
                                                <span>&nbsp;&middot; binding revision @assignment.BindingValidationRevisionSnapshot</span>
                                                <span>&nbsp;&middot; branch @assignment.DefaultBranchSnapshot</span>
                                                <span>&nbsp;&middot; assigned @Relative(assignment.AssignedAt, _snapshot)</span>
                                                @if (assignment.LastRenewedAt is { } renewed)
                                                {
                                                    <span>&nbsp;&middot; renewed @Relative(renewed, _snapshot)</span>
                                                }
                                                @if (assignment.LastReconciledAt is { } reconciled)
                                                {
                                                    <span>&nbsp;&middot; reconciled @Relative(reconciled, _snapshot)</span>
                                                }
                                                @if (assignment.TerminalAt is { } terminal)
                                                {
                                                    <span>&nbsp;&middot; terminal @terminal.ToString("u")</span>
                                                }
                                                else
                                                {
                                                    <span>&nbsp;&middot; lease expires @assignment.LeaseExpiresAt.ToString("u")</span>
                                                }
                                            </p>
                                            <p class="request-meta">@assignment.CanonicalRepositoryPathSnapshot</p>
                                        }
                                    </article>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }
        </div>

        <section class="queue" aria-labelledby="reservations-heading">
            <div class="queue-head">
                <h2 id="reservations-heading">Active reservations</h2>
                <span class="queue-status" role="status" aria-live="polite">
                    @(_reservationError is not null
                        ? "reservation authority unavailable"
                        : $"{_leases.Count} lease group(s) held")
                </span>
            </div>
            @if (_reservationError is not null)
            {
                <FluentMessageBar Intent="MessageIntent.Error"
                                  Title="Could not load reservations"
                                  AllowDismiss="false">
                    @_reservationError
                </FluentMessageBar>
            }
            else if (_leases.Count == 0)
            {
                <p class="panel-empty">
                    No lease group is held in this project. Agents acquire leases only while they
                    mutate files, so an idle project holds none.
                </p>
            }
            else
            {
                <ul class="request-list lease-list">
                    @foreach (var lease in _leases)
                    {
                        <li>
                            <ReservationLeaseCard Lease="lease"
                                                  OwnerLabel="@OwnerLabel(lease.OwnerSessionId)"
                                                  Now="_snapshot"
                                                  OnForceReleased="ReloadAsync" />
                        </li>
                    }
                </ul>
            }
        </section>

        @* The durable recovery surface itself. It renders its own labeled section and the
           #project-recovery anchor every entry point on this page and elsewhere links to;
           LiveView already reloads this page when recovery commits a durable change. *@
        <ProjectRecoveryPanel ProjectId="@ProjectId" />
    </div>
}

<div class="dialog-host">
    <FluentDialog @bind-Hidden="_pickerHidden"
                  Modal="true"
                  TrapFocus="true"
                  PreventScroll="true"
                  Class="folder-dialog"
                  AriaLabelledby="folder-picker-heading">
        <div class="dialog-shell">
            <header class="dialog-header">
                <h2 id="folder-picker-heading">Select workspace folder</h2>
                <p class="dialog-lead">
                    @PickerNodeLabel() lists these folders itself, from its own approved roots.
                    Open a folder to go one level deeper, then select the folder you are in.
                </p>
                <p class="picker-breadcrumb">
                    <span class="visually-hidden">Current location</span>
                    @if (_pickerCurrentPath is { Length: > 0 } here)
                    {
                        <span class="path">@here</span>
                    }
                    else
                    {
                        <span class="picker-breadcrumb-roots">Approved roots</span>
                    }
                </p>
            </header>

            <div class="dialog-body">
                @if (_pickerOffline)
                {
                    <FluentMessageBar Intent="MessageIntent.Warning"
                                      Title="Node did not answer"
                                      AllowDismiss="false">
                        @(_pickerError ?? "The selected node is not connected, so it cannot list folders.")
                    </FluentMessageBar>
                }
                else if (_pickerErrorCode is { Length: > 0 } errorCode)
                {
                    <FluentMessageBar Intent="MessageIntent.Error"
                                      Title="@PickerErrorTitle(errorCode)"
                                      AllowDismiss="false">
                        @(_pickerError ?? "The node refused that folder and returned no detail.")
                    </FluentMessageBar>
                }
                else if (_pickerError is { Length: > 0 } pickerError)
                {
                    <FluentMessageBar Intent="MessageIntent.Error"
                                      Title="Could not list folders"
                                      AllowDismiss="false">
                        @pickerError
                    </FluentMessageBar>
                }

                @if (_pickerLoading)
                {
                    <div class="state-block" role="status">
                        <FluentProgressRing aria-label="Listing folders" />
                        <span>Listing folders on the node</span>
                    </div>
                }

                else if (_pickerEntries.Count > 0)
                {
                    <ul class="folder-list">
                        @foreach (var entry in _pickerEntries)
                        {
                            <li>
                                <button type="button"
                                        class="folder-entry"
                                        @onclick="() => BrowseAsync(entry.Path)">
                                    <span class="folder-entry-name">@entry.Name</span>
                                    <span class="folder-entry-path">@entry.Path</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
                else if (_pickerErrorCode is null && !_pickerOffline && _pickerError is null)
                {
                    <p class="panel-empty">
                        @(_pickerCurrentPath is null
                            ? "This node has no approved roots configured, so there is no folder to select."
                            : "This folder has no subfolders. Select it, or go up and choose another.")
                    </p>
                }
            </div>

            <footer class="dialog-actions">
                <FluentButton Appearance="Appearance.Accent"
                              OnClick="SelectCurrentFolder"
                              Disabled="@(_pickerLoading || _pickerCurrentPath is null)">
                    Select this folder
                </FluentButton>
                <FluentButton Appearance="Appearance.Outline"
                              OnClick="BrowseUpAsync"
                              Disabled="@(_pickerLoading || _pickerCurrentPath is null)">
                    Up one level
                </FluentButton>
                <FluentButton Appearance="Appearance.Stealth"
                              OnClick="CloseFolderPicker"
                              Class="action-cancel">
                    Cancel
                </FluentButton>
            </footer>
        </div>
    </FluentDialog>
</div>

@code {
    private static readonly string[] KindNames = Enum.GetNames<WorkRequestKind>();
    private static readonly string[] PriorityNames = Enum.GetNames<RequestPriority>();
    private static readonly string[] RiskNames = Enum.GetNames<RiskLevel>();

    [Parameter]
    public Guid ProjectId { get; set; }

    private List<WorkRequestDto> _active = [];
    private List<WorkRequestDto> _queued = [];
    private List<WorkRequestDto> _closed = [];

    private IReadOnlyList<string> _composerErrors = Array.Empty<string>();
    private ProjectDto? _project;
    private NodeDto? _node;
    private IReadOnlyList<NodeDto> _nodes = Array.Empty<NodeDto>();
    private DateTimeOffset _snapshot;
    private string? _loadError;
    private string? _nodeError;
    private string? _queuedTitle;
    private string? _title = string.Empty;
    private string? _prompt = string.Empty;
    private string? _kind = nameof(WorkRequestKind.Development);
    private string? _priority = nameof(RequestPriority.Normal);
    private string? _risk = nameof(RiskLevel.Standard);
    private bool _loading = true;
    private bool _submitting;
    private readonly Dictionary<Guid, IReadOnlyList<AgentSessionDto>> _sessionsByRequest = [];
    private string? _sessionError;
    private int _activeSessions;
    private int _trackedSessions;
    private IReadOnlyList<ReservationLeaseDto> _leases = Array.Empty<ReservationLeaseDto>();
    private string? _reservationError;
    private RecoveryCallout? _recovery;

    private string? _bindingNodeId;
    private string? _bindingPath = string.Empty;
    private string? _bindingError;
    private string? _bindingNotice;
    private string? _bindingLock;
    private bool _bindingBusy;
    private bool _bindingSeeded;

    private VerificationPolicyCatalogMessage? _verificationCatalog;
    private IReadOnlyList<VerificationProfileChoice> _verificationChoices =
        [new VerificationProfileChoice(string.Empty, "None")];
    private string? _selectedVerificationProfileId = string.Empty;
    private string? _verificationError;
    private string? _verificationWarning;
    private bool _verificationBusy;

    private sealed record VerificationProfileChoice(string Id, string Label);

    /// <summary>
    /// Folder picker state. The listing is node-local: the control plane holds only what the
    /// selected node returned for the level currently shown, and it is discarded whenever the
    /// node changes so a path can never cross nodes.
    /// </summary>
    private bool _pickerHidden = true;
    private bool _pickerLoading;
    private bool _pickerOffline;
    private string? _pickerCurrentPath;
    private string? _pickerParentPath;
    private string? _pickerError;
    private string? _pickerErrorCode;
    private IReadOnlyList<WorkspaceDirectoryEntryMessage> _pickerEntries =
        Array.Empty<WorkspaceDirectoryEntryMessage>();

    private bool HasSelectedFolder => !string.IsNullOrWhiteSpace(_bindingPath);

    private string PickerValueClass =>
        HasSelectedFolder ? "picker-value path" : "picker-value picker-value-empty";

    /// <summary>
    /// The catalog rejects removal, and replacement discards a snapshot still in use, while a
    /// nonterminal or recovery-required assignment references the designation.
    /// </summary>
    private bool BindingWriteBlocked => _bindingBusy || _loading || _bindingLock is not null;

    private LiveView? _live;
    private bool _busy;

    protected override Task OnParametersSetAsync() => ReloadAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _live is null)
        {
            _live = new LiveView(
                Notifier,
                change => change.AffectsProject(ProjectId),
                () => InvokeAsync(async () =>
                {
                    await ReloadAsync(showSpinner: false);
                    StateHasChanged();
                }));
        }
    }

    public async ValueTask DisposeAsync()
    {
        var live = _live;
        _live = null;
        if (live is not null)
        {
            await live.DisposeAsync();
        }
    }

    private readonly record struct RequestGroup(
        string HeadingId,
        string Heading,
        string EmptyText,
        IReadOnlyList<WorkRequestDto> Requests);

    private RequestGroup[] RequestGroups() =>
    [
        new("active-heading", "Active", "No active request.", _active),
        new("queue-heading", "Queue", "Nothing queued.", _queued),
        new("completed-heading", "Recently completed", "No completed requests yet.", _closed),
    ];

    private Task ReloadAsync() => ReloadAsync(showSpinner: true);

    /// <summary>
    /// Re-reads the project. A live refresh keeps the rendered data in place while it reads, so a
    /// committed write never blanks the page; an explicit reload clears first and shows the spinner.
    /// </summary>
    private async Task ReloadAsync(bool showSpinner)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _loadError = null;
        _nodeError = null;
        _recovery = null;
        if (showSpinner)
        {
            _loading = true;
            _node = null;
            _bindingSeeded = false;
            Partition(Array.Empty<WorkRequestDto>());
            ResetSessions();
            StateHasChanged();
        }

        try
        {
            if (ProjectId == Guid.Empty)
            {
                _project = null;
                return;
            }

            var id = new ProjectId(ProjectId);
            _project = await Catalog.GetAsync(id, CancellationToken.None);
            var requests = await Queue.ListAsync(id, CancellationToken.None);
            Partition(requests);
            await LoadSessionsAsync(requests);
            await LoadNodesAsync(_project.Binding);
            ComputeBindingLock(_project.Binding, requests);
            ComputeRecoveryEntry(requests);
            SeedBindingForm(_project.Binding);
            await LoadReservationsAsync();
            await LoadVerificationPolicyAsync(_project);
        }
        catch (ProjectNotFoundException)
        {
            _project = null;
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _snapshot = Clock.UtcNow;
            _loading = false;
            _busy = false;
        }
    }

    /// <summary>
    /// Reads the registered nodes once: the selector needs the whole fleet, and the designated
    /// node is resolved from the same list instead of a second lookup on a possibly absent id.
    /// </summary>
    private async Task LoadNodesAsync(WorkspaceBindingDto? binding)
    {
        try
        {
            _nodes = await NodeRegistry.ListAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _nodes = Array.Empty<NodeDto>();
            _node = null;
            _nodeError = ex.Message;
            return;
        }

        _node = binding is null
            ? null
            : _nodes.FirstOrDefault(node => node.Id == binding.NodeId);
    }

    /// <summary>
    /// Mirrors the stored designation into the editor. A live refresh leaves an operator's
    /// in-progress edit alone; an explicit reload or a completed action re-seeds from the server.
    /// </summary>
    private void SeedBindingForm(WorkspaceBindingDto? binding)
    {
        if (_bindingSeeded && _bindingNodeId is { Length: > 0 })
        {
            return;
        }

        _bindingNodeId = binding is null
            ? _nodes.FirstOrDefault()?.Id.ToString()
            : binding.NodeId.ToString();
        _bindingPath = binding?.RepositoryPath ?? string.Empty;
        _bindingSeeded = true;
        ResetFolderPicker();
    }

    /// <summary>
    /// Opens the node-local folder picker at the selected node's approved roots. An already
    /// selected path stays selected: it is displayed as chosen without being re-browsed.
    /// </summary>
    private async Task OpenFolderPickerAsync()
    {
        if (BindingWriteBlocked)
        {
            return;
        }

        _pickerHidden = false;
        await BrowseAsync(null);
    }

    private void CloseFolderPicker() => _pickerHidden = true;

    /// <summary>
    /// Discards the selected path and every listed level when the node changes, so a folder
    /// browsed on one node can never be designated against another.
    /// </summary>
    private void OnBindingNodeChanged()
    {
        _bindingPath = string.Empty;
        _bindingError = null;
        ResetFolderPicker();
    }

    private void ResetFolderPicker()
    {
        _pickerHidden = true;
        _pickerLoading = false;
        _pickerOffline = false;
        _pickerCurrentPath = null;
        _pickerParentPath = null;
        _pickerError = null;
        _pickerErrorCode = null;
        _pickerEntries = Array.Empty<WorkspaceDirectoryEntryMessage>();
    }

    /// <summary>
    /// Asks the selected node for one level; a null path lists its approved roots. The shown
    /// level only advances on a clean answer, so a refused path leaves the operator where they
    /// were, with the node's own reason.
    /// </summary>
    private async Task BrowseAsync(string? path)
    {
        if (!Guid.TryParse(_bindingNodeId, out var nodeId) || nodeId == Guid.Empty)
        {
            _pickerOffline = false;
            _pickerErrorCode = null;
            _pickerError = "Select the node that owns the workspace first.";
            _pickerEntries = Array.Empty<WorkspaceDirectoryEntryMessage>();
            return;
        }

        _pickerLoading = true;
        _pickerOffline = false;
        _pickerError = null;
        _pickerErrorCode = null;
        StateHasChanged();

        try
        {
            var response = await Directories.BrowseAsync(
                nodeId,
                new WorkspaceDirectoryBrowseRequestMessage(path),
                CancellationToken.None);

            if (response.ErrorCode is { Length: > 0 } code)
            {
                _pickerErrorCode = code;
                _pickerError = response.ErrorDetail;
                _pickerEntries = Array.Empty<WorkspaceDirectoryEntryMessage>();
            }
            else
            {
                _pickerCurrentPath = response.CurrentPath;
                _pickerParentPath = response.ParentPath;
                _pickerEntries = response.Directories;
            }
        }
        catch (InvalidOperationException ex)
        {
            _pickerOffline = true;
            _pickerError = ex.Message;
            _pickerEntries = Array.Empty<WorkspaceDirectoryEntryMessage>();
        }
        catch (Exception ex)
        {
            _pickerError = ex.Message;
            _pickerEntries = Array.Empty<WorkspaceDirectoryEntryMessage>();
        }
        finally
        {
            _pickerLoading = false;
        }
    }

    /// <summary>One level up: the node's parent path, or its approved roots when at a root.</summary>
    private Task BrowseUpAsync() =>
        _pickerCurrentPath is null ? Task.CompletedTask : BrowseAsync(_pickerParentPath);

    /// <summary>
    /// Takes the canonical path the node returned for the shown level as the designation input.
    /// Designating and validating stay the separate existing actions.
    /// </summary>
    private void SelectCurrentFolder()
    {
        if (_pickerCurrentPath is not { Length: > 0 } selected)
        {
            return;
        }

        _bindingPath = selected;
        _bindingError = null;
        _pickerHidden = true;
    }

    /// <summary>Names the node the picker is listing, falling back when none is selected.</summary>
    private string PickerNodeLabel()
    {
        if (Guid.TryParse(_bindingNodeId, out var nodeId))
        {
            foreach (var node in _nodes)
            {
                if (node.Id == nodeId)
                {
                    return node.DisplayName;
                }
            }
        }

        return "The selected node";
    }

    /// <summary>Operator title for a node-issued browse error code; the node owns the detail.</summary>
    private static string PickerErrorTitle(string code) => code switch
    {
        WorkspaceDirectoryBrowseErrorCodes.InvalidPath => "That path is not usable",
        WorkspaceDirectoryBrowseErrorCodes.PathMissing => "That folder no longer exists",
        WorkspaceDirectoryBrowseErrorCodes.OutsideApprovedRoot => "Outside the node's approved roots",
        WorkspaceDirectoryBrowseErrorCodes.Unreadable => "The node could not read that folder",
        _ => "The node refused that folder",
    };

    /// <summary>
    /// Names the assignment that makes the catalog reject removal, so the actions are disabled
    /// from the same projection the server decides on rather than after a failed round trip.
    /// </summary>
    private void ComputeBindingLock(
        WorkspaceBindingDto? binding,
        IReadOnlyList<WorkRequestDto> requests)
    {
        _bindingLock = null;
        if (binding is null)
        {
            return;
        }

        foreach (var request in requests)
        {
            if (request.Assignment is { } assignment
                && assignment.WorkspaceBindingId == binding.Id
                && !IsAssignmentTerminal(assignment.State))
            {
                _bindingLock =
                    $"Request \u201c{request.Title}\u201d holds a {assignment.State} assignment on this "
                    + "workspace. The designation cannot be replaced or removed until that assignment "
                    + "is terminal or recovered.";
                return;
            }
        }
    }

    private static bool IsAssignmentTerminal(ExecutionAssignmentState state) =>
        state is ExecutionAssignmentState.Completed
            or ExecutionAssignmentState.Failed
            or ExecutionAssignmentState.Cancelled;

    /// <summary>
    /// One contextual entry into the recovery panel, derived only from persisted facts already
    /// rendered on this page.
    /// </summary>
    private readonly record struct RecoveryCallout(
        string Title,
        string Detail,
        Guid? RequestId,
        string? RequestTitle);

    /// <summary>
    /// Picks the retained execution fact that Recover project answers. Only a nonterminal
    /// assignment qualifies, so an idle project with an offline node keeps its ordinary
    /// scheduling explanation instead of being told to recover, and uncertain ownership
    /// outranks a quiescing stop, an unreachable owner, or a blocked request.
    /// </summary>
    private void ComputeRecoveryEntry(IReadOnlyList<WorkRequestDto> requests)
    {
        _recovery = null;

        foreach (var request in requests)
        {
            if (request.Assignment is not { } assignment || IsAssignmentTerminal(assignment.State))
            {
                continue;
            }

            if (RetainedCallout(request, assignment) is not { } callout)
            {
                continue;
            }

            if (assignment.State == ExecutionAssignmentState.RecoveryRequired)
            {
                _recovery = callout;
                return;
            }

            _recovery ??= callout;
        }
    }

    private RecoveryCallout? RetainedCallout(WorkRequestDto request, ExecutionAssignmentProjectionDto assignment)
    {
        if (assignment.State == ExecutionAssignmentState.RecoveryRequired)
        {
            return new RecoveryCallout(
                "This project needs recovery",
                $"\u201c{request.Title}\u201d holds a RecoveryRequired assignment. Ownership is "
                    + "uncertain, so capacity and the workspace designation stay held and no second "
                    + "writer is permitted until recovery resolves it.",
                request.Id,
                request.Title);
        }

        if (assignment.State == ExecutionAssignmentState.Cancelling)
        {
            return new RecoveryCallout(
                "Cancellation has not released ownership",
                $"\u201c{request.Title}\u201d is Cancelling. The assigned node has not proved "
                    + "quiescence, so the writer slot and its reservations are still held.",
                request.Id,
                request.Title);
        }

        if (assignment.State == ExecutionAssignmentState.Finalizing)
        {
            return new RecoveryCallout(
                "Finalization has not released ownership",
                $"\u201c{request.Title}\u201d is Finalizing. Completion was accepted, but this "
                    + "project's capacity stays held until the assigned node quiesces.",
                request.Id,
                request.Title);
        }

        if (_nodeError is not null || _node is null || _node.Status != NodeStatus.Online)
        {
            return new RecoveryCallout(
                "The designated node is not connected",
                $"\u201c{request.Title}\u201d holds a {assignment.State} assignment, and the "
                    + "designated node is not connected. Silence is not proof that its work stopped, "
                    + "so ownership stays with that node.",
                request.Id,
                request.Title);
        }

        if ((WorkRequestStatus)request.Status == WorkRequestStatus.Blocked)
        {
            return new RecoveryCallout(
                "A blocked request is holding execution",
                $"\u201c{request.Title}\u201d is blocked in {request.BlockedPhaseName} while its "
                    + "assignment holds capacity. Answer the request itself first; recover the "
                    + "project only if its execution cannot continue.",
                request.Id,
                request.Title);
        }

        return null;
    }

    /// <summary>
    /// Operator label for a server-issued scheduling code. The server owns precedence, detail,
    /// and action text; this only names the code it already chose.
    /// </summary>
    private static string SchedulingLabel(string code) => code switch
    {
        SchedulingReasonCodes.ProjectDisabled => "Project disabled",
        SchedulingReasonCodes.WorkspaceBindingMissing => "No workspace",
        SchedulingReasonCodes.WorkspaceValidationPending => "Validation pending",
        SchedulingReasonCodes.WorkspaceInvalid => "Workspace invalid",
        SchedulingReasonCodes.NodeOffline => "Node offline",
        SchedulingReasonCodes.RuntimeUnavailable => "Runtime unavailable",
        SchedulingReasonCodes.RuntimeUnknown => "Runtime unknown",
        SchedulingReasonCodes.NodeCapacityUnavailable => "At capacity",
        SchedulingReasonCodes.ProjectConcurrencyUnavailable => "Project at limit",
        SchedulingReasonCodes.Eligible => "Ready",
        _ => code,
    };

    /// <summary>
    /// Creates or replaces the sole designation. The node interprets the path, so the control
    /// plane only records it and waits for that node's validation of the new revision.
    /// </summary>
    private async Task DesignateAsync()
    {
        _bindingError = null;
        _bindingNotice = null;

        if (!Guid.TryParse(_bindingNodeId, out var nodeId) || nodeId == Guid.Empty)
        {
            _bindingError = "Select the node that owns the workspace.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_bindingPath))
        {
            _bindingError = "Browse the node and select a workspace folder.";
            return;
        }

        _bindingBusy = true;
        try
        {
            var binding = await Bindings.DesignateAsync(
                new ProjectId(ProjectId),
                new DesignateWorkspaceBindingCommand(new NodeId(nodeId), _bindingPath!),
                Clock.UtcNow,
                CancellationToken.None);
            ToastService.ShowSuccess($"Designated {binding.RepositoryPath}");
            _bindingNotice =
                $"Validation revision {binding.ValidationRevision} is pending on the designated node.";
            _bindingSeeded = false;
        }
        catch (Exception ex)
        {
            _bindingError = ex.Message;
        }
        finally
        {
            _bindingBusy = false;
        }

        await ReloadAsync(showSpinner: false);
    }

    /// <summary>
    /// Asks the designated node to validate the current revision. An offline node leaves the
    /// revision pending, which is reported rather than retried or reinterpreted here.
    /// </summary>
    private async Task ValidateBindingAsync()
    {
        _bindingError = null;
        _bindingNotice = null;
        _bindingBusy = true;
        try
        {
            var binding = await Bindings.ValidateAsync(
                new ProjectId(ProjectId),
                Clock.UtcNow,
                CancellationToken.None);
            _bindingNotice = binding.Status switch
            {
                WorkspaceBindingStatus.Valid =>
                    $"Revision {binding.ValidationRevision} is valid at {binding.CanonicalRepositoryPath}.",
                WorkspaceBindingStatus.Invalid =>
                    $"Revision {binding.ValidationRevision} is invalid: "
                    + (binding.ValidationDetail ?? binding.ValidationCode ?? "no detail was returned."),
                _ =>
                    $"Revision {binding.ValidationRevision} is still pending: the designated node did "
                    + "not answer this request.",
            };
            _bindingSeeded = false;
        }
        catch (Exception ex)
        {
            _bindingError = ex.Message;
        }
        finally
        {
            _bindingBusy = false;
        }

        await ReloadAsync(showSpinner: false);
    }

    private async Task RemoveBindingAsync()
    {
        _bindingError = null;
        _bindingNotice = null;
        _bindingBusy = true;
        try
        {
            await Bindings.DeleteAsync(new ProjectId(ProjectId), Clock.UtcNow, CancellationToken.None);
            ToastService.ShowSuccess("Removed the workspace designation");
            _bindingNotice =
                "This project is unbound. Queued work waits with a scheduling reason until a "
                + "workspace is designated and validated again.";
            _bindingSeeded = false;
        }
        catch (Exception ex)
        {
            _bindingError = ex.Message;
        }
        finally
        {
            _bindingBusy = false;
        }

        await ReloadAsync(showSpinner: false);
    }

    private static string WorkspacePath(WorkspaceBindingDto binding) =>
        binding.CanonicalRepositoryPath ?? binding.RepositoryPath;

    private static Appearance BindingAppearance(WorkspaceBindingStatus status) => status switch
    {
        WorkspaceBindingStatus.Valid => Appearance.Accent,
        _ => Appearance.Neutral,
    };

    private async Task LoadReservationsAsync()
    {
        try
        {
            _leases = await ReservationAuthority.ListAsync(
                ProjectId,
                includeReleased: false,
                CancellationToken.None);
            _reservationError = null;
        }
        catch (Exception ex)
        {
            _leases = Array.Empty<ReservationLeaseDto>();
            _reservationError = ex.Message;
        }
    }

    /// <summary>Names the owning session from the loaded projections, falling back to its id.</summary>
    private string OwnerLabel(string sessionId)
    {
        foreach (var sessions in _sessionsByRequest.Values)
        {
            foreach (var session in sessions)
            {
                if (string.Equals(session.Id, sessionId, StringComparison.Ordinal))
                {
                    return $"{session.AgentName} ({session.Role})";
                }
            }
        }

        return sessionId;
    }

    private void ResetSessions()
    {
        _sessionsByRequest.Clear();
        _sessionError = null;
        _activeSessions = 0;
        _trackedSessions = 0;
    }

    private async Task LoadSessionsAsync(IReadOnlyList<WorkRequestDto> requests)
    {
        ResetSessions();

        foreach (var request in requests)
        {
            IReadOnlyList<AgentSessionDto> sessions;
            try
            {
                sessions = await SessionStore.ListAsync(new WorkRequestId(request.Id), CancellationToken.None);
            }
            catch (Exception ex)
            {
                _sessionError ??= ex.Message;
                continue;
            }

            _sessionsByRequest[request.Id] = sessions;
            _trackedSessions += sessions.Count;
            foreach (var session in sessions)
            {
                if (IsRunning(session))
                {
                    _activeSessions++;
                }
            }
        }
    }

    private string AgentSummary(Guid requestId)
    {
        if (_sessionError is not null)
        {
            return "agents unavailable";
        }

        if (!_sessionsByRequest.TryGetValue(requestId, out var sessions) || sessions.Count == 0)
        {
            return "no agent session";
        }

        var running = 0;
        foreach (var session in sessions)
        {
            if (IsRunning(session))
            {
                running++;
            }
        }

        return $"{running} of {sessions.Count} agent{(sessions.Count == 1 ? string.Empty : "s")} running";
    }

    private static bool IsRunning(AgentSessionDto session) =>
        session.EndedAt is null
        && session.Liveness != AgentLiveness.Exited
        && session.WorkState is not (AgentWorkState.Completed or AgentWorkState.Failed or AgentWorkState.Cancelled);

    private static Appearance BadgeAppearance(NodeStatus status) =>
        status == NodeStatus.Online ? Appearance.Accent : Appearance.Neutral;

    private static string Relative(DateTimeOffset instant, DateTimeOffset now)
    {
        var delta = now - instant;
        if (delta < TimeSpan.Zero)
        {
            delta = TimeSpan.Zero;
        }

        if (delta.TotalSeconds < 60)
        {
            return $"{(int)delta.TotalSeconds}s ago";
        }

        if (delta.TotalMinutes < 60)
        {
            return $"{(int)delta.TotalMinutes}m ago";
        }

        if (delta.TotalHours < 24)
        {
            return $"{(int)delta.TotalHours}h ago";
        }

        return $"{(int)delta.TotalDays}d ago";
    }

    private void Partition(IReadOnlyList<WorkRequestDto> requests)
    {
        _active = [];
        _queued = [];
        _closed = [];

        foreach (var request in requests)
        {
            switch ((WorkRequestStatus)request.Status)
            {
                case WorkRequestStatus.Queued:
                    _queued.Add(request);
                    break;
                case WorkRequestStatus.Completed:
                case WorkRequestStatus.Failed:
                case WorkRequestStatus.Cancelled:
                    _closed.Add(request);
                    break;
                default:
                    _active.Add(request);
                    break;
            }
        }
    }

    private async Task EnqueueAsync()
    {
        _composerErrors = Array.Empty<string>();
        _queuedTitle = null;

        var errors = new List<string>(2);
        if (string.IsNullOrWhiteSpace(_title))
        {
            errors.Add("Title is required.");
        }

        if (string.IsNullOrWhiteSpace(_prompt))
        {
            errors.Add("Prompt is required.");
        }

        if (errors.Count > 0)
        {
            _composerErrors = errors;
            return;
        }

        _submitting = true;
        try
        {
            var command = new QueueWorkRequestCommand(
                Parse(_kind, WorkRequestKind.Development),
                Parse(_priority, RequestPriority.Normal),
                Parse(_risk, RiskLevel.Standard),
                _title!.Trim(),
                _prompt!.Trim());

            var request = await Queue.EnqueueAsync(new ProjectId(ProjectId), command, CancellationToken.None);

            _queuedTitle = request.Title;
            _title = string.Empty;
            _prompt = string.Empty;
            _kind = nameof(WorkRequestKind.Development);
            _priority = nameof(RequestPriority.Normal);
            _risk = nameof(RiskLevel.Standard);

            ToastService.ShowSuccess($"Queued {request.Title}");
            var refreshed = await Queue.ListAsync(new ProjectId(ProjectId), CancellationToken.None);
            Partition(refreshed);
            await LoadSessionsAsync(refreshed);
            _snapshot = Clock.UtcNow;
        }
        catch (ProjectNotFoundException)
        {
            _composerErrors = new[] { "This project is no longer registered." };
        }
        catch (Exception ex)
        {
            _composerErrors = new[] { ex.Message };
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task LoadVerificationPolicyAsync(ProjectDto project)
    {
        _verificationError = null;
        _verificationWarning = null;
        _verificationCatalog = null;
        _verificationChoices = [new VerificationProfileChoice(string.Empty, "None")];
        _selectedVerificationProfileId = project.TrustedVerificationProfileId ?? string.Empty;
        if (project.Binding is null || _node is null || _node.Status != NodeStatus.Online)
        {
            return;
        }

        try
        {
            var catalog = await VerificationPolicy.GetCatalogAsync(
                new ProjectId(project.Id),
                CancellationToken.None);
            _verificationCatalog = catalog;
            var choices = new List<VerificationProfileChoice>
            {
                new(string.Empty, "None"),
            };
            foreach (var profile in catalog.Profiles)
            {
                choices.Add(new VerificationProfileChoice(profile.Id, profile.DisplayLabel));
            }

            _verificationChoices = choices;
            if (string.IsNullOrWhiteSpace(project.TrustedVerificationProfileId)
                && catalog.Profiles.Count > 0)
            {
                _verificationWarning = "Node advertises trusted profiles but none is selected";
            }
        }
        catch (Exception ex)
        {
            _verificationError = ex.Message;
        }
    }

    private async Task SaveVerificationPolicyAsync()
    {
        if (_project is null || _verificationBusy)
        {
            return;
        }

        _verificationBusy = true;
        _verificationError = null;
        try
        {
            string? profileId = string.IsNullOrWhiteSpace(_selectedVerificationProfileId)
                ? null
                : _selectedVerificationProfileId.Trim();
            string? revision = null;
            if (profileId is not null)
            {
                revision = _verificationCatalog?.Profiles
                    .FirstOrDefault(profile =>
                        string.Equals(profile.Id, profileId, StringComparison.Ordinal))
                    ?.Revision;
            }

            _project = await VerificationPolicy.SelectAsync(
                new ProjectId(ProjectId),
                profileId,
                revision,
                CancellationToken.None);
            _selectedVerificationProfileId = _project.TrustedVerificationProfileId ?? string.Empty;
            await LoadVerificationPolicyAsync(_project);
            ToastService.ShowSuccess(
                profileId is null
                    ? "Project checks cleared. Baseline repository checks will run."
                    : "Project checks saved.");
        }
        catch (Exception ex)
        {
            _verificationError = ex.Message;
        }
        finally
        {
            _verificationBusy = false;
        }
    }

    private string VerificationReadinessLabel()
    {
        if (_project?.Binding is null)
        {
            return "No designated node";
        }

        if (_node is null || _node.Status != NodeStatus.Online)
        {
            return "Node offline";
        }

        var selectedId = _project.TrustedVerificationProfileId;
        var selectedRevision = _project.TrustedVerificationProfileRevision;
        if (string.IsNullOrWhiteSpace(selectedId))
        {
            return _verificationCatalog is { BaselineAvailable: true } or null
                ? "Ready"
                : "Baseline unavailable";
        }

        if (_verificationCatalog is null)
        {
            return _verificationError is null ? "Ready" : "Catalog unavailable";
        }

        var advertised = _verificationCatalog.Profiles.FirstOrDefault(profile =>
            string.Equals(profile.Id, selectedId, StringComparison.Ordinal));
        if (advertised is null)
        {
            return "Selected profile unavailable";
        }

        if (!string.Equals(advertised.Revision, selectedRevision, StringComparison.Ordinal))
        {
            return "Policy revision stale";
        }

        return "Ready";
    }

    private static TEnum Parse<TEnum>(string? name, TEnum fallback)
        where TEnum : struct, Enum =>
        Enum.TryParse<TEnum>(name, out var parsed) ? parsed : fallback;
}
