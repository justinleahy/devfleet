@namespace PiCommandCenter.Web.Components
@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pi Command Center</title>
    <base href="/" />
    <link rel="stylesheet" href="_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css" />
    <link rel="stylesheet" href="PiCommandCenter.ControlPlane.styles.css" />
    <script src="_content/Microsoft.FluentUI.AspNetCore.Components/js/loading-theme.js" type="text/javascript"></script>
    <script src="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js" type="module" async></script>
    <HeadOutlet @rendermode="RouteRenderMode" />
</head>

<body>
    <loading-theme storage-name="theme"></loading-theme>
    <Routes @rendermode="RouteRenderMode" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // Sign-in and access-denied are marked [ExcludeFromInteractiveRouting] so they
    // render statically: the login form must be a plain HTML POST that sets the
    // authentication cookie before a circuit exists, and an unauthorized caller
    // must never open one. Every other page keeps global server interactivity.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? RouteRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
