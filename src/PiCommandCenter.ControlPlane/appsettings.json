{
  "ConnectionStrings": {
    "ControlPlane": "Data Source=controlplane.db;Cache=Shared"
  },
  "ControlPlane": {
    "BaseUrl": "http://127.0.0.1:5000"
  },
  "Admin": {
    "Username": "admin",
    "PasswordFile": "~/.config/pi-command-center/admin.password.hash"
  },
  "NodeAuthentication": {
    "CredentialFile": "~/.config/pi-command-center/node.token",
    "Header": "Authorization",
    "Scheme": "Bearer"
  },
  "Node": {
    "HeartbeatSeconds": 10
  },
  "Projects": {
    "ApprovedRoots": ["~/Developer"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
