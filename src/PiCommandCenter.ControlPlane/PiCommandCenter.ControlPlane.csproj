<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <RootNamespace>PiCommandCenter.ControlPlane</RootNamespace>
    <Description>Interactive Server Blazor host composing Application and Infrastructure.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PiCommandCenter.Application\PiCommandCenter.Application.csproj" />
    <ProjectReference Include="..\PiCommandCenter.Infrastructure\PiCommandCenter.Infrastructure.csproj" />
    <ProjectReference Include="..\PiCommandCenter.Web\PiCommandCenter.Web.csproj" />
  </ItemGroup>

</Project>
